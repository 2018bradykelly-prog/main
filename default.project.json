{
  "name": "ESCAPE THE CHAD",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "MatchState": {
        "$className": "Folder"
      },
      "Remotes": {
        "$className": "Folder",
        "Action": {
          "$className": "RemoteEvent"
        },
        "Notify": {
          "$className": "RemoteEvent"
        }
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "LoadCharacterAppearance": false
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
