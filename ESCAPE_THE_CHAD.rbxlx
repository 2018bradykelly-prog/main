      <Item class="Script" referent="14">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Server authority. Clients can only request ProximityPrompt interactions and
-- send rate-limited Action remotes. Roles, health states, BP, captures,
-- abilities and persistence are validated and owned here.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local PhysicsService = game:GetService("PhysicsService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Rules = require(Shared.Rules)
local RoundState = require(Shared.RoundState)
local Abilities = require(Shared.Abilities)
local Maps = require(Shared.Maps)
local World = require(script.Parent.World)
local DataService = require(script.Parent.DataService)

local match = ReplicatedStorage:WaitForChild("MatchState")
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local actionRemote = remotes:WaitForChild("Action") :: RemoteEvent
local notifyRemote = remotes:WaitForChild("Notify") :: RemoteEvent

local random = Random.new()
local lobby = World.createLobby()
local arena: World.Arena? = nil
local round: RoundState.State? = nil
local phase = "Waiting"
Players.RespawnTime = 3

local CARRIED_GROUP = "CarriedSurvivor"
pcall(function()
	PhysicsService:RegisterCollisionGroup(CARRIED_GROUP)
	PhysicsService:CollisionGroupSetCollidable(CARRIED_GROUP, "Default", false)
	PhysicsService:CollisionGroupSetCollidable(CARRIED_GROUP, CARRIED_GROUP, false)
end)

local function now(): number
	return Workspace:GetServerTimeNow()
end

-- Per-round bookkeeping that is presentation/physics only (rules live in RoundState).
type KillerRuntime = {
	NextAttackAt: number,
	Weld: WeldConstraint?,
}
local killer: KillerRuntime = { NextAttackAt = 0, Weld = nil }
local cageOf: { [number]: string } = {}
local lockerOf: { [number]: string } = {}
local cooldowns: { [Player]: { [string]: number } } = {}
local lockerUsedAt: { [Player]: number } = {}
local votes: { [Player]: string } = {}
local smokes: { { Position: Vector3, Radius: number, Until: number } } = {}
local holds: { [Player]: { Prompt: ProximityPrompt, At: number, Round: any } } = {}
local actionBudget: { [Player]: { Window: number, Count: number } } = {}

-- Messaging -------------------------------------------------------------------

local function notify(player: Player, payload: { [string]: any })
	notifyRemote:FireClient(player, payload)
end

local function notifyAll(payload: { [string]: any })
	notifyRemote:FireAllClients(payload)
end

local function toast(text: string, tone: string?)
	notifyAll({ Kind = "Toast", Text = text, Tone = tone or "info" })
end

local function setMessage(text: string)
	match:SetAttribute("Message", text)
end

local function setPhase(nextPhase: string, message: string)
	phase = nextPhase
	match:SetAttribute("Phase", phase)
	setMessage(message)
	table.clear(holds)
end

-- Characters ------------------------------------------------------------------

local function humanoidOf(player: Player): Humanoid?
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local humanoid = humanoidOf(player)
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and humanoid.Health > 0 and root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function teleport(player: Player, destination: CFrame)
	local root = rootOf(player)
	if root and player.Character then
		player.Character:PivotTo(destination)
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end
end

local function setAnchored(player: Player, anchored: boolean)
	local root = rootOf(player)
	if root then
		root.Anchored = anchored
	end
end

local function survivorSpawn(): CFrame
	local spawns = if arena then arena.SurvivorSpawns else { lobby.Spawn }
	return spawns[random:NextInteger(1, #spawns)] * CFrame.new(random:NextNumber(-3, 3), 0, random:NextNumber(-3, 3))
end

local function killerPlayer(): Player?
	return if round then Players:GetPlayerByUserId(round.KillerId) else nil
end

local function findCage(id: string?): World.Cage?
	if not arena or not id then
		return nil
	end
	for _, cage in arena.Cages do
		if cage.Id == id then
			return cage
		end
	end
	return nil
end

local function findLocker(id: string?): World.Locker?
	if not arena or not id then
		return nil
	end
	for _, locker in arena.Lockers do
		if locker.Id == id then
			return locker
		end
	end
	return nil
end

-- Carrying --------------------------------------------------------------------

local function setCarriedPhysics(player: Player, carried: boolean)
	local character = player.Character
	if not character then
		return
	end
	for _, descendant in character:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Massless = carried
			descendant.CollisionGroup = if carried then CARRIED_GROUP else "Default"
		end
	end
	local humanoid = humanoidOf(player)
	if humanoid then
		humanoid.PlatformStand = carried
	end
end

local function detachCarry(survivorId: number?)
	if killer.Weld then
		killer.Weld:Destroy()
		killer.Weld = nil
	end
	local survivor = survivorId and Players:GetPlayerByUserId(survivorId)
	if survivor then
		setCarriedPhysics(survivor, false)
	end
	local chad = killerPlayer()
	if chad then
		chad:SetAttribute("Carrying", 0)
	end
end

local function attachCarry(survivor: Player)
	local chad = killerPlayer()
	local killerRoot = chad and rootOf(chad)
	local survivorRoot = rootOf(survivor)
	if not chad or not killerRoot or not survivorRoot then
		return
	end
	detachCarry(nil)
	setAnchored(survivor, false)
	setCarriedPhysics(survivor, true)
	survivorRoot.CFrame = killerRoot.CFrame * CFrame.new(0, 2.6, 0.4) * CFrame.Angles(0, 0, math.rad(90))
	local weld = Instance.new("WeldConstraint")
	weld.Name = "CarryWeld"
	weld.Part0 = killerRoot
	weld.Part1 = survivorRoot
	weld.Parent = killerRoot
	killer.Weld = weld
	chad:SetAttribute("Carrying", survivor.UserId)
end

-- Releases the carried survivor next to the killer (wiggle, flash, timeout).
local function dropCarriedPlayer(id: number)
	detachCarry(id)
	local survivor = Players:GetPlayerByUserId(id)
	local chad = killerPlayer()
	local killerRoot = chad and rootOf(chad)
	if survivor and killerRoot then
		teleport(survivor, killerRoot.CFrame * CFrame.new(0, 0, 3))
	end
end

-- Attribute sync --------------------------------------------------------------

local function setPromptActive(prompt: ProximityPrompt?, active: boolean)
	if prompt and prompt:GetAttribute("Active") ~= active then
		prompt:SetAttribute("Active", active)
	end
end

local function characterPrompt(player: Player, name: string): ProximityPrompt?
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local found = root and root:FindFirstChild(name)
	return if found and found:IsA("ProximityPrompt") then found else nil
end

local function syncPlayer(player: Player)
	local survivor = round and round.Survivors[player.UserId]
	local isKiller = round ~= nil and round.KillerId == player.UserId
	local role = if isKiller then "Killer" elseif survivor then "Survivor" else "Lobby"
	local status = if survivor then survivor.Status
		elseif isKiller then "Hunting"
		elseif phase == "Active" then "Spectating"
		else "Lobby"
	local bp = if survivor then survivor.BP else 0
	local rank = if isKiller then "OG Chad" else Rules.rankForBP(bp)
	player:SetAttribute("Role", role)
	player:SetAttribute("Status", status)
	player:SetAttribute("BP", bp)
	player:SetAttribute("Rank", rank)
	player:SetAttribute("Hidden", survivor ~= nil and survivor.Hidden ~= nil)
	player:SetAttribute("HiddenLocker", if survivor and survivor.Hidden then survivor.Hidden else "")
	player:SetAttribute("CagedUntil", if survivor and survivor.CagedUntil then survivor.CagedUntil else 0)
	player:SetAttribute("RecoverAt", if survivor and survivor.RecoverAt then survivor.RecoverAt else 0)
	player:SetAttribute("CageCount", if survivor then survivor.CageCount else 0)
	player:SetAttribute("EscapeAttemptsLeft", if survivor then Config.CageEscapeAttempts - survivor.EscapeAttempts else 0)
	player:SetAttribute("WiggleProgress", if survivor then survivor.Wiggles / Config.WiggleGoal else 0)
	local stats = player:FindFirstChild("leaderstats")
	local rankValue = stats and stats:FindFirstChild("Rank")
	if rankValue and rankValue:IsA("StringValue") then
		rankValue.Value = if role == "Lobby" then "-" else rank
	end
	local active = phase == "Active" and survivor ~= nil
	setPromptActive(characterPrompt(player, "RevivePrompt"), active and status == "Downed")
	setPromptActive(characterPrompt(player, "PickupPrompt"), active and status == "Downed")
	setPromptActive(characterPrompt(player, "HealPrompt"), active and status == "Injured" and not (survivor and survivor.Hidden))
	local character = player.Character
	local humanoid = humanoidOf(player)
	if humanoid and character then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		local colors = character:FindFirstChildOfClass("BodyColors")
		if not colors then
			colors = Instance.new("BodyColors")
			colors.Parent = character
		end
		local bodyColors = colors :: BodyColors
		local tint = if isKiller then Color3.fromRGB(189, 85, 62)
			elseif status == "Injured" then Color3.fromRGB(150, 110, 110)
			else Color3.fromRGB(101, 139, 151)
		bodyColors.HeadColor3 = if isKiller then Color3.fromRGB(214, 160, 120) else tint
		bodyColors.TorsoColor3 = tint
		bodyColors.LeftArmColor3 = tint
		bodyColors.RightArmColor3 = tint
		bodyColors.LeftLegColor3 = if isKiller then Color3.fromRGB(40, 40, 48) else tint
		bodyColors.RightLegColor3 = if isKiller then Color3.fromRGB(40, 40, 48) else tint
		-- Rough server baseline; the client movement controller refines it.
		humanoid.WalkSpeed = if isKiller then Config.KillerWalkSpeed
			elseif status == "Downed" then Config.DownedSpeed
			elseif status == "Carried" or status == "Caged" then 0
			else Config.WalkSpeed
		humanoid.UseJumpPower = false
		humanoid.JumpHeight = if isKiller then Config.KillerJumpHeight
			elseif status == "Downed" or status == "Carried" or status == "Caged" then 0
			else Config.SurvivorJumpHeight
	end
end

local function syncMatch()
	local current = round
	match:SetAttribute("ObjectiveCount", if current then current.ObjectiveCount else 0)
	match:SetAttribute("ObjectiveGoal", if current then current.ObjectiveGoal else 0)
	match:SetAttribute("ExitPowered", if current then current.ExitPowered else false)
	match:SetAttribute("EndsAt", if current then current.EndsAt else 0)
	if current then
		local alive, escaped, eliminated = 0, current.EscapedCount, current.EliminatedCount
		for _, survivor in current.Survivors do
			if not RoundState.isFinished(survivor) then
				alive += 1
			end
		end
		match:SetAttribute("SurvivorsLeft", alive)
		match:SetAttribute("Escaped", escaped)
		match:SetAttribute("Eliminated", eliminated)
	end
	for _, player in Players:GetPlayers() do
		syncPlayer(player)
	end
end

-- Terminals and exits ---------------------------------------------------------

local function refreshTerminals()
	if not arena or not round then
		return
	end
	local t = now()
	for _, terminal in arena.Terminals do
		local ready = RoundState.terminalReady(round, terminal.Id, t)
		local color = if ready then World.Colors.Cyan else World.Colors.Red
		if terminal.Screen.Color ~= color then
			terminal.Screen.Color = color
			terminal.Light.Color = color
		end
		setPromptActive(terminal.Prompt, phase == "Active" and ready)
	end
end

local function powerExits()
	if not arena then
		return
	end
	for _, exit in arena.Exits do
		exit.Light.Color = World.Colors.Green
		local glow = exit.Light:FindFirstChildOfClass("PointLight")
		if glow then
			glow.Color = World.Colors.Green
		end
		exit.Part.Color = Color3.fromRGB(47, 106, 69)
	end
end

local function activateArenaPrompts(active: boolean)
	if not arena then
		return
	end
	for _, exit in arena.Exits do
		setPromptActive(exit.Prompt, active)
	end
	for _, cage in arena.Cages do
		setPromptActive(cage.RescuePrompt, active)
		setPromptActive(cage.CagePrompt, active)
	end
	for _, locker in arena.Lockers do
		setPromptActive(locker.Prompt, active)
	end
	refreshTerminals()
end

-- Placement -------------------------------------------------------------------

local function unhidePlayer(player: Player, survivorId: number)
	local lockerId = lockerOf[survivorId]
	lockerOf[survivorId] = nil
	if round then
		RoundState.unhide(round, survivorId)
	end
	setAnchored(player, false)
	local locker = findLocker(lockerId)
	if locker then
		teleport(player, locker.Outside)
	end
end

local function placeCharacter(player: Player)
	syncPlayer(player)
	local current = round
	if phase ~= "Active" or not current or not arena then
		teleport(player, lobby.Spawn * CFrame.new(random:NextNumber(-6, 6), 0, random:NextNumber(-4, 4)))
		return
	end
	if player.UserId == current.KillerId then
		teleport(player, arena.KillerSpawn)
		return
	end
	local survivor = current.Survivors[player.UserId]
	if not survivor or RoundState.isFinished(survivor) then
		teleport(player, lobby.Spawn)
	elseif survivor.Status == "Caged" then
		local cage = findCage(cageOf[player.UserId]) or arena.Cages[1]
		teleport(player, cage.Spawn)
	else
		teleport(player, survivorSpawn())
	end
end

local function addCharacterPrompts(player: Player, character: Model)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not root or not root:IsA("BasePart") then
		return
	end
	local function make(name: string, action: string, hold: number, kind: string, role: string)
		local prompt = World.prompt(root, name, action, player.DisplayName, hold, kind, role)
		prompt.RequiresLineOfSight = false
		prompt.MaxActivationDistance = 8
		prompt:SetAttribute("OwnerId", player.UserId)
	end
	make("RevivePrompt", "Revive", Config.ReviveHoldSeconds, "Revive", "Survivor")
	make("HealPrompt", "Heal", Config.HealHoldSeconds, "Heal", "Survivor")
	make("PickupPrompt", "Pick up", Config.PickupHoldSeconds, "Pickup", "Killer")
end

local function onPlayer(player: Player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local level = Instance.new("IntValue")
	level.Name = "Level"
	level.Value = 1
	level.Parent = stats
	local wins = Instance.new("IntValue")
	wins.Name = "Wins"
	wins.Parent = stats
	local rank = Instance.new("StringValue")
	rank.Name = "Rank"
	rank.Value = "-"
	rank.Parent = stats
	stats.Parent = player
	cooldowns[player] = {}
	player:SetAttribute("Ability", Abilities.DefaultSurvivor)
	task.spawn(DataService.load, player)
	syncPlayer(player)
	player.CharacterAdded:Connect(function(character)
		local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
		if not humanoid or player.Character ~= character then
			return
		end
		humanoid.BreakJointsOnDeath = false
		humanoid.Died:Connect(function()
			-- Dying (falling, resetting) never frees a survivor or erases BP.
			local current = round
			if phase ~= "Active" or not current then
				return
			end
			local survivor = current.Survivors[player.UserId]
			if survivor and current.CarryingId == player.UserId then
				detachCarry(player.UserId)
				RoundState.cage(current, player.UserId, now())
				cageOf[player.UserId] = if arena then arena.Cages[1].Id else nil
			elseif player.UserId == current.KillerId and current.CarryingId then
				local carried = current.CarryingId
				RoundState.dropCarried(current, now())
				dropCarriedPlayer(carried)
			end
			if survivor and survivor.Hidden then
				lockerOf[player.UserId] = nil
				RoundState.unhide(current, player.UserId)
			end
			syncMatch()
		end)
		addCharacterPrompts(player, character)
		placeCharacter(player)
	end)
	if player.Character then
		placeCharacter(player)
	end
end

-- Interaction validation ------------------------------------------------------

local function nearPart(player: Player, target: BasePart, ignore: { Instance }?): boolean
	local root = rootOf(player)
	if not root then
		return false
	end
	if (root.Position - target.Position).Magnitude > Config.InteractionDistance then
		return false
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude: { Instance } = { player.Character :: Model }
	for _, item in ignore or {} do
		table.insert(exclude, item)
	end
	params.FilterDescendantsInstances = exclude
	local hit = Workspace:Raycast(root.Position, target.Position - root.Position, params)
	return not hit or hit.Instance == target or hit.Instance:IsDescendantOf(target.Parent :: Instance)
end

local function ownerOf(prompt: ProximityPrompt): Player?
	local id = prompt:GetAttribute("OwnerId")
	return if type(id) == "number" then Players:GetPlayerByUserId(id) else nil
end

local function isSurvivorFree(player: Player): boolean
	local survivor = round and round.Survivors[player.UserId]
	return survivor ~= nil and RoundState.isFree(survivor) and not survivor.Hidden
end

local function isKiller(player: Player): boolean
	return round ~= nil and round.KillerId == player.UserId
end

local function killerCanAct(player: Player, t: number): boolean
	if not isKiller(player) then
		return false
	end
	local stunned = player:GetAttribute("StunnedUntil")
	return not (type(stunned) == "number" and t < stunned)
end

-- Who is allowed to begin holding each kind of prompt.
local function mayHold(player: Player, prompt: ProximityPrompt): boolean
	if phase ~= "Active" or not round or round.Ended or prompt:GetAttribute("Active") ~= true then
		return false
	end
	local kind = prompt:GetAttribute("Kind")
	local t = now()
	if kind == "Locker" then
		local survivor = round.Survivors[player.UserId]
		if survivor and survivor.Hidden then
			return true -- Leaving a locker.
		end
		return isSurvivorFree(player) or (killerCanAct(player, t) and not round.CarryingId)
	elseif kind == "Pickup" then
		return killerCanAct(player, t) and not round.CarryingId
	elseif kind == "Cage" then
		return killerCanAct(player, t) and round.CarryingId ~= nil
	else
		return isSurvivorFree(player) and ownerOf(prompt) ~= player
	end
end

local function finishAction()
	syncMatch()
	refreshTerminals()
	if round then
		RoundState.updateResult(round, now())
	end
end

local handlers: { [string]: (Player, ProximityPrompt, number) -> () } = {}

handlers.Terminal = function(player, prompt, t)
	local current = round :: RoundState.State
	local body = prompt.Parent :: BasePart
	local terminalId = body:GetAttribute("TerminalId")
	if type(terminalId) ~= "string" then
		return
	end
	local wasPowered = current.ExitPowered
	if not RoundState.objective(current, player.UserId, t, terminalId) then
		return
	end
	notify(player, { Kind = "Toast", Text = string.format("+%d BP · %s", Config.BPPerObjective, Rules.rankForBP(current.Survivors[player.UserId].BP)), Tone = "good" })
	local chad = killerPlayer()
	if chad then
		notify(chad, { Kind = "Ping", Position = body.Position, Label = "Terminal calibrated", Duration = Config.TerminalPingSeconds })
	end
	if current.ExitPowered and not wasPowered then
		powerExits()
		setMessage("EXIT GATES POWERED! Reach Chad rank and escape before the collapse.")
		toast("The exit gates are powered. Endgame collapse has started!", "warn")
	else
		setMessage(string.format("Terminal calibrated (%d/%d).", current.ObjectiveCount, current.ObjectiveGoal))
	end
end

handlers.Exit = function(player, _prompt, t)
	local current = round :: RoundState.State
	local survivor = current.Survivors[player.UserId]
	if survivor and survivor.BP < Config.MaxBP then
		notify(player, { Kind = "Toast", Text = "You need Chad rank (100 BP) to escape.", Tone = "bad" })
		return
	end
	if not current.ExitPowered then
		notify(player, { Kind = "Toast", Text = "The exit has no power yet. Calibrate more terminals.", Tone = "bad" })
		return
	end
	if RoundState.escape(current, player.UserId, t) then
		teleport(player, lobby.Spawn)
		toast(player.DisplayName .. " escaped the Chad!", "good")
	end
end

handlers.Rescue = function(player, prompt, t)
	local current = round :: RoundState.State
	local cageId = (prompt.Parent :: BasePart):GetAttribute("CageId")
	local targetId: number? = nil
	local soonest = math.huge
	for id, survivor in current.Survivors do
		if survivor.Status == "Caged" and cageOf[id] == cageId and (survivor.CagedUntil or math.huge) < soonest then
			targetId, soonest = id, survivor.CagedUntil or math.huge
		end
	end
	if not targetId then
		notify(player, { Kind = "Toast", Text = "Nobody is locked in this cage.", Tone = "info" })
		return
	end
	if RoundState.rescue(current, player.UserId, targetId, t) then
		cageOf[targetId] = nil
		local rescued = Players:GetPlayerByUserId(targetId)
		local panel = prompt.Parent :: BasePart
		if rescued then
			teleport(rescued, CFrame.new(panel.Position + panel.CFrame.LookVector * 4 + Vector3.new(0, 2, 0)))
		end
		toast(string.format("%s freed %s from the Mog Cage!", player.DisplayName, if rescued then rescued.DisplayName else "a teammate"), "good")
	end
end

handlers.Cage = function(player, prompt, t)
	local current = round :: RoundState.State
	local carriedId = current.CarryingId
	if not carriedId then
		return
	end
	local cageId = (prompt.Parent :: BasePart):GetAttribute("CageId")
	local result = RoundState.cage(current, carriedId, t)
	if not result then
		return
	end
	detachCarry(carriedId)
	local victim = Players:GetPlayerByUserId(carriedId)
	local name = if victim then victim.DisplayName else "A survivor"
	if result == "Caged" then
		cageOf[carriedId] = if type(cageId) == "string" then cageId else nil
		local cage = findCage(cageOf[carriedId])
		if victim and cage then
			teleport(victim, cage.Spawn * CFrame.new(random:NextNumber(-3, 3), 0, random:NextNumber(-3, 3)))
		end
		toast(name .. " was locked in a Mog Cage! Free them before time runs out.", "bad")
	else
		cageOf[carriedId] = nil
		if victim then
			teleport(victim, lobby.Spawn)
		end
		toast(name .. " was eliminated (third cage).", "bad")
	end
end

handlers.Pickup = function(player, prompt, t)
	local current = round :: RoundState.State
	local target = ownerOf(prompt)
	if not target or not RoundState.pickup(current, target.UserId, t) then
		return
	end
	attachCarry(target)
	notify(target, { Kind = "Toast", Text = "You were picked up! Mash SPACE (or the button) to wiggle free.", Tone = "bad" })
end

handlers.Revive = function(player, prompt, t)
	local target = ownerOf(prompt)
	if target and RoundState.revive(round :: RoundState.State, player.UserId, target.UserId, t) then
		toast(player.DisplayName .. " revived " .. target.DisplayName .. ".", "good")
	end
end

handlers.Heal = function(player, prompt, t)
	local target = ownerOf(prompt)
	if target and RoundState.heal(round :: RoundState.State, player.UserId, target.UserId, t) then
		notify(target, { Kind = "Toast", Text = player.DisplayName .. " patched you up. You are healthy.", Tone = "good" })
		notify(player, { Kind = "Toast", Text = string.format("+%d BP for healing", Config.BPPerHeal), Tone = "good" })
	end
end

handlers.Locker = function(player, prompt, t)
	local current = round :: RoundState.State
	local door = prompt.Parent :: BasePart
	local lockerId = door:GetAttribute("LockerId")
	local locker = findLocker(if type(lockerId) == "string" then lockerId else nil)
	if not locker then
		return
	end
	local last = lockerUsedAt[player]
	if last and t - last < Config.LockerCooldownSeconds then
		return
	end
	lockerUsedAt[player] = t
	local survivor = current.Survivors[player.UserId]
	if survivor then
		if survivor.Hidden == locker.Id then
			unhidePlayer(player, player.UserId)
		elseif not survivor.Hidden and RoundState.hide(current, player.UserId, locker.Id, t) then
			lockerOf[player.UserId] = locker.Id
			teleport(player, locker.Inside)
			setAnchored(player, true)
		end
		return
	end
	if player.UserId == current.KillerId then
		local occupantId = RoundState.lockerOccupant(current, locker.Id)
		if occupantId and RoundState.grabFromLocker(current, occupantId, t) then
			lockerOf[occupantId] = nil
			local occupant = Players:GetPlayerByUserId(occupantId)
			if occupant then
				setAnchored(occupant, false)
				attachCarry(occupant)
				notify(occupant, { Kind = "Toast", Text = "Found you! Wiggle free (mash SPACE).", Tone = "bad" })
			end
			toast("OG Chad pulled a survivor out of a locker!", "bad")
		else
			notify(player, { Kind = "Toast", Text = "Empty locker.", Tone = "info" })
		end
	end
end

ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt, player)
	if mayHold(player, prompt) then
		holds[player] = { Prompt = prompt, At = os.clock(), Round = round }
	end
end)

ProximityPromptService.PromptButtonHoldEnded:Connect(function(prompt, player)
	local hold = holds[player]
	if not hold or hold.Prompt ~= prompt then
		return
	end
	-- An early release cancels. A completed release can arrive just before
	-- Triggered; give that event a short window, never the next hold.
	if os.clock() - hold.At < prompt.HoldDuration - 0.1 then
		holds[player] = nil
	else
		task.delay(0.25, function()
			if holds[player] == hold then
				holds[player] = nil
			end
		end)
	end
end)

ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
	local hold = holds[player]
	holds[player] = nil
	local kind = prompt:GetAttribute("Kind")
	local handler = if type(kind) == "string" then handlers[kind] else nil
	if not handler or not round or round.Ended or phase ~= "Active" then
		return
	end
	if not mayHold(player, prompt) then
		return
	end
	-- Very short holds may not fire HoldBegan on every platform; anything
	-- longer than half a second must have a matching, completed hold.
	if prompt.HoldDuration > 0.5 then
		if not hold or hold.Prompt ~= prompt or hold.Round ~= round then
			return
		end
		local elapsed = os.clock() - hold.At
		if elapsed < prompt.HoldDuration - 0.15 or elapsed > prompt.HoldDuration + 5 then
			return
		end
	end
	local target = prompt.Parent
	if not target or not target:IsA("BasePart") then
		return
	end
	local ignore: { Instance } = {}
	local owner = ownerOf(prompt)
	if owner and owner.Character then
		table.insert(ignore, owner.Character)
	end
	local survivor = round.Survivors[player.UserId]
	if not (survivor and survivor.Hidden) and not nearPart(player, target, ignore) then
		return
	end
	handler(player, prompt, now())
	finishAction()
end)

-- Abilities and combat --------------------------------------------------------

local function abilityReady(player: Player, id: string, t: number): boolean
	local list = cooldowns[player]
	return list ~= nil and (list[id] == nil or t >= list[id])
end

local function startCooldown(player: Player, ability: Abilities.Ability, t: number)
	local list = cooldowns[player]
	if list then
		list[ability.Id] = t + ability.Cooldown
	end
	player:SetAttribute("Ready_" .. ability.Id, t + ability.Cooldown)
end

local function insideSmoke(position: Vector3, t: number): boolean
	for _, smoke in smokes do
		if t < smoke.Until and (position - smoke.Position).Magnitude <= smoke.Radius then
			return true
		end
	end
	return false
end

-- Segment/sphere test: does the line from a to b pass through any active smoke?
local function smokeBlocks(a: Vector3, b: Vector3, t: number): boolean
	local direction = b - a
	local length = direction.Magnitude
	if length < 1e-3 then
		return false
	end
	local unit = direction / length
	for _, smoke in smokes do
		if t < smoke.Until then
			local projection = math.clamp((smoke.Position - a):Dot(unit), 0, length)
			if (a + unit * projection - smoke.Position).Magnitude <= smoke.Radius then
				return true
			end
		end
	end
	return false
end

local function clearLine(fromPlayer: Player, toPlayer: Player, a: Vector3, b: Vector3): boolean
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { fromPlayer.Character :: Model, toPlayer.Character :: Model }
	return Workspace:Raycast(a, b - a, params) == nil
end

local function stunKiller(seconds: number, reason: string)
	local chad = killerPlayer()
	local current = round
	if not chad or not current then
		return
	end
	chad:SetAttribute("StunnedUntil", now() + seconds)
	notify(chad, { Kind = "Blind", Duration = seconds, Reason = reason })
	if current.CarryingId then
		local carried = current.CarryingId
		RoundState.dropCarried(current, now())
		dropCarriedPlayer(carried)
		local freed = Players:GetPlayerByUserId(carried)
		toast((if freed then freed.DisplayName else "A survivor") .. " broke free from the OG Chad!", "good")
	end
end

local function killerAttack(player: Player, t: number)
	local current = round
	if not current or not killerCanAct(player, t) or current.CarryingId or t < killer.NextAttackAt then
		return
	end
	local root = rootOf(player)
	if not root then
		return
	end
	local look = root.CFrame.LookVector
	local forward = Vector3.new(look.X, 0, look.Z)
	forward = if forward.Magnitude > 1e-3 then forward.Unit else Vector3.new(0, 0, -1)
	local bestId: number? = nil
	local bestDistance = math.huge
	for id, survivor in current.Survivors do
		if RoundState.isFree(survivor) and not survivor.Hidden and t >= survivor.ImmuneUntil then
			local target = Players:GetPlayerByUserId(id)
			local targetRoot = target and rootOf(target)
			if target and targetRoot then
				local offset = targetRoot.Position - root.Position
				if math.abs(offset.Y) < 6 and Rules.inAttackCone(offset.X, offset.Z, forward.X, forward.Z)
					and not insideSmoke(targetRoot.Position, t)
					and not smokeBlocks(root.Position, targetRoot.Position, t)
					and clearLine(player, target, root.Position, targetRoot.Position)
				then
					local distance = offset.Magnitude
					if distance < bestDistance then
						bestId, bestDistance = id, distance
					end
				end
			end
		end
	end
	notifyAll({ Kind = "Swing", Id = player.UserId })
	if not bestId then
		killer.NextAttackAt = t + Config.AttackMissCooldown
		player:SetAttribute("SlowUntil", t + Config.AttackMissSlowSeconds)
		player:SetAttribute("AttackReadyAt", killer.NextAttackAt)
		return
	end
	local result = RoundState.hit(current, bestId, t)
	killer.NextAttackAt = t + (if result then Config.AttackHitCooldown else Config.AttackMissCooldown)
	player:SetAttribute("SlowUntil", t + (if result then Config.AttackHitSlowSeconds else Config.AttackMissSlowSeconds))
	player:SetAttribute("AttackReadyAt", killer.NextAttackAt)
	if not result then
		return
	end
	local victim = Players:GetPlayerByUserId(bestId)
	notifyAll({ Kind = "Hit", Id = bestId, Downed = result == "Downed" })
	if victim then
		if result == "Injured" then
			victim:SetAttribute("BoostUntil", t + Config.InjuredBoostSeconds)
			notify(victim, { Kind = "Toast", Text = "You're injured! Run! One more hit downs you.", Tone = "bad" })
		else
			toast(victim.DisplayName .. " is down! Revive them before they are caged.", "bad")
		end
	end
	finishAction()
end

local function useAbility(player: Player, abilityId: any, t: number)
	local current = round
	local ability = Abilities.get(abilityId)
	if not current or phase ~= "Active" or not ability or not abilityReady(player, ability.Id, t) then
		return
	end
	local root = rootOf(player)
	if not root then
		return
	end
	if ability.Role == "Killer" then
		if not killerCanAct(player, t) then
			return
		end
		if ability.Id == "Charge" then
			if current.CarryingId then
				return
			end
			player:SetAttribute("ChargeUntil", t + ability.Duration)
		elseif ability.Id == "Reveal" then
			local ids = {}
			for id, survivor in current.Survivors do
				if not RoundState.isFinished(survivor) and not survivor.Hidden then
					table.insert(ids, id)
				end
			end
			notify(player, { Kind = "Reveal", Ids = ids, Duration = ability.Duration })
			for id in current.Survivors do
				local survivorPlayer = Players:GetPlayerByUserId(id)
				if survivorPlayer then
					notify(survivorPlayer, { Kind = "Toast", Text = "MOG AURA! The OG Chad can see you (lockers hide you).", Tone = "warn" })
				end
			end
		else
			return
		end
		startCooldown(player, ability, t)
		return
	end

	-- Survivor abilities: must be their selected loadout and they must be free.
	if player:GetAttribute("Ability") ~= ability.Id or not isSurvivorFree(player) then
		return
	end
	if ability.Id == "Dash" then
		notify(player, { Kind = "Dash", Duration = ability.Duration })
	elseif ability.Id == "Smoke" then
		local radius = 11
		local position = root.Position
		table.insert(smokes, { Position = position, Radius = radius, Until = t + ability.Duration })
		local cloud = Instance.new("Part")
		cloud.Name = "SmokeCloud"
		cloud.Shape = Enum.PartType.Ball
		cloud.Size = Vector3.new(radius * 2, radius * 2, radius * 2)
		cloud.CFrame = CFrame.new(position)
		cloud.Anchored = true
		cloud.CanCollide = false
		cloud.CanQuery = false
		cloud.CanTouch = false
		cloud.CastShadow = false
		cloud.Material = Enum.Material.SmoothPlastic
		cloud.Color = Color3.fromRGB(170, 178, 196)
		cloud.Transparency = 0.25
		local emitter = Instance.new("ParticleEmitter")
		emitter.Rate = 40
		emitter.Lifetime = NumberRange.new(2, 3)
		emitter.Speed = NumberRange.new(2, 5)
		emitter.Size = NumberSequence.new(6, 10)
		emitter.Transparency = NumberSequence.new(0.3, 1)
		emitter.Color = ColorSequence.new(Color3.fromRGB(190, 196, 210))
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.Parent = cloud
		cloud.Parent = if arena then arena.Folder else Workspace
		Debris:AddItem(cloud, ability.Duration)
	elseif ability.Id == "Flash" then
		notifyAll({ Kind = "Flash", Position = root.Position })
		local chad = killerPlayer()
		local killerRoot = chad and rootOf(chad)
		if chad and killerRoot then
			local offset = root.Position - killerRoot.Position
			local facingDot = if offset.Magnitude > 1e-3 then killerRoot.CFrame.LookVector:Dot(offset.Unit) else 1
			if offset.Magnitude <= 16 and facingDot > 0.2 and clearLine(player, chad, root.Position, killerRoot.Position) then
				stunKiller(ability.Duration, "Jawline Flash")
				notify(player, { Kind = "Toast", Text = "Direct hit! OG Chad is blinded.", Tone = "good" })
			else
				notify(player, { Kind = "Toast", Text = "The flash missed. Aim at the OG Chad's face.", Tone = "info" })
			end
		end
	elseif ability.Id == "Shake" then
		local survivor = current.Survivors[player.UserId]
		if survivor.Status == "Injured" then
			player:SetAttribute("SlowUntil", t + ability.Duration)
			notify(player, { Kind = "Toast", Text = "Drinking... stay alive for 4 seconds.", Tone = "info" })
			local expected = current
			task.delay(ability.Duration, function()
				if round == expected and RoundState.selfHeal(expected, player.UserId, now()) then
					notify(player, { Kind = "Toast", Text = "Protein Shake: fully healed!", Tone = "good" })
					syncMatch()
				end
			end)
		else
			player:SetAttribute("BoostUntil", t + 3)
			notify(player, { Kind = "Stamina" })
		end
	else
		return
	end
	startCooldown(player, ability, t)
end

local function refreshVoteCounts()
	local counts: { [string]: number } = {}
	for _, choice in votes do
		counts[choice] = (counts[choice] or 0) + 1
	end
	for _, def in Maps.List do
		match:SetAttribute("Votes_" .. def.Id, counts[def.Id] or 0)
	end
end

local function allowAction(player: Player): boolean
	local clock = os.clock()
	local budget = actionBudget[player]
	if not budget or clock - budget.Window >= 1 then
		budget = { Window = clock, Count = 0 }
		actionBudget[player] = budget
	end
	budget.Count += 1
	return budget.Count <= 25
end

actionRemote.OnServerEvent:Connect(function(player: Player, action: any, argument: any)
	if type(action) ~= "string" or not allowAction(player) then
		return
	end
	local t = now()
	if action == "Attack" then
		if phase == "Active" then
			killerAttack(player, t)
		end
	elseif action == "Ability" then
		useAbility(player, argument, t)
		syncMatch()
	elseif action == "Wiggle" then
		local current = round
		if phase == "Active" and current then
			local result = RoundState.wiggle(current, player.UserId, t)
			if result == "Freed" then
				dropCarriedPlayer(player.UserId)
				local chad = killerPlayer()
				if chad then
					chad:SetAttribute("StunnedUntil", t + 1.5)
					notify(chad, { Kind = "Blind", Duration = 0.6, Reason = "Wiggle" })
				end
				toast(player.DisplayName .. " wiggled free!", "good")
				syncMatch()
			elseif result then
				player:SetAttribute("WiggleProgress", current.Survivors[player.UserId].Wiggles / Config.WiggleGoal)
			end
		end
	elseif action == "Struggle" then
		local current = round
		if phase == "Active" and current then
			local result = RoundState.attemptCageEscape(current, player.UserId, t, random:NextNumber())
			if result == true then
				local cage = findCage(cageOf[player.UserId])
				cageOf[player.UserId] = nil
				if cage then
					teleport(player, CFrame.new(cage.Panel.Position + cage.Panel.CFrame.LookVector * 4 + Vector3.new(0, 2, 0)))
				end
				toast(player.DisplayName .. " broke out of the cage by themselves!", "good")
			elseif result == false then
				notify(player, { Kind = "Toast", Text = "The bars hold...", Tone = "bad" })
			end
			syncMatch()
		end
	elseif action == "Vote" then
		if (phase == "Waiting" or phase == "Intermission") and type(argument) == "string" and Maps.get(argument) then
			votes[player] = argument
			refreshVoteCounts()
		end
	elseif action == "Loadout" then
		local inRound = round ~= nil and (round.Survivors[player.UserId] ~= nil or round.KillerId == player.UserId)
		if not inRound and type(argument) == "string" and DataService.setAbility(player, argument) then
			notify(player, { Kind = "Toast", Text = "Loadout: " .. (Abilities.get(argument) :: Abilities.Ability).Name, Tone = "good" })
		end
	end
end)

-- Players leaving -------------------------------------------------------------

Players.PlayerAdded:Connect(onPlayer)
Players.PlayerRemoving:Connect(function(player)
	holds[player] = nil
	votes[player] = nil
	refreshVoteCounts()
	cooldowns[player] = nil
	lockerUsedAt[player] = nil
	actionBudget[player] = nil
	local current = round
	if current then
		if current.CarryingId == player.UserId or (player.UserId == current.KillerId and current.CarryingId) then
			detachCarry(current.CarryingId)
		end
		RoundState.removePlayer(current, player.UserId)
		RoundState.updateResult(current, now())
		cageOf[player.UserId] = nil
		lockerOf[player.UserId] = nil
		syncMatch()
	end
	DataService.release(player)
end)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayer, player)
end
DataService.start()

-- Leaderboard -----------------------------------------------------------------

local function refreshLeaderboard()
	local rows, global = DataService.topWins(#lobby.LeaderboardRows)
	lobby.LeaderboardTitle.Text = if global then "TOP MOGGERS (GLOBAL WINS)" else "TOP MOGGERS (THIS SERVER)"
	for index, label in lobby.LeaderboardRows do
		local row = rows[index]
		label.Text = if row then string.format("  %d.  %s  —  %d wins", index, row.Name, row.Wins) else ""
	end
end

task.spawn(function()
	while true do
		task.wait(5)
		refreshLeaderboard()
		task.wait(Config.LeaderboardRefreshSeconds - 5)
	end
end)

-- Round loop ------------------------------------------------------------------

local function tickRound(t: number)
	local current = round
	if not current then
		return
	end
	for _, event in RoundState.tick(current, t) do
		local player = Players:GetPlayerByUserId(event.Id)
		local name = if player then player.DisplayName else "A survivor"
		if event.Kind == "Eliminated" then
			cageOf[event.Id] = nil
			if player then
				teleport(player, lobby.Spawn)
			end
			toast(name .. " ran out of time in the cage and was eliminated.", "bad")
		elseif event.Kind == "CarryTimeout" then
			dropCarriedPlayer(event.Id)
			toast(name .. " slipped free from the OG Chad's grip.", "good")
		elseif event.Kind == "Recovered" then
			if player then
				notify(player, { Kind = "Toast", Text = "You picked yourself up.", Tone = "good" })
			end
		end
	end
	-- Expired smoke clouds.
	for index = #smokes, 1, -1 do
		if t >= smokes[index].Until then
			table.remove(smokes, index)
		end
	end
	-- Keep hidden survivors pinned inside their locker.
	for id, lockerId in lockerOf do
		local player = Players:GetPlayerByUserId(id)
		local locker = findLocker(lockerId)
		local root = player and rootOf(player)
		if player and locker and root and (root.Position - locker.Inside.Position).Magnitude > 2 then
			teleport(player, locker.Inside)
			setAnchored(player, true)
		end
	end
	RoundState.updateResult(current, t)
	match:SetAttribute("TimeRemaining", math.max(0, math.ceil(current.EndsAt - t)))
	syncMatch()
	refreshTerminals()
end

local function resetRuntime()
	detachCarry(nil)
	table.clear(cageOf)
	table.clear(lockerOf)
	table.clear(smokes)
	table.clear(holds)
	killer.NextAttackAt = 0
	for player, list in cooldowns do
		table.clear(list)
		for _, list2 in { Abilities.Survivor, Abilities.Killer } do
			for _, ability in list2 do
				player:SetAttribute("Ready_" .. ability.Id, 0)
			end
		end
	end
	for _, player in Players:GetPlayers() do
		setAnchored(player, false)
		for _, name in { "SlowUntil", "BoostUntil", "StunnedUntil", "ChargeUntil", "AttackReadyAt" } do
			player:SetAttribute(name, 0)
		end
		player:SetAttribute("Carrying", 0)
	end
end

local function chooseMap(): any
	local options = Maps.ids()
	local chosen = Rules.pickVote(options, votes, function(count)
		return random:NextInteger(1, count)
	end)
	return Maps.get(chosen) or Maps.List[1]
end

local function publishVoteOptions()
	local entries = {}
	for _, def in Maps.List do
		table.insert(entries, def.Id .. "|" .. def.Name .. "|" .. def.Blurb)
	end
	match:SetAttribute("MapOptions", table.concat(entries, ";"))
	refreshVoteCounts()
end

local function finishRound(current: RoundState.State)
	local rows = {}
	for _, player in Players:GetPlayers() do
		local id = player.UserId
		local survivor = current.Survivors[id]
		local isChad = id == current.KillerId
		if survivor or isChad then
			local xp = RoundState.xpFor(current, id)
			local won = (isChad and current.Winner == "Killer") or (survivor ~= nil and current.Winner == "Survivors")
			local stats = current.KillerStats
			local before, after = DataService.record(player, {
				XP = xp,
				Won = won,
				Role = if isChad then "Killer" else "Survivor",
				Escaped = survivor ~= nil and survivor.Status == "Escaped",
				Calibrations = if survivor then survivor.Stats.Calibrations else 0,
				Rescues = if survivor then survivor.Stats.Rescues else 0,
				Revives = if survivor then survivor.Stats.Revives else 0,
				Downs = if isChad then stats.Downs else 0,
				Cages = if isChad then stats.Cages else 0,
			})
			table.insert(rows, {
				Name = player.DisplayName,
				Role = if isChad then "OG Chad" else "Survivor",
				Outcome = if isChad then string.format("%d downs · %d cages", stats.Downs, stats.Cages)
					elseif survivor then (survivor :: any).Status
					else "",
				Rank = if survivor then Rules.rankForBP(survivor.BP) else "OG Chad",
				XP = xp,
				Won = won,
				LevelUp = after > before,
				Level = after,
			})
		end
	end
	notifyAll({ Kind = "Results", Winner = current.Winner or "None", Result = current.Result or "Round over.", Rows = rows })
end

setPhase("Waiting", "Waiting for at least two players.")
match:SetAttribute("TimeRemaining", 0)
match:SetAttribute("MapName", "")
publishVoteOptions()
syncMatch()

while true do
	while #Players:GetPlayers() < Config.MinPlayers do
		task.wait(0.5)
	end
	publishVoteOptions()
	setPhase("Intermission", "Vote for a map and pick your ability!")
	local startsAt = now() + Config.IntermissionSeconds
	while now() < startsAt and #Players:GetPlayers() >= Config.MinPlayers do
		match:SetAttribute("TimeRemaining", math.max(0, math.ceil(startsAt - now())))
		task.wait(0.2)
	end
	local participants = Players:GetPlayers()
	if #participants < Config.MinPlayers then
		setPhase("Waiting", "Waiting for at least two players.")
		match:SetAttribute("TimeRemaining", 0)
		continue
	end

	local def = chooseMap()
	table.clear(votes)
	refreshVoteCounts()
	arena = World.build(def)
	match:SetAttribute("MapName", def.Name)
	match:SetAttribute("MapId", def.Id)
	resetRuntime()
	local ids = {}
	for _, player in participants do
		table.insert(ids, player.UserId)
	end
	local created = assert(RoundState.new(ids, random:NextInteger(1, #ids), now()))
	round = created
	setPhase("Active", "Calibrate BP terminals. Avoid the OG Chad.")
	activateArenaPrompts(true)
	syncMatch()
	local chad = killerPlayer()
	for _, player in participants do
		placeCharacter(player)
		notify(player, {
			Kind = "RoleReveal",
			Role = if player.UserId == created.KillerId then "Killer" else "Survivor",
			MapName = def.Name,
			KillerName = if chad then chad.DisplayName else "?",
		})
	end
	while not created.Ended do
		tickRound(now())
		task.wait(0.1)
	end

	setPhase("Results", created.Result or "Round complete.")
	activateArenaPrompts(false)
	detachCarry(created.CarryingId)
	finishRound(created)
	for _, player in Players:GetPlayers() do
		setAnchored(player, false)
		teleport(player, lobby.Spawn * CFrame.new(random:NextNumber(-6, 6), 0, random:NextNumber(-4, 4)))
	end
	local resultsEnd = now() + Config.ResultsSeconds
	while now() < resultsEnd do
		match:SetAttribute("TimeRemaining", math.max(0, math.ceil(resultsEnd - now())))
		task.wait(0.2)
	end
	round = nil
	World.clear()
	arena = nil
	resetRuntime()
	match:SetAttribute("MapName", "")
	setPhase("Waiting", "Waiting for at least two players.")
	match:SetAttribute("TimeRemaining", 0)
	syncMatch()
	refreshLeaderboard()
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[--!strict
-- Builds arenas from data definitions (see Maps.luau) and the permanent lobby.
-- All geometry is generated and anchored; no external assets are used.
--
-- ProximityPrompts carry attributes the client uses to show only relevant prompts:
--   Kind    Terminal | Exit | Rescue | Cage | Locker | Revive | Heal | Pickup
--   ForRole Survivor | Killer | Any
--   Active  set by the server; the client hides inactive prompts
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local World = {}

World.LobbyOrigin = Vector3.new(0, 0, 400)
World.WallHeight = 13
World.SillHeight = 3
World.WindowTop = 10

local FACES: { [string]: Vector3 } = {
	N = Vector3.new(0, 0, -1),
	S = Vector3.new(0, 0, 1),
	E = Vector3.new(1, 0, 0),
	W = Vector3.new(-1, 0, 0),
}

local CYAN = Color3.fromRGB(93, 226, 225)
local GREEN = Color3.fromRGB(127, 239, 151)
local RED = Color3.fromRGB(241, 77, 94)
local GOLD = Color3.fromRGB(247, 213, 111)

World.Colors = table.freeze({ Cyan = CYAN, Green = GREEN, Red = RED, Gold = GOLD })

local function part(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?): Part
	local object = Instance.new("Part")
	object.Name = name
	object.Anchored = true
	object.Size = size
	object.CFrame = cframe
	object.Color = color
	object.Material = material or Enum.Material.Concrete
	object.TopSurface = Enum.SurfaceType.Smooth
	object.BottomSurface = Enum.SurfaceType.Smooth
	object.Parent = parent
	return object
end

local function at(x: number, y: number, z: number): CFrame
	return CFrame.new(x, y, z)
end

-- Orientation whose LookVector (front, local -Z) points along the face direction.
local function facing(position: Vector3, face: string?): CFrame
	local direction = FACES[face or "S"] or FACES.S
	return CFrame.lookAt(position, position + direction)
end

local function label(parent: BasePart, text: string, color: Color3, height: number?, maxDistance: number?): TextLabel
	local gui = Instance.new("BillboardGui")
	gui.Name = "WorldLabel"
	gui.Adornee = parent
	gui.Size = UDim2.fromOffset(220, 54)
	gui.StudsOffset = Vector3.new(0, height or 5, 0)
	gui.MaxDistance = maxDistance or 60
	gui.AlwaysOnTop = false
	gui.LightInfluence = 0
	gui.Parent = parent
	local textLabel = Instance.new("TextLabel")
	textLabel.BackgroundTransparency = 0.3
	textLabel.BackgroundColor3 = Color3.fromRGB(12, 15, 20)
	textLabel.Size = UDim2.fromScale(1, 1)
	textLabel.Font = Enum.Font.GothamBold
	textLabel.TextSize = 16
	textLabel.TextWrapped = true
	textLabel.TextColor3 = color
	textLabel.Text = text
	textLabel.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = textLabel
	return textLabel
end

local function prompt(parent: BasePart, name: string, action: string, object: string, hold: number, kind: string, forRole: string): ProximityPrompt
	local result = Instance.new("ProximityPrompt")
	result.Name = name
	result.ActionText = action
	result.ObjectText = object
	result.HoldDuration = hold
	result.MaxActivationDistance = 9
	result.RequiresLineOfSight = true
	result.KeyboardKeyCode = Enum.KeyCode.E
	result.GamepadKeyCode = Enum.KeyCode.ButtonX
	result.Style = Enum.ProximityPromptStyle.Default
	result.Enabled = true -- Visibility is filtered per player by the client.
	result:SetAttribute("Kind", kind)
	result:SetAttribute("ForRole", forRole)
	result:SetAttribute("Active", false)
	result.Parent = parent
	return result
end
World.prompt = prompt

local function lamp(parent: Instance, position: Vector3, color: Color3, brightness: number, range: number?): Part
	local fixture = part(parent, "Lamp", Vector3.new(2, 0.6, 2), CFrame.new(position), color, Enum.Material.Neon)
	fixture.CanCollide = false
	fixture.CanQuery = false
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range or 40
	light.Brightness = brightness
	light.Shadows = true
	light.Parent = fixture
	return fixture
end

export type Terminal = { Id: string, Part: BasePart, Screen: BasePart, Prompt: ProximityPrompt, Light: PointLight }
export type Exit = { Part: BasePart, Prompt: ProximityPrompt, Light: Part, Outside: CFrame }
export type Cage = { Id: string, Panel: BasePart, RescuePrompt: ProximityPrompt, CagePrompt: ProximityPrompt, Spawn: CFrame }
export type Locker = { Id: string, Door: BasePart, Prompt: ProximityPrompt, Inside: CFrame, Outside: CFrame }
export type Arena = {
	Id: string,
	Name: string,
	Folder: Folder,
	Terminals: { Terminal },
	Exits: { Exit },
	Cages: { Cage },
	Lockers: { Locker },
	SurvivorSpawns: { CFrame },
	KillerSpawn: CFrame,
}

local function buildTerminal(map: Instance, index: number, point: any): Terminal
	local base = facing(Vector3.new(point.X, 2.5, point.Z), point.Face)
	local model = Instance.new("Model")
	model.Name = "BPCalibrator" .. index
	model.Parent = map
	local body = part(model, "Calibrator", Vector3.new(8, 5, 5), base, Color3.fromRGB(39, 87, 96), Enum.Material.Metal)
	body:SetAttribute("TerminalId", "T" .. index)
	local screen = part(model, "Screen", Vector3.new(6, 2.5, 0.2), base * CFrame.new(0, 0.5, -2.6), CYAN, Enum.Material.Neon)
	screen.CanCollide = false
	screen.CanQuery = false -- Decorative glass must not block interaction rays.
	local light = Instance.new("PointLight")
	light.Color = CYAN
	light.Range = 18
	light.Brightness = 1.4
	light.Parent = screen
	label(body, "BP CALIBRATOR", CYAN, 5, 70)
	local terminalPrompt = prompt(body, "TerminalPrompt", "Calibrate BP", "BP Calibrator", 2.5, "Terminal", "Survivor")
	return { Id = "T" .. index, Part = body, Screen = screen, Prompt = terminalPrompt, Light = light }
end

local function buildLocker(map: Instance, index: number, point: any, color: Color3): Locker
	local base = facing(Vector3.new(point.X, 0, point.Z), point.Face)
	local model = Instance.new("Model")
	model.Name = "Locker" .. index
	model.Parent = map
	local metal = Enum.Material.DiamondPlate
	part(model, "Back", Vector3.new(4.4, 8, 0.4), base * CFrame.new(0, 4, 1.5), color, metal)
	part(model, "Left", Vector3.new(0.4, 8, 3.4), base * CFrame.new(-2, 4, 0), color, metal)
	part(model, "Right", Vector3.new(0.4, 8, 3.4), base * CFrame.new(2, 4, 0), color, metal)
	part(model, "Top", Vector3.new(4.4, 0.4, 3.4), base * CFrame.new(0, 8.2, 0), color, metal)
	local door = part(model, "Door", Vector3.new(3.6, 7.6, 0.3), base * CFrame.new(0, 3.8, -1.55), color:Lerp(Color3.new(1, 1, 1), 0.12), metal)
	door:SetAttribute("LockerId", "L" .. index)
	local lockerPrompt = prompt(door, "LockerPrompt", "Hide", "Locker", 0.5, "Locker", "Any")
	lockerPrompt.MaxActivationDistance = 7
	return {
		Id = "L" .. index,
		Door = door,
		Prompt = lockerPrompt,
		Inside = base * CFrame.new(0, 3, 0.1),
		Outside = base * CFrame.new(0, 3, -4.5),
	}
end

local function buildCage(map: Instance, index: number, point: any, wallColor: Color3): Cage
	local center = Vector3.new(point.X, 0, point.Z)
	local model = Instance.new("Model")
	model.Name = "Cage" .. index
	model.Parent = map
	local half = 7
	local glass = Color3.fromRGB(65, 75, 90)
	for _, side in { { 0, -half, 14.5, 0.6 }, { 0, half, 14.5, 0.6 }, { -half, 0, 0.6, 14.5 }, { half, 0, 0.6, 14.5 } } do
		local barrier = part(model, "Barrier", Vector3.new(side[3], 16, side[4]), at(center.X + side[1], 8, center.Z + side[2]), glass, Enum.Material.Glass)
		barrier.Transparency = 0.75
	end
	for x = -half, half, 3.5 do
		for _, z in { -half, half } do
			part(model, "Bar", Vector3.new(0.6, 16, 0.6), at(center.X + x, 8, center.Z + z), Color3.fromRGB(100, 105, 116), Enum.Material.Metal)
			part(model, "Bar", Vector3.new(0.6, 16, 0.6), at(center.X + z, 8, center.Z + x), Color3.fromRGB(100, 105, 116), Enum.Material.Metal)
		end
	end
	part(model, "Roof", Vector3.new(15, 1, 15), at(center.X, 16.5, center.Z), wallColor, Enum.Material.Metal)
	local glow = part(model, "CageGlow", Vector3.new(13, 0.2, 13), at(center.X, 0.1, center.Z), RED, Enum.Material.Neon)
	glow.CanCollide = false
	glow.CanQuery = false
	glow.Transparency = 0.6
	local direction = FACES[point.Face or "S"] or FACES.S
	local panelPosition = center + direction * (half + 2) + Vector3.new(0, 2, 0)
	local panel = part(model, "CagePanel", Vector3.new(3, 4, 1), CFrame.lookAt(panelPosition, panelPosition + direction), RED, Enum.Material.Metal)
	panel:SetAttribute("CageId", "C" .. index)
	label(panel, "MOG CAGE", RED, 5, 70)
	lamp(model, center + Vector3.new(0, 15.5, 0), RED, 1.2, 26)
	local rescuePrompt = prompt(panel, "RescuePrompt", "Free teammate", "Mog Cage", 2, "Rescue", "Survivor")
	local cagePrompt = prompt(panel, "CagePrompt", "Lock in cage", "Mog Cage", 0.8, "Cage", "Killer")
	return { Id = "C" .. index, Panel = panel, RescuePrompt = rescuePrompt, CagePrompt = cagePrompt, Spawn = CFrame.new(center + Vector3.new(0, 4, 0)) }
end

local function buildExit(map: Instance, index: number, point: any, half: number): Exit
	local direction = FACES[point.Face or "S"] or FACES.S
	-- Doors sit flush with the inner face of the outer wall.
	local position = Vector3.new(point.X, 6, point.Z) + direction * 1.4
	local base = CFrame.lookAt(position, position + direction)
	local model = Instance.new("Model")
	model.Name = "Exit" .. index
	model.Parent = map
	local door = part(model, "ExitDoor", Vector3.new(12, 12, 1), base, Color3.fromRGB(70, 40, 44), Enum.Material.Metal)
	local light = part(model, "ExitLight", Vector3.new(12, 0.8, 0.6), base * CFrame.new(0, 6.6, -0.6), RED, Enum.Material.Neon)
	light.CanCollide = false
	light.CanQuery = false
	local glow = Instance.new("PointLight")
	glow.Color = RED
	glow.Range = 30
	glow.Brightness = 1.5
	glow.Parent = light
	label(door, "EXIT GATE", GREEN, 8, 90)
	local exitPrompt = prompt(door, "ExitPrompt", "Escape", "Exit gate", 1, "Exit", "Survivor")
	return { Part = door, Prompt = exitPrompt, Light = light, Outside = CFrame.new(position + direction * 5) }
end

function World.applyTheme(theme: any)
	Lighting.ClockTime = 0
	Lighting.Brightness = 1
	Lighting.Ambient = theme.Ambient
	Lighting.OutdoorAmbient = theme.Ambient
	Lighting.FogColor = theme.Fog
	Lighting.FogStart = 40
	Lighting.FogEnd = theme.FogEnd
end

function World.build(def: any): Arena
	local previous = Workspace:FindFirstChild("ActiveMap")
	if previous then
		previous:Destroy()
	end
	local map = Instance.new("Folder")
	map.Name = "ActiveMap"
	map:SetAttribute("MapId", def.Id)
	map:SetAttribute("MapName", def.Name)
	local theme = def.Theme
	local half = def.Half
	local size = half * 2 + 4
	local wallHeight = World.WallHeight

	part(map, "Floor", Vector3.new(size, 2, size), at(0, -1, 0), theme.Floor, theme.FloorMaterial)
	part(map, "OuterWall", Vector3.new(size, 24, 4), at(0, 12, -half - 2), theme.Wall, theme.WallMaterial)
	part(map, "OuterWall", Vector3.new(size, 24, 4), at(0, 12, half + 2), theme.Wall, theme.WallMaterial)
	part(map, "OuterWall", Vector3.new(4, 24, size), at(-half - 2, 12, 0), theme.Wall, theme.WallMaterial)
	part(map, "OuterWall", Vector3.new(4, 24, size), at(half + 2, 12, 0), theme.Wall, theme.WallMaterial)

	for _, wall in def.Walls do
		local height = wall.H or wallHeight
		part(map, "Wall", Vector3.new(wall.W, height, wall.D), at(wall.X, height / 2, wall.Z), theme.Wall, theme.WallMaterial)
	end
	for _, window in def.Windows do
		local along = if window.Axis == "X" then Vector3.new(window.Length, 0, 2) else Vector3.new(2, 0, window.Length)
		local sill = part(map, "VaultSill", along + Vector3.new(0, World.SillHeight, 0), at(window.X, World.SillHeight / 2, window.Z), theme.Prop, Enum.Material.WoodPlanks)
		sill:SetAttribute("VaultAxis", window.Axis)
		local lintelHeight = wallHeight - World.WindowTop
		part(map, "Lintel", along + Vector3.new(0, lintelHeight, 0), at(window.X, World.WindowTop + lintelHeight / 2, window.Z), theme.Wall, theme.WallMaterial)
	end
	for _, prop in def.Props do
		local height = prop.H or 6
		part(map, "Prop", Vector3.new(prop.W, height, prop.D), at(prop.X, height / 2, prop.Z), theme.Prop, Enum.Material.WoodPlanks)
	end
	for _, point in def.Lamps do
		lamp(map, Vector3.new(point.X, 12, point.Z), theme.Lamp, 1.1, 44)
	end

	local terminals: { Terminal } = {}
	for index, point in def.Terminals do
		table.insert(terminals, buildTerminal(map, index, point))
	end
	local lockers: { Locker } = {}
	for index, point in def.Lockers do
		table.insert(lockers, buildLocker(map, index, point, Color3.fromRGB(72, 92, 104)))
	end
	local cages: { Cage } = {}
	for index, point in def.Cages do
		table.insert(cages, buildCage(map, index, point, theme.Wall))
	end
	local exits: { Exit } = {}
	for index, point in def.Exits do
		table.insert(exits, buildExit(map, index, point, half))
	end

	local spawns: { CFrame } = {}
	for _, point in def.SurvivorSpawns do
		table.insert(spawns, CFrame.new(point.X, 4, point.Z))
	end

	World.applyTheme(theme)
	map.Parent = Workspace
	return {
		Id = def.Id,
		Name = def.Name,
		Folder = map,
		Terminals = terminals,
		Exits = exits,
		Cages = cages,
		Lockers = lockers,
		SurvivorSpawns = spawns,
		KillerSpawn = CFrame.new(def.KillerSpawn.X, 4, def.KillerSpawn.Z),
	}
end

function World.applyLobbyTheme()
	World.applyTheme({ Ambient = Color3.fromRGB(70, 76, 96), Fog = Color3.fromRGB(20, 24, 35), FogEnd = 400 })
end

function World.clear()
	local previous = Workspace:FindFirstChild("ActiveMap")
	if previous then
		previous:Destroy()
	end
	World.applyLobbyTheme()
end

-- Lobby ------------------------------------------------------------------------

export type Lobby = {
	Folder: Folder,
	Spawn: CFrame,
	LeaderboardRows: { TextLabel },
	LeaderboardTitle: TextLabel,
}

local function board(parent: Instance, name: string, size: Vector3, cframe: CFrame, title: string, rows: number): (TextLabel, { TextLabel })
	local panel = part(parent, name, size, cframe, Color3.fromRGB(16, 22, 32), Enum.Material.SmoothPlastic)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Display"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.Parent = panel
	local heading = Instance.new("TextLabel")
	heading.Name = "Title"
	heading.BackgroundTransparency = 1
	heading.Size = UDim2.new(1, 0, 0.16, 0)
	heading.Font = Enum.Font.GothamBlack
	heading.TextScaled = true
	heading.TextColor3 = GOLD
	heading.Text = title
	heading.Parent = gui
	local list: { TextLabel } = {}
	for index = 1, rows do
		local row = Instance.new("TextLabel")
		row.Name = "Row" .. index
		row.BackgroundTransparency = if index % 2 == 0 then 1 else 0.85
		row.BackgroundColor3 = Color3.fromRGB(60, 80, 100)
		row.BorderSizePixel = 0
		row.Position = UDim2.new(0.04, 0, 0.18 + (index - 1) * (0.8 / rows), 0)
		row.Size = UDim2.new(0.92, 0, 0.8 / rows, 0)
		row.Font = Enum.Font.GothamMedium
		row.TextScaled = true
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.TextColor3 = Color3.fromRGB(231, 239, 243)
		row.Text = ""
		row.Parent = gui
		table.insert(list, row)
	end
	return heading, list
end

function World.createLobby(): Lobby
	local previous = Workspace:FindFirstChild("Lobby")
	if previous then
		previous:Destroy()
	end
	local lobby = Instance.new("Folder")
	lobby.Name = "Lobby"
	local o = World.LobbyOrigin
	local floorColor = Color3.fromRGB(42, 48, 60)
	local wallColor = Color3.fromRGB(28, 33, 44)
	part(lobby, "LobbyFloor", Vector3.new(96, 2, 76), at(o.X, -1, o.Z), floorColor, Enum.Material.SmoothPlastic)
	for _, geometry in { { 0, -38, 98, 2 }, { 0, 38, 98, 2 }, { -48, 0, 2, 76 }, { 48, 0, 2, 76 } } do
		part(lobby, "LobbyWall", Vector3.new(geometry[3], 20, geometry[4]), at(o.X + geometry[1], 10, o.Z + geometry[2]), wallColor, Enum.Material.SmoothPlastic)
	end
	part(lobby, "LobbyRoof", Vector3.new(98, 1, 78), at(o.X, 20.5, o.Z), wallColor, Enum.Material.SmoothPlastic)
	-- Neon trim along the floor edges.
	for _, geometry in { { 0, -36.6, 94, 0.4 }, { 0, 36.6, 94, 0.4 }, { -46.6, 0, 0.4, 72 }, { 46.6, 0, 0.4, 72 } } do
		local trim = part(lobby, "Trim", Vector3.new(geometry[3], 0.3, geometry[4]), at(o.X + geometry[1], 0.15, o.Z + geometry[2]), CYAN, Enum.Material.Neon)
		trim.CanCollide = false
		trim.CanQuery = false
	end
	for _, x in { -30, 0, 30 } do
		for _, z in { -18, 18 } do
			lamp(lobby, Vector3.new(o.X + x, 19.5, o.Z + z), if x == 0 then GOLD else CYAN, 1.3, 40)
		end
	end
	-- Training dummies and gym props to mess around with while waiting.
	for index, x in { -34, -26, 26, 34 } do
		local rack = part(lobby, "GymRack", Vector3.new(4, 5, 8), at(o.X + x, 2.5, o.Z + 24), Color3.fromRGB(70, 74, 86), Enum.Material.Metal)
		rack:SetAttribute("Decor", index)
	end
	local platform = part(lobby, "Stage", Vector3.new(20, 1, 12), at(o.X, 0.5, o.Z - 28), Color3.fromRGB(34, 40, 54), Enum.Material.SmoothPlastic)
	platform:SetAttribute("Decor", true)

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.AllowTeamChangeOnTouch = false
	spawn.Duration = 0
	spawn.Size = Vector3.new(12, 0.5, 12)
	spawn.CFrame = at(o.X, 0.25, o.Z + 8)
	spawn.Color = CYAN
	spawn.Material = Enum.Material.Neon
	spawn.Transparency = 0.45
	spawn.Parent = lobby

	-- Boards on the north wall face the spawn (+Z). A part's Front is -Z, so turn it around.
	local turn = CFrame.Angles(0, math.pi, 0)
	local title, rows = board(lobby, "Leaderboard", Vector3.new(26, 16, 1), at(o.X - 20, 9, o.Z - 36.4) * turn, "TOP MOGGERS", 10)
	local _, howRows = board(lobby, "HowToPlay", Vector3.new(26, 16, 1), at(o.X + 20, 9, o.Z - 36.4) * turn, "ESCAPE THE CHAD", 8)
	local lines = {
		"1. One player becomes the OG Chad.",
		"2. Survivors calibrate BP terminals.",
		"3. Reach Chad rank (100 BP) and power the exit.",
		"4. Chad hits: Injured, then Downed.",
		"5. Downed survivors get carried to cages.",
		"6. Free caged teammates. Third cage = out.",
		"7. Hide in lockers. Vault windows (Space).",
		"8. Shift sprint · C slide · Q ability · H help",
	}
	for index, line in lines do
		howRows[index].Text = "  " .. line
	end
	World.applyLobbyTheme()
	lobby.Parent = Workspace
	return {
		Folder = lobby,
		Spawn = CFrame.new(o.X, 4, o.Z + 8),
		LeaderboardRows = rows,
		LeaderboardTitle = title,
	}
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="16">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="17">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <bool name="LoadCharacterAppearance">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="18">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="19">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[--!strict
-- Local-only presentation: chase music, reveal outlines, terminal pings,
-- blindness, hit flashes, swing arcs and sprint scratch marks.
-- Nothing here affects gameplay; the server owns all rules.
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Rules = require(Shared:WaitForChild("Rules"))

local Effects = {}

local localPlayer = Players.LocalPlayer
local folder = Instance.new("Folder")
folder.Name = "LocalEffects"
folder.Parent = Workspace

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and humanoid.Health > 0 and root and root:IsA("BasePart") then
		return root
	end
	return nil
end
Effects.rootOf = rootOf

-- Chase music -------------------------------------------------------------------

local chaseSound = Instance.new("Sound")
chaseSound.Name = "ChadChase"
chaseSound.Looped = true
chaseSound.Volume = 0
local configuredAudio = tostring(Config.ChaseSoundId or "")
local hasAudio = configuredAudio:match("^rbxassetid://%d+$") ~= nil
if hasAudio then
	chaseSound.SoundId = configuredAudio
end
chaseSound.Parent = SoundService

local currentIntensity = 0
local targetIntensity = 0
local eligible = false

-- Returns the smoothed 0..1 chase intensity for UI use.
function Effects.updateChase(dt: number, matchPhase: string): number
	eligible = matchPhase == "Active"
		and localPlayer:GetAttribute("Role") == "Survivor"
		and (localPlayer:GetAttribute("Status") == "Healthy" or localPlayer:GetAttribute("Status") == "Injured")
	local survivorRoot = if eligible then rootOf(localPlayer) else nil
	if not survivorRoot then
		eligible = false
	end
	targetIntensity = 0
	if eligible and survivorRoot then
		local distance = math.huge
		for _, player in Players:GetPlayers() do
			if player:GetAttribute("Role") == "Killer" then
				local killerRoot = rootOf(player)
				if killerRoot then
					distance = math.min(distance, (killerRoot.Position - survivorRoot.Position).Magnitude)
				end
			end
		end
		if distance == math.huge then
			eligible = false
		else
			targetIntensity = Rules.chaseIntensity(distance)
		end
	end
	if not eligible then
		currentIntensity = 0
		if chaseSound.IsPlaying then
			chaseSound:Stop()
		end
	else
		currentIntensity += (targetIntensity - currentIntensity) * (1 - math.exp(-dt * 5))
		if targetIntensity > 0 and hasAudio and not chaseSound.IsPlaying then
			chaseSound:Play()
		elseif targetIntensity == 0 and currentIntensity < 0.005 and chaseSound.IsPlaying then
			chaseSound:Stop()
		end
	end
	chaseSound.Volume = math.clamp(currentIntensity * Config.ChaseMaxVolume, 0, 1)
	return currentIntensity
end

-- Reveal (Mog Aura) ---------------------------------------------------------------

function Effects.reveal(ids: { number }, duration: number)
	for _, id in ids do
		local player = Players:GetPlayerByUserId(id)
		local character = player and player.Character
		if character then
			local highlight = Instance.new("Highlight")
			highlight.Name = "MogAura"
			highlight.FillColor = Color3.fromRGB(241, 79, 79)
			highlight.FillTransparency = 0.55
			highlight.OutlineColor = Color3.fromRGB(255, 220, 220)
			highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			highlight.Adornee = character
			highlight.Parent = folder
			Debris:AddItem(highlight, duration)
		end
	end
end

-- Terminal ping (killer) ------------------------------------------------------------

function Effects.ping(position: Vector3, text: string, duration: number)
	local anchor = Instance.new("Part")
	anchor.Name = "Ping"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(1, 1, 1)
	anchor.CFrame = CFrame.new(position + Vector3.new(0, 6, 0))
	anchor.Parent = folder
	local gui = Instance.new("BillboardGui")
	gui.AlwaysOnTop = true
	gui.Size = UDim2.fromOffset(160, 40)
	gui.LightInfluence = 0
	gui.Parent = anchor
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 0.2
	label.BackgroundColor3 = Color3.fromRGB(60, 20, 20)
	label.TextColor3 = Color3.fromRGB(255, 196, 92)
	label.Font = Enum.Font.GothamBlack
	label.TextSize = 14
	label.Text = "⚠ " .. text
	label.Size = UDim2.fromScale(1, 1)
	label.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = label
	Debris:AddItem(anchor, duration)
end

-- Flash, blind, hits and swings --------------------------------------------------------

function Effects.flashBurst(position: Vector3)
	local burst = Instance.new("Part")
	burst.Name = "FlashBurst"
	burst.Shape = Enum.PartType.Ball
	burst.Anchored = true
	burst.CanCollide = false
	burst.CanQuery = false
	burst.CanTouch = false
	burst.Material = Enum.Material.Neon
	burst.Color = Color3.fromRGB(255, 244, 190)
	burst.Size = Vector3.new(2, 2, 2)
	burst.CFrame = CFrame.new(position)
	burst.Parent = folder
	local light = Instance.new("PointLight")
	light.Range = 40
	light.Brightness = 6
	light.Color = burst.Color
	light.Parent = burst
	TweenService:Create(burst, TweenInfo.new(0.35), { Size = Vector3.new(20, 20, 20), Transparency = 1 }):Play()
	TweenService:Create(light, TweenInfo.new(0.5), { Brightness = 0 }):Play()
	Debris:AddItem(burst, 0.6)
end

function Effects.blind(overlay: Frame, duration: number)
	overlay.BackgroundTransparency = 0
	TweenService:Create(overlay, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { BackgroundTransparency = 1 }):Play()
end

function Effects.hitFlash(overlay: Frame, strong: boolean)
	overlay.BackgroundTransparency = if strong then 0.35 else 0.55
	TweenService:Create(overlay, TweenInfo.new(0.6), { BackgroundTransparency = 1 }):Play()
end

function Effects.swing(player: Player)
	local root = rootOf(player)
	if not root then
		return
	end
	local arc = Instance.new("Part")
	arc.Name = "Swing"
	arc.Anchored = true
	arc.CanCollide = false
	arc.CanQuery = false
	arc.CanTouch = false
	arc.Material = Enum.Material.Neon
	arc.Color = Color3.fromRGB(255, 137, 87)
	arc.Transparency = 0.35
	arc.Size = Vector3.new(7, 0.3, 3)
	arc.CFrame = root.CFrame * CFrame.new(0, 0.5, -Config.AttackRange * 0.55)
	arc.Parent = folder
	TweenService:Create(arc, TweenInfo.new(0.25), { Transparency = 1, Size = Vector3.new(10, 0.3, 4) }):Play()
	Debris:AddItem(arc, 0.3)
end

function Effects.hitSpark(player: Player)
	local root = rootOf(player)
	if not root then
		return
	end
	local spark = Instance.new("Part")
	spark.Name = "HitSpark"
	spark.Shape = Enum.PartType.Ball
	spark.Anchored = true
	spark.CanCollide = false
	spark.CanQuery = false
	spark.CanTouch = false
	spark.Material = Enum.Material.Neon
	spark.Color = Color3.fromRGB(241, 79, 79)
	spark.Size = Vector3.new(1.5, 1.5, 1.5)
	spark.CFrame = root.CFrame
	spark.Parent = folder
	TweenService:Create(spark, TweenInfo.new(0.3), { Size = Vector3.new(7, 7, 7), Transparency = 1 }):Play()
	Debris:AddItem(spark, 0.35)
end

-- Scratch marks (killer only) ------------------------------------------------------------
-- Survivors running faster than ScratchMarkSpeed leave short-lived marks.

local scratchClock = 0
function Effects.updateScratches(dt: number)
	scratchClock += dt
	if scratchClock < 0.18 then
		return
	end
	scratchClock = 0
	for _, player in Players:GetPlayers() do
		if player ~= localPlayer and player:GetAttribute("Role") == "Survivor" then
			local root = rootOf(player)
			if root then
				local velocity = root.AssemblyLinearVelocity
				local horizontal = Vector3.new(velocity.X, 0, velocity.Z)
				if horizontal.Magnitude >= Config.ScratchMarkSpeed then
					local mark = Instance.new("Part")
					mark.Name = "ScratchMark"
					mark.Anchored = true
					mark.CanCollide = false
					mark.CanQuery = false
					mark.CanTouch = false
					mark.Material = Enum.Material.Neon
					mark.Color = Color3.fromRGB(255, 90, 60)
					mark.Size = Vector3.new(0.25, 0.1, 2.2)
					local base = root.Position - Vector3.new(0, 2.9, 0) + Vector3.new(math.random() - 0.5, 0, math.random() - 0.5)
					mark.CFrame = CFrame.lookAt(base, base + horizontal) * CFrame.Angles(0, math.rad(math.random(-35, 35)), 0)
					mark.Parent = folder
					TweenService:Create(mark, TweenInfo.new(4, Enum.EasingStyle.Linear), { Transparency = 1 }):Play()
					Debris:AddItem(mark, 4.2)
				end
			end
		end
	end
end

function Effects.destroy()
	chaseSound:Destroy()
	folder:Destroy()
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[--!strict
-- Builds every on-screen element. This module only constructs instances and
-- exposes small setters; animation and game logic live in Main.client.luau.
-- It runs under Lune in tests, so it must not touch Roblox services.
local Hud = {}

Hud.Colors = {
	Background = Color3.fromRGB(13, 19, 27),
	Panel = Color3.fromRGB(20, 28, 39),
	Border = Color3.fromRGB(62, 82, 100),
	Text = Color3.fromRGB(231, 239, 243),
	Muted = Color3.fromRGB(158, 177, 189),
	Survivor = Color3.fromRGB(124, 212, 202),
	Killer = Color3.fromRGB(255, 137, 87),
	Danger = Color3.fromRGB(241, 79, 79),
	Warn = Color3.fromRGB(255, 196, 92),
	Good = Color3.fromRGB(127, 239, 151),
	Chad = Color3.fromRGB(247, 213, 111),
	Injured = Color3.fromRGB(255, 160, 96),
	Caged = Color3.fromRGB(200, 120, 255),
}
local colors = Hud.Colors

Hud.StatusColors = {
	Healthy = colors.Good,
	Injured = colors.Injured,
	Downed = colors.Danger,
	Carried = colors.Danger,
	Caged = colors.Caged,
	Escaped = colors.Chad,
	Eliminated = colors.Muted,
}

function Hud.label(name: string, parent: Instance, size: number, color: Color3): TextLabel
	local item = Instance.new("TextLabel")
	item.Name = name
	item.BackgroundTransparency = 1
	item.Font = Enum.Font.GothamMedium
	item.TextSize = size
	item.TextColor3 = color
	item.TextXAlignment = Enum.TextXAlignment.Left
	item.TextYAlignment = Enum.TextYAlignment.Center
	item.Text = ""
	item.Parent = parent
	return item
end
local label = Hud.label

local function corner(parent: Instance, radius: number)
	local item = Instance.new("UICorner")
	item.CornerRadius = UDim.new(0, radius)
	item.Parent = parent
end

local function stroke(parent: Instance, color: Color3, thickness: number?, transparency: number?): UIStroke
	local item = Instance.new("UIStroke")
	item.Color = color
	item.Thickness = thickness or 1
	item.Transparency = transparency or 0
	item.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	item.Parent = parent
	return item
end

local function panel(name: string, parent: Instance): Frame
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.BackgroundColor3 = colors.Background
	frame.BackgroundTransparency = 0.15
	frame.BorderSizePixel = 0
	frame.Parent = parent
	corner(frame, 10)
	stroke(frame, colors.Border, 1, 0.2)
	return frame
end

local function button(name: string, text: string, parent: Instance): TextButton
	local item = Instance.new("TextButton")
	item.Name = name
	item.Text = text
	item.TextSize = 13
	item.TextColor3 = colors.Text
	item.Font = Enum.Font.GothamBold
	item.BackgroundColor3 = colors.Border
	item.BorderSizePixel = 0
	item.AutoButtonColor = true
	item.Size = UDim2.fromOffset(44, 32)
	item.Selectable = true
	item.Parent = parent
	corner(item, 6)
	return item
end
Hud.button = button

local function bar(name: string, parent: Instance, color: Color3): (Frame, Frame)
	local track = Instance.new("Frame")
	track.Name = name
	track.BorderSizePixel = 0
	track.BackgroundColor3 = Color3.fromRGB(35, 45, 58)
	track.Parent = parent
	corner(track, 4)
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.BorderSizePixel = 0
	fill.BackgroundColor3 = color
	fill.Size = UDim2.fromScale(0, 1)
	fill.Parent = track
	corner(fill, 4)
	return track, fill
end

local function fullscreen(name: string, parent: Instance, color: Color3): Frame
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.BorderSizePixel = 0
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.fromScale(1, 1)
	frame.Active = false
	frame.Parent = parent
	return frame
end

export type AbilityButton = {
	Button: TextButton,
	Cooldown: Frame,
	CooldownText: TextLabel,
	Key: TextLabel,
	Name: TextLabel,
	Id: string,
}

export type TeamRow = {
	Frame: Frame,
	Dot: Frame,
	Name: TextLabel,
	Detail: TextLabel,
	TimerFill: Frame,
}

function Hud.create(parent: Instance)
	local screen = Instance.new("ScreenGui")
	screen.Name = "EscapeTheChadHUD"
	screen.ResetOnSpawn = false
	screen.DisplayOrder = 10
	screen.IgnoreGuiInset = false
	screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screen.Parent = parent

	-- Full-screen effect layers sit underneath the panels.
	local blind = fullscreen("BlindOverlay", screen, Color3.new(1, 1, 1))
	local smoke = fullscreen("SmokeOverlay", screen, Color3.fromRGB(150, 156, 170))
	local vignette = fullscreen("DangerVignette", screen, colors.Danger)
	local border = Instance.new("Frame")
	border.Name = "ChaseBorder"
	border.BackgroundTransparency = 1
	border.Position = UDim2.fromOffset(4, 4)
	border.Size = UDim2.new(1, -8, 1, -8)
	border.Parent = screen
	local dangerStroke = stroke(border, colors.Danger, 6, 1)

	-- Match status panel (top centre) -------------------------------------
	local main = panel("MatchPanel", screen)
	main.AnchorPoint = Vector2.new(0.5, 0)
	main.Position = UDim2.new(0.5, 0, 0, 8)
	local role = label("Role", main, 13, colors.Survivor)
	role.Font = Enum.Font.GothamBlack
	role.Position = UDim2.fromOffset(12, 6)
	role.Size = UDim2.new(1, -140, 0, 24)
	role.TextTruncate = Enum.TextTruncate.AtEnd
	local timer = label("Timer", main, 20, colors.Text)
	timer.Font = Enum.Font.GothamBlack
	timer.Position = UDim2.new(1, -124, 0, 6)
	timer.Size = UDim2.fromOffset(66, 24)
	timer.TextXAlignment = Enum.TextXAlignment.Right
	local hide = button("HideHUD", "X", main)
	hide.Position = UDim2.new(1, -50, 0, 6)
	local rank = label("BPRank", main, 13, colors.Survivor)
	rank.Font = Enum.Font.GothamBold
	rank.Position = UDim2.fromOffset(12, 32)
	rank.Size = UDim2.new(1, -24, 0, 20)
	rank.TextTruncate = Enum.TextTruncate.AtEnd
	local objective = label("ObjectiveProgress", main, 12, colors.Muted)
	objective.Position = UDim2.fromOffset(12, 54)
	objective.Size = UDim2.new(1, -96, 0, 22)
	objective.TextTruncate = Enum.TextTruncate.AtEnd
	local helpButton = button("HelpToggle", "Help", main)
	helpButton.Position = UDim2.new(1, -78, 0, 50)
	helpButton.Size = UDim2.fromOffset(72, 30)
	local track, fill = bar("TeamProgress", main, colors.Survivor)
	track.Position = UDim2.new(0, 12, 1, -9)
	track.Size = UDim2.new(1, -24, 0, 4)

	-- Help / instructions ---------------------------------------------------
	local details = panel("Instructions", screen)
	details.AnchorPoint = Vector2.new(0.5, 0)
	details.Position = UDim2.new(0.5, 0, 0, 108)
	details.Visible = false
	details.ZIndex = 5
	local heading = label("Heading", details, 15, colors.Text)
	heading.Font = Enum.Font.GothamBlack
	heading.Text = "HOW TO PLAY"
	heading.Position = UDim2.fromOffset(12, 8)
	heading.Size = UDim2.new(1, -80, 0, 30)
	local close = button("CloseHelp", "Close", details)
	close.Position = UDim2.new(1, -68, 0, 6)
	close.Size = UDim2.fromOffset(60, 32)
	local help = label("Controls", details, 13, colors.Text)
	help.Position = UDim2.fromOffset(12, 42)
	help.Size = UDim2.new(1, -24, 0, 112)
	help.TextWrapped = true
	help.TextYAlignment = Enum.TextYAlignment.Top
	local message = label("Message", details, 12, colors.Muted)
	message.Position = UDim2.fromOffset(12, 160)
	message.Size = UDim2.new(1, -24, 0, 40)
	message.TextWrapped = true
	local nextRank = label("NextRank", details, 12, colors.Survivor)
	nextRank.Position = UDim2.fromOffset(12, 204)
	nextRank.Size = UDim2.new(1, -24, 0, 36)
	nextRank.TextWrapped = true
	local restore = button("RestoreHUD", "HUD", screen)
	restore.AnchorPoint = Vector2.new(1, 0)
	restore.Position = UDim2.new(1, -12, 0, 8)
	restore.Size = UDim2.fromOffset(60, 36)
	restore.Visible = false

	-- Team list (left) ------------------------------------------------------
	local team = panel("TeamPanel", screen)
	team.Position = UDim2.fromOffset(10, 110)
	team.Size = UDim2.fromOffset(200, 34)
	team.Visible = false
	local teamTitle = label("Title", team, 12, colors.Muted)
	teamTitle.Font = Enum.Font.GothamBlack
	teamTitle.Text = "SURVIVORS"
	teamTitle.Position = UDim2.fromOffset(10, 4)
	teamTitle.Size = UDim2.new(1, -20, 0, 22)
	local teamRows: { TeamRow } = {}
	for index = 1, 8 do
		local row = Instance.new("Frame")
		row.Name = "Row" .. index
		row.BackgroundTransparency = 1
		row.Position = UDim2.fromOffset(8, 28 + (index - 1) * 38)
		row.Size = UDim2.new(1, -16, 0, 36)
		row.Visible = false
		row.Parent = team
		local dot = Instance.new("Frame")
		dot.Name = "Dot"
		dot.BorderSizePixel = 0
		dot.Size = UDim2.fromOffset(10, 10)
		dot.Position = UDim2.fromOffset(2, 6)
		dot.BackgroundColor3 = colors.Good
		dot.Parent = row
		corner(dot, 5)
		local name = label("Name", row, 13, colors.Text)
		name.Font = Enum.Font.GothamBold
		name.Position = UDim2.fromOffset(18, 0)
		name.Size = UDim2.new(1, -18, 0, 20)
		name.TextTruncate = Enum.TextTruncate.AtEnd
		local detail = label("Detail", row, 11, colors.Muted)
		detail.Position = UDim2.fromOffset(18, 18)
		detail.Size = UDim2.new(1, -18, 0, 14)
		detail.TextTruncate = Enum.TextTruncate.AtEnd
		local timerTrack, timerFill = bar("CageTimer", row, colors.Caged)
		timerTrack.Position = UDim2.new(0, 18, 1, -2)
		timerTrack.Size = UDim2.new(1, -18, 0, 3)
		timerTrack.Visible = false
		table.insert(teamRows, { Frame = row, Dot = dot, Name = name, Detail = detail, TimerFill = timerFill })
	end

	-- Status banner, stamina, action button (bottom centre) -----------------
	local status = panel("StatusPanel", screen)
	status.AnchorPoint = Vector2.new(0.5, 1)
	status.Position = UDim2.new(0.5, 0, 1, -16)
	status.Size = UDim2.fromOffset(320, 64)
	status.Visible = false
	local statusText = label("StatusText", status, 14, colors.Text)
	statusText.Font = Enum.Font.GothamBlack
	statusText.TextXAlignment = Enum.TextXAlignment.Center
	statusText.Position = UDim2.fromOffset(10, 6)
	statusText.Size = UDim2.new(1, -20, 0, 22)
	statusText.TextTruncate = Enum.TextTruncate.AtEnd
	local staminaTrack, staminaFill = bar("Stamina", status, colors.Survivor)
	staminaTrack.Position = UDim2.new(0, 12, 0, 36)
	staminaTrack.Size = UDim2.new(1, -24, 0, 8)
	local staminaLabel = label("StaminaLabel", status, 10, colors.Muted)
	staminaLabel.Text = "STAMINA"
	staminaLabel.Position = UDim2.new(0, 12, 0, 46)
	staminaLabel.Size = UDim2.new(1, -24, 0, 14)
	local actionButton = button("ActionButton", "WIGGLE!", status)
	actionButton.AnchorPoint = Vector2.new(0.5, 0)
	actionButton.Position = UDim2.new(0.5, 0, 0, 32)
	actionButton.Size = UDim2.fromOffset(160, 28)
	actionButton.BackgroundColor3 = colors.Danger
	actionButton.Visible = false

	local chaseWarning = label("ChaseWarning", screen, 16, colors.Danger)
	chaseWarning.Font = Enum.Font.GothamBlack
	chaseWarning.TextStrokeTransparency = 0.35
	chaseWarning.TextXAlignment = Enum.TextXAlignment.Center
	chaseWarning.AnchorPoint = Vector2.new(0.5, 1)
	chaseWarning.Position = UDim2.new(0.5, 0, 1, -88)
	chaseWarning.Size = UDim2.new(1, -24, 0, 26)
	chaseWarning.Text = "OG CHAD IS NEAR"
	chaseWarning.Visible = false

	-- Ability bar (bottom right) --------------------------------------------
	local abilityBar = Instance.new("Frame")
	abilityBar.Name = "AbilityBar"
	abilityBar.BackgroundTransparency = 1
	abilityBar.AnchorPoint = Vector2.new(1, 1)
	abilityBar.Position = UDim2.new(1, -12, 1, -16)
	abilityBar.Size = UDim2.fromOffset(300, 78)
	abilityBar.Visible = false
	abilityBar.Parent = screen
	local barLayout = Instance.new("UIListLayout")
	barLayout.FillDirection = Enum.FillDirection.Horizontal
	barLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	barLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	barLayout.Padding = UDim.new(0, 8)
	barLayout.SortOrder = Enum.SortOrder.LayoutOrder
	barLayout.Parent = abilityBar
	local abilityButtons: { [string]: AbilityButton } = {}

	-- Toasts (top right) and splash (centre) ---------------------------------
	local toasts = Instance.new("Frame")
	toasts.Name = "Toasts"
	toasts.BackgroundTransparency = 1
	toasts.AnchorPoint = Vector2.new(1, 0)
	toasts.Position = UDim2.new(1, -12, 0, 52)
	toasts.Size = UDim2.fromOffset(300, 240)
	toasts.Parent = screen
	local toastLayout = Instance.new("UIListLayout")
	toastLayout.FillDirection = Enum.FillDirection.Vertical
	toastLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	toastLayout.Padding = UDim.new(0, 6)
	toastLayout.SortOrder = Enum.SortOrder.LayoutOrder
	toastLayout.Parent = toasts
	local toastCount = 0

	local splash = Instance.new("Frame")
	splash.Name = "Splash"
	splash.BackgroundTransparency = 1
	splash.AnchorPoint = Vector2.new(0.5, 0.5)
	splash.Position = UDim2.fromScale(0.5, 0.4)
	splash.Size = UDim2.new(1, -24, 0, 130)
	splash.Visible = false
	splash.Parent = screen
	local splashTitle = label("Title", splash, 44, colors.Text)
	splashTitle.Font = Enum.Font.GothamBlack
	splashTitle.TextXAlignment = Enum.TextXAlignment.Center
	splashTitle.TextStrokeTransparency = 0.4
	splashTitle.TextScaled = true
	splashTitle.Size = UDim2.new(1, 0, 0, 70)
	local splashTitleLimit = Instance.new("UITextSizeConstraint")
	splashTitleLimit.MaxTextSize = 54
	splashTitleLimit.Parent = splashTitle
	local splashSub = label("Subtitle", splash, 18, colors.Muted)
	splashSub.TextXAlignment = Enum.TextXAlignment.Center
	splashSub.TextStrokeTransparency = 0.5
	splashSub.TextWrapped = true
	splashSub.Position = UDim2.fromOffset(0, 74)
	splashSub.Size = UDim2.new(1, 0, 0, 50)

	-- Lobby panel (right): profile, loadout, map vote -------------------------
	local lobbyPanel = panel("LobbyPanel", screen)
	lobbyPanel.AnchorPoint = Vector2.new(1, 0.5)
	lobbyPanel.Position = UDim2.new(1, -12, 0.55, 0)
	lobbyPanel.Size = UDim2.fromOffset(280, 430)
	lobbyPanel.Visible = false
	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = "Scroll"
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.Position = UDim2.fromOffset(0, 4)
	scroll.Size = UDim2.new(1, 0, 1, -8)
	scroll.CanvasSize = UDim2.fromOffset(0, 0)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.ScrollBarThickness = 4
	scroll.Parent = lobbyPanel
	local scrollLayout = Instance.new("UIListLayout")
	scrollLayout.Padding = UDim.new(0, 6)
	scrollLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	scrollLayout.SortOrder = Enum.SortOrder.LayoutOrder
	scrollLayout.Parent = scroll
	local function section(name: string, text: string, order: number): TextLabel
		local item = label(name, scroll, 12, colors.Chad)
		item.Font = Enum.Font.GothamBlack
		item.Text = text
		item.Size = UDim2.new(1, -20, 0, 20)
		item.LayoutOrder = order
		return item
	end
	section("ProfileHeading", "YOUR PROFILE", 1)
	local profileCard = Instance.new("Frame")
	profileCard.Name = "ProfileCard"
	profileCard.BackgroundColor3 = colors.Panel
	profileCard.BorderSizePixel = 0
	profileCard.Size = UDim2.new(1, -20, 0, 74)
	profileCard.LayoutOrder = 2
	profileCard.Parent = scroll
	corner(profileCard, 8)
	local profileLevel = label("Level", profileCard, 15, colors.Text)
	profileLevel.Font = Enum.Font.GothamBlack
	profileLevel.Position = UDim2.fromOffset(10, 4)
	profileLevel.Size = UDim2.new(1, -20, 0, 22)
	local profileTitle = label("Title", profileCard, 12, colors.Chad)
	profileTitle.Position = UDim2.fromOffset(10, 24)
	profileTitle.Size = UDim2.new(1, -20, 0, 16)
	local xpTrack, xpFill = bar("XPBar", profileCard, colors.Chad)
	xpTrack.Position = UDim2.fromOffset(10, 44)
	xpTrack.Size = UDim2.new(1, -20, 0, 6)
	local profileStats = label("Stats", profileCard, 11, colors.Muted)
	profileStats.Position = UDim2.fromOffset(10, 52)
	profileStats.Size = UDim2.new(1, -20, 0, 18)
	profileStats.TextTruncate = Enum.TextTruncate.AtEnd

	section("LoadoutHeading", "SURVIVOR ABILITY", 3)
	local loadoutButtons: { [string]: TextButton } = {}
	local loadoutOrder = 4

	local voteHeading = section("VoteHeading", "MAP VOTE", 50)
	local voteButtons: { [string]: TextButton } = {}
	local voteOrder = 51

	local lobbyToggle = button("LobbyToggle", "Loadout", screen)
	lobbyToggle.AnchorPoint = Vector2.new(1, 0)
	lobbyToggle.Position = UDim2.new(1, -80, 0, 8)
	lobbyToggle.Size = UDim2.fromOffset(84, 36)
	lobbyToggle.Visible = false

	-- Spectate bar ----------------------------------------------------------
	local spectate = panel("SpectatePanel", screen)
	spectate.AnchorPoint = Vector2.new(0.5, 1)
	spectate.Position = UDim2.new(0.5, 0, 1, -16)
	spectate.Size = UDim2.fromOffset(300, 44)
	spectate.Visible = false
	local spectatePrev = button("Prev", "<", spectate)
	spectatePrev.Position = UDim2.fromOffset(6, 6)
	local spectateNext = button("Next", ">", spectate)
	spectateNext.Position = UDim2.new(1, -50, 0, 6)
	local spectateName = label("Name", spectate, 13, colors.Text)
	spectateName.Font = Enum.Font.GothamBold
	spectateName.TextXAlignment = Enum.TextXAlignment.Center
	spectateName.Position = UDim2.fromOffset(54, 0)
	spectateName.Size = UDim2.new(1, -108, 1, 0)
	spectateName.TextTruncate = Enum.TextTruncate.AtEnd

	-- Results ---------------------------------------------------------------
	local results = panel("Results", screen)
	results.AnchorPoint = Vector2.new(0.5, 0.5)
	results.Position = UDim2.fromScale(0.5, 0.5)
	results.Size = UDim2.fromOffset(460, 380)
	results.Visible = false
	results.ZIndex = 8
	local resultsBanner = label("Banner", results, 26, colors.Chad)
	resultsBanner.Font = Enum.Font.GothamBlack
	resultsBanner.TextXAlignment = Enum.TextXAlignment.Center
	resultsBanner.Position = UDim2.fromOffset(12, 10)
	resultsBanner.Size = UDim2.new(1, -24, 0, 36)
	resultsBanner.TextScaled = true
	local resultsText = label("Summary", results, 14, colors.Muted)
	resultsText.TextXAlignment = Enum.TextXAlignment.Center
	resultsText.TextWrapped = true
	resultsText.Position = UDim2.fromOffset(12, 48)
	resultsText.Size = UDim2.new(1, -24, 0, 34)
	local resultsClose = button("CloseResults", "Close", results)
	resultsClose.AnchorPoint = Vector2.new(0.5, 1)
	resultsClose.Position = UDim2.new(0.5, 0, 1, -10)
	resultsClose.Size = UDim2.fromOffset(110, 32)
	local resultRows: { TextLabel } = {}
	for index = 1, 8 do
		local row = label("Row" .. index, results, 13, colors.Text)
		row.Position = UDim2.fromOffset(16, 88 + (index - 1) * 30)
		row.Size = UDim2.new(1, -32, 0, 28)
		row.BackgroundTransparency = if index % 2 == 1 then 0.88 else 1
		row.BackgroundColor3 = colors.Border
		row.TextTruncate = Enum.TextTruncate.AtEnd
		row.RichText = true
		table.insert(resultRows, row)
	end

	local ui = {
		Screen = screen, Main = main, Details = details, Role = role, Timer = timer,
		Rank = rank, Objective = objective, ProgressFill = fill, Message = message,
		NextRank = nextRank, Help = help, HelpButton = helpButton, Close = close,
		Hide = hide, Restore = restore, ChaseWarning = chaseWarning, DangerStroke = dangerStroke,
		Team = team, TeamRows = teamRows,
		Status = status, StatusText = statusText, StaminaTrack = staminaTrack, StaminaFill = staminaFill,
		StaminaLabel = staminaLabel, ActionButton = actionButton,
		AbilityBar = abilityBar, AbilityButtons = abilityButtons,
		Toasts = toasts, Splash = splash, SplashTitle = splashTitle, SplashSubtitle = splashSub,
		LobbyPanel = lobbyPanel, LobbyToggle = lobbyToggle, ProfileLevel = profileLevel, ProfileTitle = profileTitle,
		XPFill = xpFill, ProfileStats = profileStats, LoadoutButtons = loadoutButtons,
		VoteHeading = voteHeading, VoteButtons = voteButtons,
		Spectate = spectate, SpectatePrev = spectatePrev, SpectateNext = spectateNext, SpectateName = spectateName,
		Results = results, ResultsBanner = resultsBanner, ResultsText = resultsText, ResultsClose = resultsClose,
		ResultRows = resultRows,
		Blind = blind, Smoke = smoke, Vignette = vignette,
	}

	function ui.setHelpVisible(visible: boolean)
		details.Visible = visible
		if visible then
			main.Visible = true
			restore.Visible = false
		end
		helpButton.Text = if visible then "Close" else "Help"
	end

	function ui.setHudVisible(visible: boolean)
		main.Visible = visible
		restore.Visible = not visible
		if not visible then
			ui.setHelpVisible(false)
		end
	end

	function ui.resize(viewport: Vector2)
		local width = math.max(240, math.min(420, viewport.X - 24))
		main.Size = UDim2.fromOffset(width, 92)
		details.Size = UDim2.fromOffset(width, 246)
		local scale = details:FindFirstChildOfClass("UIScale")
		if not scale then
			scale = Instance.new("UIScale")
			scale.Parent = details
		end
		(scale :: UIScale).Scale = math.clamp((viewport.Y - 124) / 246, 0.5, 1)
		-- Side panels shrink on phones so the centre of the screen stays clear.
		local compact = viewport.X < 700 or viewport.Y < 450
		local sideScale = if compact then 0.72 else 1
		for _, frame in { team, lobbyPanel, abilityBar, status, results, spectate } do
			local item = frame:FindFirstChildOfClass("UIScale")
			if not item then
				item = Instance.new("UIScale")
				item.Parent = frame
			end
			(item :: UIScale).Scale = sideScale
		end
		results.Size = UDim2.fromOffset(math.min(460, (viewport.X - 24) / sideScale), math.min(380, (viewport.Y - 24) / sideScale))
		lobbyPanel.Size = UDim2.fromOffset(280, math.min(430, (viewport.Y - 120) / sideScale))
		team.Position = UDim2.fromOffset(10, if compact then 96 else 110)
	end

	function ui.setTeam(entries: { { Name: string, Detail: string, Color: Color3, Timer: number? } })
		team.Visible = #entries > 0
		for index, row in teamRows do
			local entry = entries[index]
			row.Frame.Visible = entry ~= nil
			if entry then
				row.Name.Text = entry.Name
				row.Detail.Text = entry.Detail
				row.Dot.BackgroundColor3 = entry.Color
				local timerTrack = row.TimerFill.Parent :: Frame
				timerTrack.Visible = entry.Timer ~= nil
				row.TimerFill.Size = UDim2.fromScale(math.clamp(entry.Timer or 0, 0, 1), 1)
			end
		end
		team.Size = UDim2.fromOffset(200, 32 + math.min(#entries, #teamRows) * 38)
	end

	function ui.setAbilities(list: { { Id: string, Key: string, Name: string, Color: Color3? } }): { [string]: AbilityButton }
		for _, existing in abilityButtons do
			existing.Button:Destroy()
		end
		table.clear(abilityButtons)
		for index, ability in list do
			local item = button("Ability_" .. ability.Id, "", abilityBar)
			item.Size = UDim2.fromOffset(68, 72)
			item.LayoutOrder = index
			item.BackgroundColor3 = colors.Panel
			stroke(item, ability.Color or colors.Border, 2, 0.1)
			local key = label("Key", item, 18, ability.Color or colors.Text)
			key.Font = Enum.Font.GothamBlack
			key.Text = ability.Key
			key.TextXAlignment = Enum.TextXAlignment.Center
			key.Position = UDim2.fromOffset(0, 8)
			key.Size = UDim2.new(1, 0, 0, 26)
			local name = label("AbilityName", item, 10, colors.Text)
			name.Text = ability.Name
			name.TextXAlignment = Enum.TextXAlignment.Center
			name.TextWrapped = true
			name.Position = UDim2.fromOffset(2, 36)
			name.Size = UDim2.new(1, -4, 0, 30)
			local cooldown = Instance.new("Frame")
			cooldown.Name = "Cooldown"
			cooldown.BorderSizePixel = 0
			cooldown.BackgroundColor3 = Color3.new(0, 0, 0)
			cooldown.BackgroundTransparency = 0.35
			cooldown.AnchorPoint = Vector2.new(0, 1)
			cooldown.Position = UDim2.fromScale(0, 1)
			cooldown.Size = UDim2.fromScale(1, 0)
			cooldown.ZIndex = 2
			cooldown.Parent = item
			corner(cooldown, 6)
			local cooldownText = label("CooldownText", item, 20, colors.Text)
			cooldownText.Font = Enum.Font.GothamBlack
			cooldownText.TextXAlignment = Enum.TextXAlignment.Center
			cooldownText.Size = UDim2.fromScale(1, 1)
			cooldownText.ZIndex = 3
			abilityButtons[ability.Id] = { Button = item, Cooldown = cooldown, CooldownText = cooldownText, Key = key, Name = name, Id = ability.Id }
		end
		abilityBar.Size = UDim2.fromOffset(#list * 76, 78)
		return abilityButtons
	end

	-- fraction: 0 = ready, 1 = just used. active: highlighted (sprinting, crouched).
	function ui.setCooldown(id: string, fraction: number, seconds: number, active: boolean?)
		local entry = abilityButtons[id]
		if not entry then
			return
		end
		entry.Cooldown.Size = UDim2.fromScale(1, math.clamp(fraction, 0, 1))
		entry.CooldownText.Text = if seconds > 0 then tostring(math.ceil(seconds)) else ""
		entry.Button.BackgroundColor3 = if active then colors.Border else colors.Panel
	end

	function ui.pushToast(text: string, color: Color3): TextLabel
		toastCount += 1
		local item = label("Toast", toasts, 13, colors.Text)
		item.Font = Enum.Font.GothamBold
		item.Text = text
		item.TextWrapped = true
		item.AutomaticSize = Enum.AutomaticSize.Y
		item.Size = UDim2.new(1, 0, 0, 30)
		item.BackgroundColor3 = colors.Background
		item.BackgroundTransparency = 0.15
		item.LayoutOrder = toastCount
		local padding = Instance.new("UIPadding")
		padding.PaddingLeft = UDim.new(0, 10)
		padding.PaddingRight = UDim.new(0, 10)
		padding.PaddingTop = UDim.new(0, 6)
		padding.PaddingBottom = UDim.new(0, 6)
		padding.Parent = item
		corner(item, 8)
		stroke(item, color, 2, 0)
		local children = toasts:GetChildren()
		local labels = {}
		for _, child in children do
			if child:IsA("TextLabel") then
				table.insert(labels, child)
			end
		end
		table.sort(labels, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		while #labels > 5 do
			table.remove(labels, 1):Destroy()
		end
		return item
	end

	function ui.setLoadout(list: { { Id: string, Name: string, Description: string, Color: Color3? } }, selected: string)
		for _, ability in list do
			local item = loadoutButtons[ability.Id]
			if not item then
				local created = button("Loadout_" .. ability.Id, "", scroll)
				created.Size = UDim2.new(1, -20, 0, 52)
				created.LayoutOrder = loadoutOrder
				loadoutOrder += 1
				created.BackgroundColor3 = colors.Panel
				created.TextXAlignment = Enum.TextXAlignment.Left
				local title = label("Title", created, 13, ability.Color or colors.Text)
				title.Font = Enum.Font.GothamBlack
				title.Text = ability.Name
				title.Position = UDim2.fromOffset(10, 4)
				title.Size = UDim2.new(1, -20, 0, 18)
				local body = label("Body", created, 10, colors.Muted)
				body.Text = ability.Description
				body.TextWrapped = true
				body.TextYAlignment = Enum.TextYAlignment.Top
				body.Position = UDim2.fromOffset(10, 22)
				body.Size = UDim2.new(1, -20, 0, 28)
				stroke(created, ability.Color or colors.Border, 2, 1)
				loadoutButtons[ability.Id] = created
				item = created
			end
			local itemStroke = (item :: TextButton):FindFirstChildOfClass("UIStroke")
			if itemStroke then
				itemStroke.Transparency = if ability.Id == selected then 0 else 0.85
			end
		end
	end

	function ui.setVotes(options: { { Id: string, Name: string, Blurb: string, Votes: number } }, mine: string?, open: boolean)
		voteHeading.Visible = open and #options > 0
		for _, option in options do
			local item = voteButtons[option.Id]
			if not item then
				local created = button("Vote_" .. option.Id, "", scroll)
				created.Size = UDim2.new(1, -20, 0, 56)
				created.LayoutOrder = voteOrder
				voteOrder += 1
				created.BackgroundColor3 = colors.Panel
				local title = label("Title", created, 14, colors.Text)
				title.Font = Enum.Font.GothamBlack
				title.Position = UDim2.fromOffset(10, 4)
				title.Size = UDim2.new(1, -60, 0, 20)
				local body = label("Body", created, 10, colors.Muted)
				body.TextWrapped = true
				body.TextYAlignment = Enum.TextYAlignment.Top
				body.Position = UDim2.fromOffset(10, 24)
				body.Size = UDim2.new(1, -20, 0, 30)
				local count = label("Count", created, 16, colors.Chad)
				count.Font = Enum.Font.GothamBlack
				count.TextXAlignment = Enum.TextXAlignment.Right
				count.Position = UDim2.new(1, -54, 0, 4)
				count.Size = UDim2.fromOffset(44, 20)
				stroke(created, colors.Chad, 2, 1)
				voteButtons[option.Id] = created
				item = created
			end
			local voteButton = item :: TextButton
			voteButton.Visible = open
			local title = voteButton:FindFirstChild("Title") :: TextLabel?
			local body = voteButton:FindFirstChild("Body") :: TextLabel?
			local count = voteButton:FindFirstChild("Count") :: TextLabel?
			if title then title.Text = option.Name end
			if body then body.Text = option.Blurb end
			if count then count.Text = tostring(option.Votes) end
			local itemStroke = voteButton:FindFirstChildOfClass("UIStroke")
			if itemStroke then
				itemStroke.Transparency = if option.Id == mine then 0 else 0.85
			end
		end
	end

	function ui.setProfile(level: number, title: string, into: number, need: number, statsText: string)
		profileLevel.Text = string.format("LEVEL %d", level)
		profileTitle.Text = title
		xpFill.Size = UDim2.fromScale(if need > 0 then math.clamp(into / need, 0, 1) else 0, 1)
		profileStats.Text = statsText
	end

	function ui.setLobbyVisible(visible: boolean)
		lobbyPanel.Visible = visible
		lobbyToggle.Text = if visible then "Hide" else "Loadout"
	end

	function ui.showResults(banner: string, color: Color3, summary: string, rows: { string })
		results.Visible = true
		resultsBanner.Text = banner
		resultsBanner.TextColor3 = color
		resultsText.Text = summary
		for index, row in resultRows do
			row.Text = rows[index] or ""
			row.Visible = rows[index] ~= nil
		end
	end

	ui.resize(Vector2.new(800, 600))
	return ui
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="22">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- Presentation and input only. Roles, health states, BP, captures, abilities
-- and progression are owned by the server; this script renders them and sends
-- requests through the Action remote.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local localPlayer = Players.LocalPlayer
local shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(shared:WaitForChild("Config"))
local Rules = require(shared:WaitForChild("Rules"))
local Abilities = require(shared:WaitForChild("Abilities"))
local matchState = ReplicatedStorage:WaitForChild("MatchState")
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local actionRemote = remotes:WaitForChild("Action") :: RemoteEvent
local notifyRemote = remotes:WaitForChild("Notify") :: RemoteEvent

local Hud = require(script.Parent:WaitForChild("Hud"))
local Movement = require(script.Parent:WaitForChild("Movement"))
local Effects = require(script.Parent:WaitForChild("Effects"))
local Poses = require(script.Parent:WaitForChild("Poses"))
local colors = Hud.Colors

local connections: { RBXScriptConnection } = {}
local destroyed = false
local ui = Hud.create(localPlayer:WaitForChild("PlayerGui"))
local movement = Movement.new(localPlayer)

local function connect(signal: RBXScriptSignal, callback: (...any) -> ())
	table.insert(connections, signal:Connect(callback))
end
for _, connection in Poses.start() do
	table.insert(connections, connection)
end

-- Resetting your character would be an escape from carries and cages.
task.spawn(function()
	for _ = 1, 20 do
		if pcall(function()
			StarterGui:SetCore("ResetButtonCallback", false)
		end) then
			return
		end
		task.wait(1)
	end
end)

local function str(instance: Instance, name: string, fallback: string): string
	local value = instance:GetAttribute(name)
	return if type(value) == "string" then value else fallback
end

local function num(instance: Instance, name: string, fallback: number): number
	local value = instance:GetAttribute(name)
	return if type(value) == "number" then value else fallback
end

local function serverNow(): number
	return Workspace:GetServerTimeNow()
end

local function phase(): string
	return str(matchState, "Phase", "Waiting")
end

local function myRole(): string
	return str(localPlayer, "Role", "Lobby")
end

local function myStatus(): string
	return str(localPlayer, "Status", "Lobby")
end

local function inRound(): boolean
	return phase() == "Active" and (myRole() == "Survivor" or myRole() == "Killer")
end

local function isFreeSurvivor(): boolean
	local status = myStatus()
	return myRole() == "Survivor" and (status == "Healthy" or status == "Injured") and localPlayer:GetAttribute("Hidden") ~= true
end

local function action(name: string, argument: any?)
	actionRemote:FireServer(name, argument)
end

-- Toasts and splash -------------------------------------------------------------

local toneColors: { [string]: Color3 } = {
	good = colors.Good,
	bad = colors.Danger,
	warn = colors.Warn,
	info = colors.Border,
}

local function toast(text: string, tone: string?)
	local item = ui.pushToast(text, toneColors[tone or "info"] or colors.Border)
	task.delay(5, function()
		if item.Parent then
			local fade = TweenService:Create(item, TweenInfo.new(0.5), { TextTransparency = 1, BackgroundTransparency = 1 })
			fade:Play()
			fade.Completed:Wait()
			item:Destroy()
		end
	end)
end

local splashToken = 0
local function splash(title: string, subtitle: string, color: Color3, seconds: number)
	splashToken += 1
	local token = splashToken
	ui.Splash.Visible = true
	ui.SplashTitle.Text = title
	ui.SplashTitle.TextColor3 = color
	ui.SplashTitle.TextTransparency = 1
	ui.SplashSubtitle.Text = subtitle
	ui.SplashSubtitle.TextTransparency = 1
	TweenService:Create(ui.SplashTitle, TweenInfo.new(0.35, Enum.EasingStyle.Back), { TextTransparency = 0 }):Play()
	TweenService:Create(ui.SplashSubtitle, TweenInfo.new(0.6), { TextTransparency = 0 }):Play()
	task.delay(seconds, function()
		if token ~= splashToken then
			return
		end
		TweenService:Create(ui.SplashTitle, TweenInfo.new(0.6), { TextTransparency = 1 }):Play()
		local fade = TweenService:Create(ui.SplashSubtitle, TweenInfo.new(0.6), { TextTransparency = 1 })
		fade:Play()
		fade.Completed:Wait()
		if token == splashToken then
			ui.Splash.Visible = false
		end
	end)
end

-- HUD buttons ---------------------------------------------------------------------

local lobbyHiddenByUser = false
connect(ui.HelpButton.Activated, function()
	ui.setHelpVisible(not ui.Details.Visible)
end)
connect(ui.Close.Activated, function()
	ui.setHelpVisible(false)
end)
connect(ui.Hide.Activated, function()
	ui.setHudVisible(false)
end)
connect(ui.Restore.Activated, function()
	ui.setHudVisible(true)
end)
connect(ui.ResultsClose.Activated, function()
	ui.Results.Visible = false
end)
connect(ui.LobbyToggle.Activated, function()
	lobbyHiddenByUser = ui.LobbyPanel.Visible
	ui.setLobbyVisible(not ui.LobbyPanel.Visible)
end)
connect(ui.ActionButton.Activated, function()
	local status = myStatus()
	if status == "Carried" then
		action("Wiggle")
	elseif status == "Caged" then
		action("Struggle")
	end
end)

-- Abilities -------------------------------------------------------------------------

type BarEntry = { Id: string, Key: string, Name: string, Color: Color3?, Cooldown: number }
local barSignature = ""
local barEntries: { BarEntry } = {}

local function useAbility(id: string)
	if id == "Sprint" then
		movement.SprintToggled = not movement.SprintToggled
	elseif id == "Slide" then
		movement:slide()
	elseif id == "Attack" then
		if inRound() and myRole() == "Killer" then
			action("Attack")
		end
	elseif inRound() then
		action("Ability", id)
	end
end

local function rebuildAbilityBar()
	local role = myRole()
	local entries: { BarEntry } = {}
	if role == "Killer" and phase() == "Active" then
		table.insert(entries, { Id = "Attack", Key = "Click", Name = "Attack", Color = colors.Killer, Cooldown = Config.AttackHitCooldown })
		for _, ability in Abilities.Killer do
			table.insert(entries, { Id = ability.Id, Key = ability.Key, Name = ability.Name, Color = ability.Color, Cooldown = ability.Cooldown })
		end
	else
		table.insert(entries, { Id = "Sprint", Key = "Shift", Name = "Sprint", Color = colors.Survivor, Cooldown = 0 })
		table.insert(entries, { Id = "Slide", Key = "C", Name = "Slide", Color = colors.Survivor, Cooldown = Config.SlideCooldown })
		if role == "Survivor" and phase() == "Active" then
			local ability = Abilities.get(str(localPlayer, "Ability", Abilities.DefaultSurvivor))
			if ability then
				table.insert(entries, { Id = ability.Id, Key = ability.Key, Name = ability.Name, Color = ability.Color, Cooldown = ability.Cooldown })
			end
		end
	end
	local parts = {}
	for _, entry in entries do
		table.insert(parts, entry.Id)
	end
	local signature = table.concat(parts, ",")
	if signature == barSignature then
		return
	end
	barSignature = signature
	barEntries = entries
	local buttons = ui.setAbilities(entries)
	for id, entry in buttons do
		entry.Button.Activated:Connect(function()
			useAbility(id)
		end)
	end
end

local function updateCooldowns()
	local now = serverNow()
	local clock = os.clock()
	for _, entry in barEntries do
		local remaining = 0
		local active = false
		if entry.Id == "Sprint" then
			active = movement.Sprinting or movement:wantsSprint()
		elseif entry.Id == "Slide" then
			remaining = math.max(0, movement.NextSlideAt - clock)
		elseif entry.Id == "Attack" then
			remaining = math.max(0, num(localPlayer, "AttackReadyAt", 0) - now)
		else
			remaining = math.max(0, num(localPlayer, "Ready_" .. entry.Id, 0) - now)
		end
		local fraction = if entry.Cooldown > 0 then remaining / entry.Cooldown else 0
		ui.setCooldown(entry.Id, fraction, remaining, active)
	end
end

-- Input -----------------------------------------------------------------------------

local function survivorAbilityId(): string
	return str(localPlayer, "Ability", Abilities.DefaultSurvivor)
end

connect(UserInputService.InputBegan, function(input: InputObject, processed: boolean)
	if UserInputService:GetFocusedTextBox() then
		return
	end
	local key = input.KeyCode
	if key == Enum.KeyCode.LeftShift or key == Enum.KeyCode.RightShift then
		movement.SprintHeld = true
		return
	end
	if processed then
		return
	end
	if key == Enum.KeyCode.H then
		ui.setHelpVisible(not ui.Details.Visible)
	elseif key == Enum.KeyCode.C or key == Enum.KeyCode.ButtonB then
		movement:slide()
	elseif key == Enum.KeyCode.ButtonL3 then
		movement.SprintToggled = not movement.SprintToggled
	elseif key == Enum.KeyCode.Q or key == Enum.KeyCode.ButtonY then
		if myRole() == "Killer" then
			useAbility("Charge")
		elseif myRole() == "Survivor" then
			useAbility(survivorAbilityId())
		end
	elseif key == Enum.KeyCode.F or key == Enum.KeyCode.ButtonL1 then
		if myRole() == "Killer" then
			useAbility("Reveal")
		end
	elseif input.UserInputType == Enum.UserInputType.MouseButton1 or key == Enum.KeyCode.ButtonR2 then
		if myRole() == "Killer" then
			useAbility("Attack")
		end
	end
end)

connect(UserInputService.InputEnded, function(input: InputObject)
	if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
		movement.SprintHeld = false
	end
end)

-- Jump (Space, the mobile jump button, gamepad A): wiggle when carried, vault near windows.
local lastJump = 0
connect(UserInputService.JumpRequest, function()
	local clock = os.clock()
	local status = myStatus()
	if status == "Carried" then
		if clock - lastJump > 0.08 then
			lastJump = clock
			action("Wiggle")
		end
		return
	end
	if clock - lastJump < 0.25 then
		return
	end
	lastJump = clock
	if phase() == "Active" then
		movement:tryVault()
	end
end)

-- Server notifications -------------------------------------------------------------------

connect(notifyRemote.OnClientEvent, function(payload: any)
	if type(payload) ~= "table" then
		return
	end
	local kind = payload.Kind
	if kind == "Toast" and type(payload.Text) == "string" then
		toast(payload.Text, payload.Tone)
	elseif kind == "RoleReveal" then
		ui.Results.Visible = false
		if payload.Role == "Killer" then
			splash("YOU ARE THE OG CHAD", string.format("%s · Hunt them down. Click to attack, Q to charge, F for Mog Aura.", tostring(payload.MapName)), colors.Killer, 4)
		else
			splash("SURVIVE THE CHAD", string.format("%s · The OG Chad is %s. Calibrate terminals, reach Chad rank, escape.", tostring(payload.MapName), tostring(payload.KillerName)), colors.Survivor, 4)
		end
	elseif kind == "Ping" and typeof(payload.Position) == "Vector3" then
		Effects.ping(payload.Position, tostring(payload.Label or "Noise"), tonumber(payload.Duration) or 4)
	elseif kind == "Reveal" and type(payload.Ids) == "table" then
		Effects.reveal(payload.Ids, tonumber(payload.Duration) or 4)
	elseif kind == "Dash" then
		movement:dash(tonumber(payload.Duration) or 0.3)
	elseif kind == "Stamina" then
		movement:refill()
		toast("Protein Shake: stamina refilled and a burst of speed!", "good")
	elseif kind == "Blind" then
		Effects.blind(ui.Blind, tonumber(payload.Duration) or 2)
		if payload.Reason == "Jawline Flash" then
			toast("BLINDED by a Jawline Flash!", "bad")
		end
	elseif kind == "Flash" and typeof(payload.Position) == "Vector3" then
		Effects.flashBurst(payload.Position)
	elseif kind == "Swing" and type(payload.Id) == "number" then
		local attacker = Players:GetPlayerByUserId(payload.Id)
		if attacker then
			Effects.swing(attacker)
			Poses.swing(attacker)
		end
	elseif kind == "Hit" and type(payload.Id) == "number" then
		local victim = Players:GetPlayerByUserId(payload.Id)
		if victim then
			Effects.hitSpark(victim)
		end
		if payload.Id == localPlayer.UserId then
			Effects.hitFlash(ui.Vignette, payload.Downed == true)
		end
	elseif kind == "Results" then
		local winner = payload.Winner
		local banner = if winner == "Killer" then "OG CHAD WINS" elseif winner == "Survivors" then "SURVIVORS WIN" else "ROUND OVER"
		local color = if winner == "Killer" then colors.Killer elseif winner == "Survivors" then colors.Survivor else colors.Muted
		local rows = {}
		if type(payload.Rows) == "table" then
			for _, row in payload.Rows do
				if type(row) == "table" then
					local levelUp = if row.LevelUp then string.format("  <font color=\"#F7D56F\"><b>LEVEL UP → %d</b></font>", tonumber(row.Level) or 0) else ""
					local trophy = if row.Won then "🏆 " else ""
					table.insert(rows, string.format("%s<b>%s</b>  ·  %s  ·  %s  ·  <font color=\"#7FEF97\">+%d XP</font>%s",
						trophy, tostring(row.Name), tostring(row.Role), tostring(row.Outcome), tonumber(row.XP) or 0, levelUp))
				end
			end
		end
		ui.showResults(banner, color, tostring(payload.Result or ""), rows)
	end
end)

-- Prompt filtering ---------------------------------------------------------------------
-- The server enables every prompt; each client shows only the ones that apply.

local prompts: { [ProximityPrompt]: RBXScriptConnection } = {}

local function evaluatePrompt(prompt: ProximityPrompt)
	local kind = prompt:GetAttribute("Kind")
	local forRole = prompt:GetAttribute("ForRole")
	local visible = prompt:GetAttribute("Active") == true and phase() == "Active"
	local character = localPlayer.Character
	if character and prompt:IsDescendantOf(character) then
		visible = false
	end
	local role = myRole()
	local hiddenLocker = str(localPlayer, "HiddenLocker", "")
	if visible then
		if hiddenLocker ~= "" then
			local parent = prompt.Parent
			visible = kind == "Locker" and parent ~= nil and parent:GetAttribute("LockerId") == hiddenLocker
			prompt.ActionText = "Leave locker"
		elseif role == "Survivor" then
			visible = isFreeSurvivor() and (forRole == "Survivor" or forRole == "Any")
			if kind == "Locker" then
				prompt.ActionText = "Hide"
			end
		elseif role == "Killer" then
			local carrying = num(localPlayer, "Carrying", 0) ~= 0
			visible = forRole == "Killer" or forRole == "Any"
			if kind == "Pickup" then
				visible = visible and not carrying
			elseif kind == "Cage" then
				visible = visible and carrying
			elseif kind == "Locker" then
				visible = visible and not carrying
				prompt.ActionText = "Search locker"
			end
		else
			visible = false
		end
	end
	if prompt.Enabled ~= visible then
		prompt.Enabled = visible
	end
end

local function evaluateAllPrompts()
	for prompt in prompts do
		evaluatePrompt(prompt)
	end
end

local function trackPrompt(instance: Instance)
	if not instance:IsA("ProximityPrompt") or prompts[instance] then
		return
	end
	local prompt = instance :: ProximityPrompt
	prompts[prompt] = prompt.AttributeChanged:Connect(function()
		evaluatePrompt(prompt)
	end)
	evaluatePrompt(prompt)
end

connect(Workspace.DescendantAdded, trackPrompt)
connect(Workspace.DescendantRemoving, function(instance: Instance)
	if instance:IsA("ProximityPrompt") then
		local connection = prompts[instance :: ProximityPrompt]
		if connection then
			connection:Disconnect()
			prompts[instance :: ProximityPrompt] = nil
		end
	end
end)
for _, descendant in Workspace:GetDescendants() do
	trackPrompt(descendant)
end

-- Overhead labels ---------------------------------------------------------------------------
-- AlwaysOnTop=false so labels never reveal survivors through walls.

type PlayerView = {
	Connections: { RBXScriptConnection },
	Gui: BillboardGui?,
	NameLabel: TextLabel?,
	RankLabel: TextLabel?,
	Generation: number,
}
local playerViews: { [Player]: PlayerView } = {}

local function refreshBillboard(player: Player)
	local view = playerViews[player]
	if not view or not view.Gui or not view.NameLabel or not view.RankLabel then
		return
	end
	local role = str(player, "Role", "Lobby")
	local status = str(player, "Status", "Lobby")
	local shown = role == "Survivor" and status ~= "Escaped" and status ~= "Eliminated" and player:GetAttribute("Hidden") ~= true
	view.Gui.Enabled = shown and player ~= localPlayer
	view.NameLabel.Text = player.DisplayName
	local rank = str(player, "Rank", "LTN")
	local suffix = if status == "Healthy" then "" else " · " .. string.upper(status)
	view.RankLabel.Text = rank .. suffix
	view.RankLabel.TextColor3 = if status ~= "Healthy" then (Hud.StatusColors[status] or colors.Danger)
		elseif rank == "Chad" then colors.Chad
		else colors.Survivor
end

local function removeBillboard(view: PlayerView)
	view.Generation += 1
	if view.Gui then
		view.Gui:Destroy()
	end
	view.Gui = nil
	view.NameLabel = nil
	view.RankLabel = nil
end

local function attachBillboard(player: Player, character: Model)
	local view = playerViews[player]
	if not view then
		return
	end
	removeBillboard(view)
	local generation = view.Generation
	task.spawn(function()
		local head = character:WaitForChild("Head", 5)
		if destroyed or not head or not head:IsA("BasePart") or playerViews[player] ~= view or view.Generation ~= generation or player.Character ~= character then
			return
		end
		local billboard = Instance.new("BillboardGui")
		billboard.Name = "SurvivorBPRank"
		billboard.Adornee = head
		billboard.AlwaysOnTop = false
		billboard.MaxDistance = 50
		billboard.LightInfluence = 0
		billboard.Size = UDim2.fromOffset(200, 44)
		billboard.StudsOffsetWorldSpace = Vector3.new(0, 2.4, 0)
		billboard.Parent = head
		local nameLabel = Hud.label("PlayerName", billboard, 12, colors.Text)
		nameLabel.Size = UDim2.fromScale(1, 0.45)
		nameLabel.TextXAlignment = Enum.TextXAlignment.Center
		nameLabel.TextStrokeTransparency = 0.3
		local rankLabel = Hud.label("Rank", billboard, 14, colors.Survivor)
		rankLabel.Font = Enum.Font.GothamBold
		rankLabel.Position = UDim2.fromScale(0, 0.45)
		rankLabel.Size = UDim2.fromScale(1, 0.55)
		rankLabel.TextXAlignment = Enum.TextXAlignment.Center
		rankLabel.TextStrokeTransparency = 0.3
		view.Gui = billboard
		view.NameLabel = nameLabel
		view.RankLabel = rankLabel
		refreshBillboard(player)
	end)
end

local function trackPlayer(player: Player)
	if playerViews[player] then
		return
	end
	local view: PlayerView = { Connections = {}, Gui = nil, NameLabel = nil, RankLabel = nil, Generation = 0 }
	playerViews[player] = view
	table.insert(view.Connections, player.CharacterAdded:Connect(function(character)
		attachBillboard(player, character)
	end))
	table.insert(view.Connections, player.CharacterRemoving:Connect(function()
		removeBillboard(view)
	end))
	table.insert(view.Connections, player.AttributeChanged:Connect(function()
		refreshBillboard(player)
	end))
	if player.Character then
		attachBillboard(player, player.Character)
	end
end

local function untrackPlayer(player: Player)
	local view = playerViews[player]
	if not view then
		return
	end
	playerViews[player] = nil
	for _, connection in view.Connections do
		connection:Disconnect()
	end
	removeBillboard(view)
end

-- Camera: lockers and spectating --------------------------------------------------------------

local cameraMode = "Default"
local spectateIndex = 1

local function spectateTargets(): { Player }
	local list = {}
	for _, player in Players:GetPlayers() do
		local role = str(player, "Role", "Lobby")
		local status = str(player, "Status", "Lobby")
		if player ~= localPlayer and (role == "Killer" or (role == "Survivor" and status ~= "Escaped" and status ~= "Eliminated")) then
			if player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
				table.insert(list, player)
			end
		end
	end
	table.sort(list, function(a, b)
		return a.UserId < b.UserId
	end)
	return list
end

connect(ui.SpectatePrev.Activated, function()
	spectateIndex -= 1
end)
connect(ui.SpectateNext.Activated, function()
	spectateIndex += 1
end)

local doorCache: { [string]: BasePart } = {}
local function findLockerDoor(lockerId: string): BasePart?
	local cached = doorCache[lockerId]
	if cached and cached.Parent and cached:GetAttribute("LockerId") == lockerId then
		return cached
	end
	local map = Workspace:FindFirstChild("ActiveMap")
	if not map then
		return nil
	end
	for _, descendant in map:GetDescendants() do
		if descendant:IsA("BasePart") and descendant:GetAttribute("LockerId") == lockerId then
			doorCache[lockerId] = descendant
			return descendant
		end
	end
	return nil
end

local function updateCamera()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local hiddenLocker = str(localPlayer, "HiddenLocker", "")
	local status = myStatus()
	local spectating = phase() == "Active" and (status == "Escaped" or status == "Eliminated" or status == "Spectating")
	if hiddenLocker ~= "" then
		local door = findLockerDoor(hiddenLocker)
		if door then
			cameraMode = "Locker"
			camera.CameraType = Enum.CameraType.Scriptable
			-- Peek through the vents: slight sway, looking out of the door.
			local sway = math.sin(os.clock() * 1.3) * 0.04
			camera.CFrame = door.CFrame * CFrame.new(0, 1.7, -0.35) * CFrame.Angles(-0.05, sway, 0)
			ui.Spectate.Visible = false
			return
		end
	end
	if cameraMode == "Locker" then
		camera.CameraType = Enum.CameraType.Custom
		cameraMode = "Default"
	end
	if spectating then
		local targets = spectateTargets()
		ui.Spectate.Visible = #targets > 0
		if #targets > 0 then
			if spectateIndex < 1 then
				spectateIndex = #targets
			elseif spectateIndex > #targets then
				spectateIndex = 1
			end
			local target = targets[spectateIndex]
			local humanoid = target.Character and target.Character:FindFirstChildOfClass("Humanoid")
			if humanoid and camera.CameraSubject ~= humanoid then
				camera.CameraSubject = humanoid
			end
			ui.SpectateName.Text = "Spectating " .. target.DisplayName .. "  ·  " .. str(target, "Status", "")
			cameraMode = "Spectate"
		end
		return
	end
	ui.Spectate.Visible = false
	if cameraMode == "Spectate" then
		cameraMode = "Default"
		local humanoid = localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			camera.CameraSubject = humanoid
		end
	end
end

-- HUD refresh ------------------------------------------------------------------------------

local function formatTime(seconds: number): string
	seconds = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end

local function mapOptions(): { { Id: string, Name: string, Blurb: string, Votes: number } }
	local options = {}
	for entry in string.gmatch(str(matchState, "MapOptions", ""), "[^;]+") do
		local id, name, blurb = string.match(entry, "^([^|]*)|([^|]*)|(.*)$")
		if id and name and blurb then
			table.insert(options, { Id = id, Name = name, Blurb = blurb, Votes = num(matchState, "Votes_" .. id, 0) })
		end
	end
	return options
end

local myVote: string? = nil
local voteConnections: { [string]: boolean } = {}
local loadoutConnections: { [string]: boolean } = {}

local function refreshLobby()
	local currentPhase = phase()
	local participating = inRound()
	ui.LobbyToggle.Visible = not participating
	if participating then
		ui.setLobbyVisible(false)
	elseif not lobbyHiddenByUser and not ui.LobbyPanel.Visible then
		ui.setLobbyVisible(true)
	end
	ui.setProfile(
		num(localPlayer, "Level", 1),
		str(localPlayer, "Title", Rules.titleForLevel(1)),
		num(localPlayer, "XPInto", 0),
		num(localPlayer, "XPNeed", Rules.xpToNext(1)),
		string.format("Wins %d · Escapes %d · Rounds %d", num(localPlayer, "Wins", 0), num(localPlayer, "Escapes", 0), num(localPlayer, "RoundsPlayed", 0))
	)
	ui.setLoadout(Abilities.Survivor :: any, survivorAbilityId())
	for id, loadoutButton in ui.LoadoutButtons do
		if not loadoutConnections[id] then
			loadoutConnections[id] = true
			loadoutButton.Activated:Connect(function()
				action("Loadout", id)
			end)
		end
	end
	local voting = currentPhase == "Waiting" or currentPhase == "Intermission"
	if not voting then
		myVote = nil
	end
	ui.setVotes(mapOptions(), myVote, voting)
	for id, voteButton in ui.VoteButtons do
		if not voteConnections[id] then
			voteConnections[id] = true
			voteButton.Activated:Connect(function()
				myVote = id
				action("Vote", id)
				refreshLobby()
			end)
		end
	end
end

local function teamEntries()
	local entries = {}
	if phase() ~= "Active" then
		return entries
	end
	local now = serverNow()
	local list = {}
	for _, player in Players:GetPlayers() do
		if str(player, "Role", "Lobby") == "Survivor" then
			table.insert(list, player)
		end
	end
	table.sort(list, function(a, b)
		return a.DisplayName < b.DisplayName
	end)
	for _, player in list do
		local status = str(player, "Status", "Healthy")
		local detail = str(player, "Rank", "LTN") .. " · " .. status
		local timer: number? = nil
		if status == "Caged" then
			local remaining = num(player, "CagedUntil", 0) - now
			local total = Rules.cageSeconds(num(player, "CageCount", 1)) or 1
			detail = string.format("Caged · %ds · cage %d/3", math.max(0, math.ceil(remaining)), num(player, "CageCount", 1))
			timer = remaining / total
		elseif status == "Downed" then
			detail = string.format("DOWNED · %ds", math.max(0, math.ceil(num(player, "RecoverAt", 0) - now)))
		elseif player:GetAttribute("Hidden") == true and player == localPlayer then
			detail ..= " · hiding"
		end
		table.insert(entries, {
			Name = player.DisplayName .. (if player == localPlayer then " (you)" else ""),
			Detail = detail,
			Color = Hud.StatusColors[status] or colors.Muted,
			Timer = timer,
		})
	end
	return entries
end

local function updateHUD()
	local currentPhase = phase()
	local role = myRole()
	local status = myStatus()
	local now = serverNow()
	local seconds = num(matchState, "TimeRemaining", 0)
	ui.Timer.Text = if currentPhase == "Waiting" then "--:--" else formatTime(seconds)
	ui.Timer.TextColor3 = if currentPhase == "Active" and seconds <= 30 then colors.Danger else colors.Text
	local points = num(localPlayer, "BP", 0)
	local rank = str(localPlayer, "Rank", Rules.rankForBP(points))
	local roleText = if role == "Killer" then "OG CHAD" elseif role == "Survivor" then "SURVIVOR" else "LOBBY"
	ui.Role.Text = roleText .. (if role ~= "Lobby" then " · " .. string.upper(status) else "  ·  " .. string.upper(str(matchState, "MapName", "")))
	ui.Role.TextColor3 = if role == "Killer" then colors.Killer elseif role == "Survivor" then (Hud.StatusColors[status] or colors.Survivor) else colors.Muted
	ui.Message.Text = str(matchState, "Message", "Waiting for more players...")

	local completed = num(matchState, "ObjectiveCount", 0)
	local goal = num(matchState, "ObjectiveGoal", 0)
	local powered = matchState:GetAttribute("ExitPowered") == true
	if currentPhase == "Active" and goal > 0 then
		ui.Objective.Text = string.format("TERMINALS %d/%d  ·  %s", completed, goal, if powered then "EXIT POWERED!" else "exit locked")
		ui.Objective.TextColor3 = if powered then colors.Good else colors.Muted
	elseif currentPhase == "Intermission" then
		ui.Objective.Text = "Next round soon · vote for a map"
		ui.Objective.TextColor3 = colors.Muted
	elseif currentPhase == "Results" then
		ui.Objective.Text = "Round over"
		ui.Objective.TextColor3 = colors.Muted
	else
		ui.Objective.Text = "Waiting for 2+ players"
		ui.Objective.TextColor3 = colors.Muted
	end
	ui.ProgressFill.Size = UDim2.fromScale(if goal > 0 then math.clamp(completed / goal, 0, 1) else 0, 1)
	ui.ProgressFill.BackgroundColor3 = if powered then colors.Good else colors.Survivor

	if role == "Survivor" then
		ui.Rank.Text = string.format("%s  ·  %d BP", string.upper(rank), points)
		ui.Rank.TextColor3 = if rank == "Chad" then colors.Chad else colors.Survivor
		local upcoming = Rules.nextRank(points)
		ui.NextRank.Text = if upcoming then string.format("%d BP until %s. Terminals +%d · revives +%d · rescues +%d.", math.max(0, upcoming.BP - points), upcoming.Name, Config.BPPerObjective, Config.BPPerRevive, Config.BPPerRescue)
			else "CHAD ACHIEVED · Escape through a powered exit gate."
	elseif role == "Killer" then
		local carrying = num(localPlayer, "Carrying", 0) ~= 0
		ui.Rank.Text = if carrying then "CARRYING · take them to a Mog Cage" else string.format("%d survivors left", num(matchState, "SurvivorsLeft", 0))
		ui.Rank.TextColor3 = colors.Killer
		ui.NextRank.Text = "Terminal pings show where survivors are working. Scratch marks show who sprinted."
	else
		ui.Rank.Text = string.format("LEVEL %d  ·  %s", num(localPlayer, "Level", 1), str(localPlayer, "Title", ""))
		ui.Rank.TextColor3 = colors.Chad
		ui.NextRank.Text = "Fictional ranks. Very real cardio."
	end

	if status == "Caged" then
		ui.Help.Text = "CAGED · A teammate can free you at the cage panel. You can try to STRUGGLE free a few times. If the timer runs out you're eliminated; a third cage eliminates you instantly."
	elseif status == "Carried" then
		ui.Help.Text = "CARRIED · Mash SPACE (or the WIGGLE button) to break free. Teammates can blind the OG Chad with a Jawline Flash."
	elseif status == "Downed" then
		ui.Help.Text = "DOWNED · Crawl to safety. A teammate can revive you (hold E), or you'll pick yourself up when the timer ends."
	elseif status == "Escaped" or status == "Eliminated" or status == "Spectating" then
		ui.Help.Text = "You're out of this round. Use the < > buttons to spectate the remaining players."
	elseif role == "Killer" and currentPhase == "Active" then
		ui.Help.Text = "CLICK attack (2 hits = downed) · Q Gym Charge · F Mog Aura (reveal)\nE pick up downed survivors and lock them in Mog Cages · E search lockers\nSPACE vault windows (slowly). You can't jump high."
	elseif role == "Survivor" and currentPhase == "Active" then
		ui.Help.Text = "E calibrate cyan terminals (+BP) · SHIFT sprint · C slide · Q ability\nSPACE vault windows · E hide in lockers · E revive/heal/free teammates\nReach Chad (100 BP), then escape through a powered exit gate."
	else
		ui.Help.Text = "One player becomes the OG Chad. Everyone else starts LTN.\nCalibrate terminals, climb the ranks and escape together.\nPick your ability and vote for a map in the Loadout panel."
	end

	-- Status panel
	local showStatus = true
	local statusLine = ""
	local statusColor = colors.Text
	local barFraction = movement.Stamina / Config.StaminaMax
	local barLabel = if movement.Exhausted then "EXHAUSTED" else "STAMINA"
	local barColor = if movement.Exhausted then colors.Danger else colors.Survivor
	local actionText: string? = nil
	if role == "Killer" and currentPhase == "Active" then
		local stunned = now < num(localPlayer, "StunnedUntil", 0)
		local carrying = num(localPlayer, "Carrying", 0) ~= 0
		statusLine = if stunned then "STUNNED!" elseif carrying then "CARRYING · find a Mog Cage" elseif now < num(localPlayer, "ChargeUntil", 0) then "CHARGING" else "HUNTING"
		statusColor = colors.Killer
		local attackRemaining = math.max(0, num(localPlayer, "AttackReadyAt", 0) - now)
		barFraction = 1 - math.clamp(attackRemaining / Config.AttackHitCooldown, 0, 1)
		barLabel = if attackRemaining > 0 then "RECOVERING" else "ATTACK READY"
		barColor = colors.Killer
	elseif localPlayer:GetAttribute("Hidden") == true then
		statusLine = "HIDING IN A LOCKER · E to leave"
		statusColor = colors.Survivor
	elseif status == "Downed" then
		statusLine = string.format("DOWNED · getting up in %ds", math.max(0, math.ceil(num(localPlayer, "RecoverAt", 0) - now)))
		statusColor = colors.Danger
		barFraction = 0
		barLabel = "WAIT FOR A REVIVE"
		barColor = colors.Danger
	elseif status == "Carried" then
		statusLine = "CARRIED! MASH SPACE"
		statusColor = colors.Danger
		barFraction = num(localPlayer, "WiggleProgress", 0)
		barLabel = "WIGGLE"
		barColor = colors.Warn
		actionText = "WIGGLE!"
	elseif status == "Caged" then
		local left = num(localPlayer, "EscapeAttemptsLeft", 0)
		statusLine = string.format("CAGED · %ds left", math.max(0, math.ceil(num(localPlayer, "CagedUntil", 0) - now)))
		statusColor = colors.Caged
		actionText = if left > 0 then string.format("STRUGGLE (%d)", left) else nil
	elseif role == "Survivor" and currentPhase == "Active" then
		statusLine = if status == "Injured" then "INJURED · find a teammate to heal you" else "HEALTHY"
		statusColor = Hud.StatusColors[status] or colors.Text
		if now < num(localPlayer, "BoostUntil", 0) then
			statusLine ..= " · SPEED BOOST"
		end
	elseif status == "Escaped" or status == "Eliminated" or status == "Spectating" then
		showStatus = false
	else
		statusLine = "LOBBY · try sprinting and sliding"
		statusColor = colors.Muted
	end
	ui.Status.Visible = showStatus and not ui.Results.Visible
	ui.StatusText.Text = statusLine
	ui.StatusText.TextColor3 = statusColor
	ui.StaminaFill.Size = UDim2.fromScale(math.clamp(barFraction, 0, 1), 1)
	ui.StaminaFill.BackgroundColor3 = barColor
	ui.StaminaLabel.Text = barLabel
	ui.ActionButton.Visible = actionText ~= nil
	ui.ActionButton.Text = actionText or ""
	ui.StaminaTrack.Visible = actionText == nil or status == "Carried"
	ui.StaminaLabel.Visible = actionText == nil

	ui.setTeam(teamEntries())
	ui.AbilityBar.Visible = not ui.Results.Visible and status ~= "Escaped" and status ~= "Eliminated" and status ~= "Spectating"
	rebuildAbilityBar()
	refreshLobby()
	evaluateAllPrompts()
end

-- Frame loop ------------------------------------------------------------------------------

local slowClock = 0
connect(RunService.RenderStepped, function(dt: number)
	movement:update(dt)
	updateCamera()
end)

connect(RunService.Heartbeat, function(dt: number)
	local currentPhase = phase()
	local intensity = Effects.updateChase(dt, currentPhase)
	ui.DangerStroke.Transparency = 1 - intensity * 0.7
	ui.ChaseWarning.Visible = intensity > 0.12 and not ui.Results.Visible
	local status = myStatus()
	-- Downed/carried survivors see a pulsing red vignette.
	if status == "Downed" or status == "Carried" then
		ui.Vignette.BackgroundTransparency = 0.78 + math.sin(os.clock() * 4) * 0.06
	elseif ui.Vignette.BackgroundTransparency > 0.7 and ui.Vignette.BackgroundTransparency < 0.95 then
		ui.Vignette.BackgroundTransparency = 1
	end
	-- Inside a smoke cloud the screen fogs over.
	local inSmoke = false
	local root = Effects.rootOf(localPlayer)
	local map = Workspace:FindFirstChild("ActiveMap")
	if root and map then
		for _, child in map:GetChildren() do
			if child.Name == "SmokeCloud" and child:IsA("BasePart") and (child.Position - root.Position).Magnitude < child.Size.X / 2 then
				inSmoke = true
				break
			end
		end
	end
	ui.Smoke.BackgroundTransparency = if inSmoke then 0.25 else 1
	if myRole() == "Killer" and currentPhase == "Active" then
		Effects.updateScratches(dt)
	end
	updateCooldowns()
	slowClock += dt
	if slowClock >= 0.2 then
		slowClock = 0
		updateHUD()
	end
end)

-- Wiring ----------------------------------------------------------------------------------

local viewportConnection: RBXScriptConnection? = nil
local function resize()
	local camera = Workspace.CurrentCamera
	if camera then
		ui.resize(camera.ViewportSize)
	end
end

local function trackCamera()
	if viewportConnection then
		viewportConnection:Disconnect()
		viewportConnection = nil
	end
	local camera = Workspace.CurrentCamera
	if camera then
		viewportConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(resize)
	end
	resize()
end

local lastPhase = phase()
connect(Workspace:GetPropertyChangedSignal("CurrentCamera"), trackCamera)
connect(matchState.AttributeChanged, function(name: string)
	if name == "Phase" then
		local current = phase()
		if current ~= lastPhase then
			lastPhase = current
			if current == "Intermission" then
				toast("Next round starting soon. Vote for a map!", "info")
			end
			movement.SprintToggled = false
		end
	end
	updateHUD()
end)
connect(localPlayer.AttributeChanged, function()
	updateHUD()
end)
connect(Players.PlayerAdded, trackPlayer)
connect(Players.PlayerRemoving, untrackPlayer)
for _, player in Players:GetPlayers() do
	trackPlayer(player)
end
trackCamera()
updateHUD()

script.Destroying:Connect(function()
	destroyed = true
	for _, connection in connections do
		connection:Disconnect()
	end
	for _, connection in prompts do
		connection:Disconnect()
	end
	if viewportConnection then
		viewportConnection:Disconnect()
	end
	for player in playerViews do
		untrackPlayer(player)
	end
	Effects.destroy()
	ui.Screen:Destroy()
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Movement</string>
            <string name="Source"><![CDATA[--!strict
-- Local movement controller: stamina sprint, slide, window vaults and dashes.
-- The server sets state attributes (Status, SlowUntil, BoostUntil, ChargeUntil,
-- StunnedUntil, Carrying); this module turns them into WalkSpeed each frame.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Movement = {}
Movement.__index = Movement

export type Controller = typeof(setmetatable({} :: {
	Player: Player,
	Stamina: number,
	Exhausted: boolean,
	SprintHeld: boolean,
	SprintToggled: boolean,
	Sprinting: boolean,
	SlideUntil: number,
	NextSlideAt: number,
	LastDrainAt: number,
	Vaulting: boolean,
	Dashing: boolean,
	Speed: number,
}, Movement))

local function attributeNumber(instance: Instance, name: string): number
	local value = instance:GetAttribute(name)
	return if type(value) == "number" then value else 0
end

local function attributeString(instance: Instance, name: string): string
	local value = instance:GetAttribute(name)
	return if type(value) == "string" then value else ""
end

function Movement.new(player: Player): Controller
	local self = setmetatable({
		Player = player,
		Stamina = Config.StaminaMax,
		Exhausted = false,
		SprintHeld = false,
		SprintToggled = false,
		Sprinting = false,
		SlideUntil = 0,
		NextSlideAt = 0,
		LastDrainAt = 0,
		Vaulting = false,
		Dashing = false,
		Speed = Config.WalkSpeed,
	}, Movement)
	return self
end

function Movement.character(self: Controller): (Humanoid?, BasePart?)
	local character = self.Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and humanoid.Health > 0 and root and root:IsA("BasePart") then
		return humanoid, root
	end
	return nil, nil
end

function Movement.isKiller(self: Controller): boolean
	return attributeString(self.Player, "Role") == "Killer"
end

-- Survivors (or lobby players) who can move freely under their own power.
function Movement.canMove(self: Controller): boolean
	local status = attributeString(self.Player, "Status")
	if self.Player:GetAttribute("Hidden") == true then
		return false
	end
	return status ~= "Downed" and status ~= "Carried" and status ~= "Caged"
end

function Movement.wantsSprint(self: Controller): boolean
	return self.SprintHeld or self.SprintToggled
end

function Movement.refill(self: Controller)
	self.Stamina = Config.StaminaMax
	self.Exhausted = false
end

function Movement.update(self: Controller, dt: number)
	local humanoid, root = self:character()
	if not humanoid or not root then
		return
	end
	local now = Workspace:GetServerTimeNow()
	local clock = os.clock()
	local player = self.Player
	local status = attributeString(player, "Status")
	local moving = humanoid.MoveDirection.Magnitude > 0.1
	local speed: number

	if self:isKiller() then
		self.Sprinting = false
		if now < attributeNumber(player, "StunnedUntil") then
			speed = 0
		elseif now < attributeNumber(player, "ChargeUntil") then
			speed = Config.KillerChargeSpeed
		elseif now < attributeNumber(player, "SlowUntil") then
			speed = Config.AttackSlowSpeed
		else
			speed = Config.KillerWalkSpeed
		end
		if attributeNumber(player, "Carrying") ~= 0 then
			speed *= 0.9
		end
		humanoid.JumpHeight = Config.KillerJumpHeight
	elseif not self:canMove() then
		self.Sprinting = false
		speed = if status == "Downed" and player:GetAttribute("Hidden") ~= true then Config.DownedSpeed else 0
		humanoid.JumpHeight = 0
		-- Downed survivors lie on the floor; keep the camera down with them.
		humanoid.CameraOffset = humanoid.CameraOffset:Lerp(
			if status == "Downed" then Vector3.new(0, -2, 0) else Vector3.zero,
			math.clamp(dt * 8, 0, 1)
		)
	else
		local canSprint = self:wantsSprint() and moving and not self.Exhausted and self.Stamina > 0
		self.Sprinting = canSprint
		speed = Config.WalkSpeed
		if canSprint then
			speed = Config.SprintSpeed
			self.Stamina = math.max(0, self.Stamina - Config.StaminaDrain * dt)
			self.LastDrainAt = clock
			if self.Stamina <= 0 then
				self.Exhausted = true
			end
		elseif clock - self.LastDrainAt >= Config.StaminaRegenDelay then
			self.Stamina = math.min(Config.StaminaMax, self.Stamina + Config.StaminaRegen * dt)
			if self.Exhausted and self.Stamina >= Config.StaminaExhaustedThreshold then
				self.Exhausted = false
			end
		end
		if clock < self.SlideUntil then
			local remaining = (self.SlideUntil - clock) / Config.SlideSeconds
			speed = math.max(speed, Config.WalkSpeed + (Config.SlideSpeed - Config.WalkSpeed) * remaining)
		end
		if now < attributeNumber(player, "BoostUntil") then
			speed = math.max(speed, Config.InjuredBoostSpeed)
		end
		if now < attributeNumber(player, "SlowUntil") then
			speed = math.min(speed, Config.AttackSlowSpeed)
		end
		humanoid.JumpHeight = Config.SurvivorJumpHeight
		humanoid.CameraOffset = humanoid.CameraOffset:Lerp(
			if clock < self.SlideUntil then Vector3.new(0, -1.6, 0) else Vector3.zero,
			math.clamp(dt * 12, 0, 1)
		)
	end
	self.Speed = speed
	humanoid.UseJumpPower = false
	humanoid.WalkSpeed = speed
end

-- C: a quick slide while sprinting. Costs stamina; lowers the camera.
function Movement.slide(self: Controller): boolean
	local humanoid = self:character()
	local clock = os.clock()
	if not humanoid or self:isKiller() or not self:canMove() or self.Vaulting then
		return false
	end
	if clock < self.NextSlideAt or self.Stamina < Config.SlideStaminaCost or humanoid.MoveDirection.Magnitude < 0.1 then
		return false
	end
	self.Stamina -= Config.SlideStaminaCost
	self.LastDrainAt = clock
	self.SlideUntil = clock + Config.SlideSeconds
	self.NextSlideAt = clock + Config.SlideCooldown
	return true
end

-- Finds a window sill the character is facing and close to.
function Movement.findVault(self: Controller): (BasePart?, Vector3?, Vector3?)
	local _, root = self:character()
	local map = Workspace:FindFirstChild("ActiveMap")
	if not root or not map then
		return nil, nil, nil
	end
	local look = root.CFrame.LookVector
	for _, sill in map:GetChildren() do
		if sill:IsA("BasePart") and sill.Name == "VaultSill" then
			local axis = sill:GetAttribute("VaultAxis")
			local offset = root.Position - sill.Position
			local along = if axis == "X" then offset.X else offset.Z
			local across = if axis == "X" then offset.Z else offset.X
			local length = if axis == "X" then sill.Size.X else sill.Size.Z
			local normal = if axis == "X" then Vector3.new(0, 0, 1) else Vector3.new(1, 0, 0)
			if math.abs(along) <= length / 2 - 0.5 and math.abs(across) <= Config.VaultRange and math.abs(across) > 0.3 then
				-- Direction across the sill, from our side to the far side.
				local direction = normal * (if across > 0 then -1 else 1)
				if look:Dot(direction) > 0.35 then
					local start = root.Position
					local landing = Vector3.new(start.X, start.Y, start.Z) + direction * (math.abs(across) + 3.2)
					return sill, start, landing
				end
			end
		end
	end
	return nil, nil, nil
end

-- Space/jump near a window performs a smooth vault. Returns true if it vaulted.
function Movement.tryVault(self: Controller): boolean
	if self.Vaulting or self.Dashing then
		return false
	end
	local humanoid, root = self:character()
	local status = attributeString(self.Player, "Status")
	if not humanoid or not root then
		return false
	end
	if not self:isKiller() and not self:canMove() then
		return false
	end
	if self:isKiller() and (attributeNumber(self.Player, "Carrying") ~= 0 or Workspace:GetServerTimeNow() < attributeNumber(self.Player, "StunnedUntil")) then
		return false
	end
	if status == "Lobby" or status == "Escaped" or status == "Eliminated" or status == "Spectating" then
		return false
	end
	local sill, start, landing = self:findVault()
	if not sill or not start or not landing then
		return false
	end
	local duration = if self:isKiller() then Config.KillerVaultSeconds else Config.SurvivorVaultSeconds
	local peak = sill.Position.Y + sill.Size.Y / 2 + 3.3
	local facing = (landing - start) * Vector3.new(1, 0, 1)
	local rotation = if facing.Magnitude > 0.01 then CFrame.lookAt(Vector3.zero, facing.Unit) else root.CFrame.Rotation
	self.Vaulting = true
	humanoid.PlatformStand = true
	local began = os.clock()
	local connection: RBXScriptConnection? = nil
	connection = RunService.Heartbeat:Connect(function()
		local alpha = math.clamp((os.clock() - began) / duration, 0, 1)
		local _, currentRoot = self:character()
		if not currentRoot or currentRoot ~= root then
			alpha = 1
		end
		local flat = start:Lerp(landing, alpha)
		local arc = math.sin(alpha * math.pi)
		local height = start.Y + (math.max(peak, start.Y) - start.Y) * arc
		if currentRoot == root then
			root.CFrame = CFrame.new(flat.X, height, flat.Z) * rotation
			root.AssemblyLinearVelocity = Vector3.zero
		end
		if alpha >= 1 then
			if connection then
				connection:Disconnect()
			end
			humanoid.PlatformStand = false
			self.Vaulting = false
		end
	end)
	return true
end

-- Server-approved dash: a short, strong horizontal push.
function Movement.dash(self: Controller, duration: number)
	local humanoid, root = self:character()
	if not humanoid or not root or self.Vaulting then
		return
	end
	local direction = humanoid.MoveDirection
	if direction.Magnitude < 0.1 then
		direction = root.CFrame.LookVector
	end
	direction = Vector3.new(direction.X, 0, direction.Z)
	if direction.Magnitude < 0.01 then
		return
	end
	direction = direction.Unit
	local attachment = Instance.new("Attachment")
	attachment.Name = "DashAttachment"
	attachment.Parent = root
	local velocity = Instance.new("LinearVelocity")
	velocity.Name = "Dash"
	velocity.Attachment0 = attachment
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	velocity.PrimaryTangentAxis = Vector3.new(1, 0, 0)
	velocity.SecondaryTangentAxis = Vector3.new(0, 0, 1)
	velocity.PlaneVelocity = Vector2.new(direction.X, direction.Z) * Config.DashSpeed
	velocity.MaxForce = 1e6
	velocity.Parent = root
	self.Dashing = true
	task.delay(duration, function()
		velocity:Destroy()
		attachment:Destroy()
		self.Dashing = false
	end)
end

return Movement
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Poses</string>
            <string name="Source"><![CDATA[--!strict
-- Procedural poses without animation assets. Every client poses every
-- character locally by overriding Motor6D.Transform after the Animator runs
-- (RunService.PreSimulation), so nothing here needs replication.
--
--   Downed   lies face down, arms pulling along the floor (legs keep the walk cycle)
--   Carried  limp over the OG Chad's shoulder, arms dangling
--   Caged    slumped forward, arms hanging
--   Injured  hunched forward, clutching one arm
--   Killer   overhead chop on attack; one arm braced while carrying
--
-- R15 only (the Roblox default). R6 characters are left to their animations.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Poses = {}

type Rig = {
	Character: Model,
	Root: Motor6D?,
	Waist: Motor6D?,
	Neck: Motor6D?,
	RightShoulder: Motor6D?,
	LeftShoulder: Motor6D?,
}

local rigs: { [Player]: Rig | false } = {}
local swingStarted: { [Player]: number } = {}
local lastPosed: { [Motor6D]: boolean } = {}
local posed: { [Motor6D]: boolean } = {}
local SWING_SECONDS = 0.35

local function motor(character: Model, partName: string, jointName: string): Motor6D?
	local part = character:FindFirstChild(partName)
	local joint = part and part:FindFirstChild(jointName)
	return if joint and joint:IsA("Motor6D") then joint else nil
end

local function rigFor(player: Player): Rig?
	local character = player.Character
	if not character then
		rigs[player] = nil
		return nil
	end
	local rig = rigs[player]
	if rig ~= nil and (rig == false or rig.Character == character) then
		-- Re-check a non-R15 result only when the character changes.
		if rig == false then
			return nil
		end
		return rig
	end
	if not character:FindFirstChild("UpperTorso") then
		-- Body parts may still be streaming in; try again next frame.
		return nil
	end
	local created: Rig = {
		Character = character,
		Root = motor(character, "LowerTorso", "Root"),
		Waist = motor(character, "UpperTorso", "Waist"),
		Neck = motor(character, "Head", "Neck"),
		RightShoulder = motor(character, "RightUpperArm", "RightShoulder"),
		LeftShoulder = motor(character, "LeftUpperArm", "LeftShoulder"),
	}
	rigs[player] = created
	character.AncestryChanged:Once(function()
		if rigs[player] == created then
			rigs[player] = nil
		end
	end)
	return created
end

-- Sets an absolute Transform for this frame. R15 joints share orientation with
-- the body: +X rotation swings a hanging arm forward/up; -X pitches the torso forward.
local function set(joint: Motor6D?, transform: CFrame)
	if joint and joint.Parent then
		joint.Transform = transform
		posed[joint] = true
	end
end

local function lean(radians: number): CFrame
	return CFrame.Angles(-radians, 0, 0)
end

local function raise(radians: number): CFrame
	return CFrame.Angles(radians, 0, 0)
end

function Poses.swing(player: Player)
	swingStarted[player] = os.clock()
end

local function poseSurvivor(rig: Rig, state: string, clock: number)
	if state == "Downed" then
		local reach = math.sin(clock * 5) * 0.3
		set(rig.Root, CFrame.new(0, -1.6, 0) * lean(math.rad(80)))
		set(rig.Neck, lean(math.rad(-40)))
		set(rig.RightShoulder, raise(math.rad(150) + reach))
		set(rig.LeftShoulder, raise(math.rad(150) - reach))
	elseif state == "Carried" then
		local sway = math.sin(clock * 3) * 0.15
		set(rig.Waist, lean(math.rad(25)))
		set(rig.Neck, lean(math.rad(30)))
		set(rig.RightShoulder, raise(math.rad(-15) + sway))
		set(rig.LeftShoulder, raise(math.rad(-15) - sway))
	elseif state == "Caged" then
		set(rig.Waist, lean(math.rad(28)))
		set(rig.Neck, lean(math.rad(25)))
		set(rig.RightShoulder, raise(math.rad(20)))
		set(rig.LeftShoulder, raise(math.rad(20)))
	elseif state == "Injured" then
		set(rig.Waist, lean(math.rad(14)))
		set(rig.LeftShoulder, raise(math.rad(40)) * CFrame.Angles(0, 0, math.rad(-25)))
	end
end

local function poseKiller(player: Player, rig: Rig, clock: number)
	local carrying = player:GetAttribute("Carrying")
	if type(carrying) == "number" and carrying ~= 0 then
		set(rig.LeftShoulder, raise(math.rad(165)))
	end
	local started = swingStarted[player]
	if not started then
		return
	end
	local alpha = (clock - started) / SWING_SECONDS
	if alpha >= 1 or alpha < 0 then
		swingStarted[player] = nil
		return
	end
	-- Wind up overhead for the first 30%, then chop down and across.
	local angle = if alpha < 0.3 then math.rad(170) else math.rad(170 - 160 * ((alpha - 0.3) / 0.7))
	set(rig.RightShoulder, raise(angle) * CFrame.Angles(0, 0, math.rad(-20 * alpha)))
	set(rig.Waist, lean(math.rad(18 * alpha)))
end

local function update()
	table.clear(posed)
	local clock = os.clock()
	for _, player in Players:GetPlayers() do
		local rig = rigFor(player)
		if rig then
			local role = player:GetAttribute("Role")
			local state = player:GetAttribute("Status")
			if role == "Survivor" and type(state) == "string" and player:GetAttribute("Hidden") ~= true then
				poseSurvivor(rig, state, clock)
			elseif role == "Killer" then
				poseKiller(player, rig, clock)
			end
		end
	end
	-- Joints posed last frame but not this one go back to neutral once. The
	-- Animator overwrites animated joints anyway, but rarely writes Root.
	for joint in lastPosed do
		if not posed[joint] and joint.Parent then
			joint.Transform = CFrame.identity
		end
	end
	lastPosed, posed = posed, lastPosed
end

function Poses.start(): { RBXScriptConnection }
	return {
		RunService.PreSimulation:Connect(update),
		Players.PlayerRemoving:Connect(function(player)
			rigs[player] = nil
			swingStarted[player] = nil
		end),
	}
end

return Poses
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="25">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="FilteringEnabled">true</bool>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>