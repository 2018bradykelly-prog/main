      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Abilities</string>
          <string name="Source"><![CDATA[--!strict
-- Ability catalogue shared by the server (validation, cooldowns) and the client
-- (buttons, descriptions). Survivors pick one loadout ability in the lobby.
-- The killer always has the full killer kit.

export type Ability = {
	Id: string,
	Name: string,
	Role: "Survivor" | "Killer",
	Key: string,
	Cooldown: number,
	Duration: number,
	Color: Color3?,
	Description: string,
}

local function define(ability: Ability): Ability
	return table.freeze(ability)
end

-- Plain Lune tests have no Color3; Studio always does.
local color3: any = (getfenv() :: any).Color3
local function rgb(r: number, g: number, b: number): Color3?
	return if color3 then color3.fromRGB(r, g, b) else nil
end

local Abilities = {}

Abilities.Survivor = table.freeze({
	define({
		Id = "Dash", Name = "Mog Dash", Role = "Survivor", Key = "Q",
		Cooldown = 18, Duration = 0.3, Color = rgb(124, 212, 202),
		Description = "Burst forward a short distance. Great for breaking line of sight.",
	}),
	define({
		Id = "Smoke", Name = "Fog Machine", Role = "Survivor", Key = "Q",
		Cooldown = 35, Duration = 7, Color = rgb(170, 178, 196),
		Description = "Drop a thick smoke cloud. OG Chad cannot hit or see through it.",
	}),
	define({
		Id = "Flash", Name = "Jawline Flash", Role = "Survivor", Key = "Q",
		Cooldown = 40, Duration = 2.2, Color = rgb(255, 236, 140),
		Description = "Blind and stun OG Chad if they are close and facing you. Also frees a carried teammate.",
	}),
	define({
		Id = "Shake", Name = "Protein Shake", Role = "Survivor", Key = "Q",
		Cooldown = 45, Duration = 4, Color = rgb(196, 140, 255),
		Description = "Heal yourself when injured. When healthy, refills stamina and gives a speed boost.",
	}),
})

Abilities.Killer = table.freeze({
	define({
		Id = "Charge", Name = "Gym Charge", Role = "Killer", Key = "Q",
		Cooldown = 20, Duration = 2.2, Color = rgb(255, 137, 87),
		Description = "Sprint at full speed for a couple of seconds.",
	}),
	define({
		Id = "Reveal", Name = "Mog Aura", Role = "Killer", Key = "F",
		Cooldown = 45, Duration = 4.5, Color = rgb(241, 79, 79),
		Description = "Reveal every survivor who is not hiding in a locker.",
	}),
})

Abilities.DefaultSurvivor = "Dash"

local byId: { [string]: Ability } = {}
for _, list in { Abilities.Survivor, Abilities.Killer } do
	for _, ability in list do
		byId[ability.Id] = ability
	end
end

function Abilities.get(id: any): Ability?
	if type(id) ~= "string" then
		return nil
	end
	return byId[id]
end

function Abilities.isSurvivorAbility(id: any): boolean
	local ability = Abilities.get(id)
	return ability ~= nil and ability.Role == "Survivor"
end

return table.freeze(Abilities)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- Shared gameplay tuning. BP is an entirely fictional, round-local score.
-- Upload assets/audio/chase-placeholder.wav to Roblox, grant this experience
-- access, then set ChaseSoundId to "rbxassetid://YOUR_AUDIO_ASSET_ID".
local Config = {
	MinPlayers = 2,
	IntermissionSeconds = 15,
	RoundSeconds = 300,
	ResultsSeconds = 12,
	-- Once the exit powers up the remaining time collapses to at most this.
	EndgameSeconds = 90,

	-- BP and ranks (per round, reset every round).
	BPPerObjective = 25,
	BPPerRevive = 15,
	BPPerRescue = 20,
	BPPerHeal = 10,
	MaxBP = 100,
	Ranks = {
		table.freeze({ Name = "LTN", BP = 0 }),
		table.freeze({ Name = "MTN", BP = 25 }),
		table.freeze({ Name = "HTN", BP = 50 }),
		table.freeze({ Name = "Chadlite", BP = 75 }),
		table.freeze({ Name = "Chad", BP = 100 }),
	},

	-- Interactions (hold durations in seconds).
	ObjectiveHoldSeconds = 2.5,
	ObjectiveCooldownSeconds = 6,
	TerminalOverheatSeconds = 9,
	TerminalPingSeconds = 4,
	EscapeHoldSeconds = 1,
	RescueHoldSeconds = 2,
	ReviveHoldSeconds = 3,
	HealHoldSeconds = 4,
	PickupHoldSeconds = 0.6,
	InteractionDistance = 12,

	-- Movement. The client applies these; the server sets the state attributes.
	WalkSpeed = 14,
	SprintSpeed = 24,
	SlideSpeed = 32,
	SlideSeconds = 0.7,
	SlideStaminaCost = 22,
	SlideCooldown = 1.6,
	DashSpeed = 58,
	InjuredBoostSpeed = 26,
	InjuredBoostSeconds = 2.5,
	DownedSpeed = 3.5,
	KillerWalkSpeed = 18,
	KillerChargeSpeed = 32,
	KillerJumpHeight = 1.5,
	SurvivorJumpHeight = 6,
	StaminaMax = 100,
	StaminaDrain = 24,
	StaminaRegen = 16,
	StaminaRegenDelay = 0.9,
	StaminaExhaustedThreshold = 35,
	VaultRange = 5,
	SurvivorVaultSeconds = 0.45,
	KillerVaultSeconds = 1.1,
	ScratchMarkSpeed = 19,

	-- Killer combat.
	AttackRange = 7.5,
	AttackConeDot = 0.35,
	AttackHitCooldown = 2.6,
	AttackMissCooldown = 1.4,
	AttackHitSlowSeconds = 2,
	AttackMissSlowSeconds = 0.8,
	AttackSlowSpeed = 9,
	StunSeconds = 2.2,

	-- Survivor health states.
	DownedRecoverSeconds = 45,
	CarryMaxSeconds = 18,
	WiggleGoal = 26,
	WiggleMaxPerSecond = 9,
	CageSeconds = { 40, 22 }, -- third cage eliminates immediately
	CageEscapeAttempts = 3,
	CageEscapeChance = 0.12,
	CaptureGraceSeconds = 5,

	-- Lockers.
	LockerCooldownSeconds = 1.5,

	-- Round results: survivors win if at least this fraction escapes.
	SurvivorWinFraction = 0.5,

	-- Chase presentation.
	ChaseSoundId = "",
	ChaseRadius = 65,
	ChaseFullVolumeRadius = 18,
	ChaseMaxVolume = 0.65,

	-- Persistence. Studio without API access falls back to memory only.
	DataStoreName = "EscapeTheChad_Profiles_v1",
	LeaderboardStoreName = "EscapeTheChad_Wins_v1",
	AutosaveSeconds = 120,
	LeaderboardRefreshSeconds = 90,
}

table.freeze(Config.Ranks)
table.freeze(Config.CageSeconds)
return table.freeze(Config)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Maps</string>
          <string name="Source"><![CDATA[--!strict
-- Map definitions as plain data. World.build turns a definition into parts.
-- Coordinates are studs on the XZ plane; every arena is centred on the origin.
--
-- Rules every map must satisfy (enforced by tests/world.spec.luau):
--   * every terminal, exit, rescue panel and locker is reachable WITHOUT
--     vaulting (windows are shortcuts, never the only route);
--   * cages are sealed;
--   * spawns are clear of geometry.

export type Rect = { X: number, Z: number, W: number, D: number, H: number? }
export type Window = { X: number, Z: number, Length: number, Axis: "X" | "Z" }
export type Point = { X: number, Z: number, Face: string? }

export type Definition = {
	Id: string,
	Name: string,
	Blurb: string,
	Half: number,
	Theme: {
		Floor: Color3,
		Wall: Color3,
		Prop: Color3,
		Lamp: Color3,
		Ambient: Color3,
		Fog: Color3,
		FogEnd: number,
		FloorMaterial: Enum.Material,
		WallMaterial: Enum.Material,
	},
	Walls: { Rect },
	Windows: { Window },
	Props: { Rect },
	Terminals: { Point },
	Lockers: { Point },
	Cages: { Point },
	Exits: { Point },
	Lamps: { Point },
	SurvivorSpawns: { Point },
	KillerSpawn: Point,
}

export type Opening = { At: number, Width: number, Kind: "Door" | "Window" }

local Maps = {}

local THICK = 2

-- Builds an axis-aligned wall from `from` to `to` with doors and windows cut
-- into it. axis "X" runs along X at z = fixed; axis "Z" runs along Z at x = fixed.
function Maps.wall(def: Definition, axis: "X" | "Z", fixed: number, from: number, to: number, openings: { Opening }?)
	local cuts = table.clone(openings or {})
	table.sort(cuts, function(a, b)
		return a.At < b.At
	end)
	local cursor = from
	local function segment(a: number, b: number)
		if b - a < 0.5 then
			return
		end
		local mid = (a + b) / 2
		if axis == "X" then
			table.insert(def.Walls, { X = mid, Z = fixed, W = b - a, D = THICK })
		else
			table.insert(def.Walls, { X = fixed, Z = mid, W = THICK, D = b - a })
		end
	end
	for _, cut in cuts do
		local a, b = cut.At - cut.Width / 2, cut.At + cut.Width / 2
		segment(cursor, a)
		if cut.Kind == "Window" then
			if axis == "X" then
				table.insert(def.Windows, { X = cut.At, Z = fixed, Length = cut.Width, Axis = "X" })
			else
				table.insert(def.Windows, { X = fixed, Z = cut.At, Length = cut.Width, Axis = "Z" })
			end
		end
		cursor = b
	end
	segment(cursor, to)
end

local function door(at: number): Opening
	return { At = at, Width = 12, Kind = "Door" }
end

local function window(at: number): Opening
	return { At = at, Width = 8, Kind = "Window" }
end

local function blank(id: string, name: string, blurb: string, half: number, theme: any): Definition
	return {
		Id = id,
		Name = name,
		Blurb = blurb,
		Half = half,
		Theme = theme,
		Walls = {},
		Windows = {},
		Props = {},
		Terminals = {},
		Lockers = {},
		Cages = {},
		Exits = {},
		Lamps = {},
		SurvivorSpawns = {},
		KillerSpawn = { X = 0, Z = 0 },
	}
end

-- A hollow square room with a door and an optional window on given sides.
local function room(def: Definition, cx: number, cz: number, size: number, doorSide: string, windowSide: string?)
	local h = size / 2
	local sides = {
		N = { "X", cz - h, cx - h, cx + h, cx },
		S = { "X", cz + h, cx - h, cx + h, cx },
		W = { "Z", cx - h, cz - h - THICK / 2, cz + h + THICK / 2, cz },
		E = { "Z", cx + h, cz - h - THICK / 2, cz + h + THICK / 2, cz },
	}
	for side, spec in sides do
		local openings: { Opening } = {}
		if side == doorSide then
			table.insert(openings, door(spec[5]))
		elseif side == windowSide then
			table.insert(openings, window(spec[5]))
		end
		Maps.wall(def, spec[1], spec[2], spec[3], spec[4], openings)
	end
end

-- Map 1: Looksmax Labs ---------------------------------------------------------
-- A research facility: four corner labs around a central calibration core.

local function facility(): Definition
	local def = blank("Labs", "Looksmax Labs", "Cold corridors, four corner labs and a central calibration core.", 100, {
		Floor = Color3.fromRGB(57, 62, 71),
		Wall = Color3.fromRGB(38, 43, 52),
		Prop = Color3.fromRGB(80, 69, 60),
		Lamp = Color3.fromRGB(255, 160, 66),
		Ambient = Color3.fromRGB(48, 52, 67),
		Fog = Color3.fromRGB(20, 24, 35),
		FogEnd = 230,
		FloorMaterial = Enum.Material.Concrete,
		WallMaterial = Enum.Material.Concrete,
	})

	-- Central core: doors north/south, vault windows east/west.
	Maps.wall(def, "X", -25, -25, 25, { door(0) })
	Maps.wall(def, "X", 25, -25, 25, { door(0) })
	Maps.wall(def, "Z", -25, -26, 26, { window(0) })
	Maps.wall(def, "Z", 25, -26, 26, { window(0) })

	-- Corner labs: each has a door and a window toward the middle lanes.
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			Maps.wall(def, "Z", 45 * sx, math.min(100 * sz, 45 * sz), math.max(100 * sz, 45 * sz), { door(74 * sz) })
			Maps.wall(def, "X", 45 * sz, math.min(100 * sx, 45 * sx), math.max(100 * sx, 45 * sx), { window(81 * sx) })
			-- Interior lab bench to loop around.
			table.insert(def.Props, { X = 66 * sx, Z = 66 * sz, W = 14, D = 4, H = 3.5 })
		end
	end

	-- Middle lanes (north/south): a short wall with a window makes a loop.
	for _, sz in { -1, 1 } do
		Maps.wall(def, "X", 70 * sz, -14, 14, { window(0) })
		table.insert(def.Props, { X = -30, Z = 62 * sz, W = 8, D = 8, H = 6 })
		table.insert(def.Props, { X = 30, Z = 62 * sz, W = 8, D = 8, H = 6 })
	end
	-- East/west lanes hold the cages, flanked by crates.
	for _, sx in { -1, 1 } do
		table.insert(def.Props, { X = 62 * sx, Z = -32, W = 10, D = 6, H = 6 })
		table.insert(def.Props, { X = 62 * sx, Z = 32, W = 10, D = 6, H = 6 })
	end

	def.Terminals = {
		{ X = 0, Z = 0, Face = "N" },
		{ X = -72, Z = -80, Face = "S" }, { X = 72, Z = -80, Face = "S" },
		{ X = -72, Z = 82, Face = "N" }, { X = 72, Z = 82, Face = "N" },
	}
	def.Lockers = {
		{ X = -20, Z = -12, Face = "E" }, { X = 20, Z = 12, Face = "W" },
		{ X = -96, Z = -60, Face = "E" }, { X = 96, Z = -60, Face = "W" },
		{ X = -96, Z = 60, Face = "E" }, { X = 96, Z = 60, Face = "W" },
		{ X = -50, Z = -96, Face = "S" }, { X = 50, Z = 96, Face = "N" },
		{ X = -14, Z = -66, Face = "S" }, { X = 14, Z = 66, Face = "N" },
	}
	def.Cages = { { X = 76, Z = 0, Face = "W" }, { X = -76, Z = 0, Face = "E" } }
	def.Exits = { { X = 0, Z = -100, Face = "S" }, { X = 0, Z = 100, Face = "N" } }
	def.Lamps = {
		{ X = 0, Z = 0 }, { X = -72, Z = -72 }, { X = 72, Z = -72 }, { X = -72, Z = 72 }, { X = 72, Z = 72 },
		{ X = 0, Z = -85 }, { X = 0, Z = 85 }, { X = -76, Z = 0 }, { X = 76, Z = 0 },
	}
	def.SurvivorSpawns = {
		{ X = -85, Z = 85 }, { X = 85, Z = 88 }, { X = -88, Z = -85 },
		{ X = -35, Z = 88 }, { X = 35, Z = 88 }, { X = -85, Z = 30 },
	}
	def.KillerSpawn = { X = 85, Z = -88 }
	return def
end

-- Map 2: Mewing Mall -----------------------------------------------------------
-- Eight shops around an open atrium. Shops are risky: one door, one window.

local function mall(): Definition
	local def = blank("Mall", "Mewing Mall", "Abandoned shops around a fountain atrium. Every shop has one door and one window.", 100, {
		Floor = Color3.fromRGB(92, 80, 74),
		Wall = Color3.fromRGB(60, 46, 52),
		Prop = Color3.fromRGB(116, 86, 64),
		Lamp = Color3.fromRGB(255, 120, 190),
		Ambient = Color3.fromRGB(62, 48, 60),
		Fog = Color3.fromRGB(34, 22, 32),
		FogEnd = 210,
		FloorMaterial = Enum.Material.Marble,
		WallMaterial = Enum.Material.Brick,
	})
	local shops = {
		{ -60, -60, "S", "E" }, { 0, -60, "S", "N" }, { 60, -60, "S", "W" },
		{ -60, 0, "E", "W" }, { 60, 0, "W", "E" },
		{ -60, 60, "N", "E" }, { 0, 60, "N", "S" }, { 60, 60, "N", "W" },
	}
	for _, shop in shops do
		room(def, shop[1], shop[2], 36, shop[3], shop[4])
	end
	-- Atrium fountain and benches.
	table.insert(def.Props, { X = 0, Z = 0, W = 10, D = 10, H = 3 })
	for _, offset in { { -18, 0, 2, 8 }, { 18, 0, 2, 8 }, { 0, -20, 8, 2 }, { 0, 20, 8, 2 } } do
		table.insert(def.Props, { X = offset[1], Z = offset[2], W = offset[3], D = offset[4], H = 2 })
	end
	-- Kiosks in the corridors for looping.
	for _, position in { { -30, -30 }, { 30, -30 }, { -30, 30 }, { 30, 30 } } do
		table.insert(def.Props, { X = position[1], Z = position[2], W = 6, D = 6, H = 7 })
	end
	def.Terminals = {
		{ X = -66, Z = -66, Face = "S" }, { X = 66, Z = -66, Face = "S" },
		{ X = -66, Z = 66, Face = "N" }, { X = 66, Z = 66, Face = "N" },
		{ X = 0, Z = 12, Face = "S" },
	}
	def.Lockers = {
		{ X = -73, Z = -8, Face = "E" }, { X = -73, Z = 8, Face = "E" },
		{ X = 73, Z = -8, Face = "W" }, { X = 73, Z = 8, Face = "W" },
		{ X = -96, Z = -30, Face = "E" }, { X = 96, Z = 30, Face = "W" },
		{ X = -30, Z = 96, Face = "N" }, { X = 30, Z = -96, Face = "S" },
	}
	def.Cages = { { X = 0, Z = -64, Face = "S" }, { X = 0, Z = 64, Face = "N" } }
	def.Exits = { { X = -100, Z = 0, Face = "E" }, { X = 100, Z = 0, Face = "W" } }
	def.Lamps = {
		{ X = 0, Z = 0 }, { X = -60, Z = -60 }, { X = 60, Z = -60 }, { X = -60, Z = 60 }, { X = 60, Z = 60 },
		{ X = -60, Z = 0 }, { X = 60, Z = 0 }, { X = 0, Z = -60 }, { X = 0, Z = 60 },
	}
	def.SurvivorSpawns = {
		{ X = -88, Z = 88 }, { X = 88, Z = 88 }, { X = -88, Z = -40 },
		{ X = 88, Z = 40 }, { X = -30, Z = 88 }, { X = 30, Z = 88 },
	}
	def.KillerSpawn = { X = 0, Z = -88 }
	return def
end

Maps.List = { facility(), mall() }

function Maps.get(id: string): Definition?
	for _, def in Maps.List do
		if def.Id == id then
			return def
		end
	end
	return nil
end

function Maps.ids(): { string }
	local ids = {}
	for _, def in Maps.List do
		table.insert(ids, def.Id)
	end
	return ids
end

return Maps
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">RoundState</string>
          <string name="Source"><![CDATA[--!strict
-- Pure, server-owned round state. Roblox adapters validate distance, character
-- health, line of sight and prompt hold duration before invoking these rules.
--
-- Survivor lifecycle:
--   Healthy --hit--> Injured --hit--> Downed --pickup--> Carried --cage--> Caged
--   Downed recovers on its own, or teammates revive it. Carried survivors can
--   wiggle free. Caged survivors are rescued, escape by luck, or are eliminated
--   when their cage timer runs out (the third cage eliminates immediately).
local Config = if script then require(script.Parent.Config) else require("./Config")
local Rules = if script then require(script.Parent.Rules) else require("./Rules")

export type Status = "Healthy" | "Injured" | "Downed" | "Carried" | "Caged" | "Escaped" | "Eliminated"

export type SurvivorStats = {
	Calibrations: number,
	Revives: number,
	Heals: number,
	Rescues: number,
}

export type Survivor = {
	BP: number,
	Status: Status,
	ImmuneUntil: number,
	LastObjectiveAt: number?,
	RecoverAt: number?,
	CarriedAt: number?,
	Wiggles: number,
	WiggleWindowAt: number,
	WiggleWindowCount: number,
	CageCount: number,
	CagedUntil: number?,
	EscapeAttempts: number,
	Hidden: string?,
	Stats: SurvivorStats,
}

export type KillerStats = {
	Hits: number,
	Downs: number,
	Cages: number,
	Eliminations: number,
}

export type Event = { Kind: string, Id: number }

export type State = {
	KillerId: number,
	KillerPresent: boolean,
	KillerStats: KillerStats,
	CarryingId: number?,
	Survivors: { [number]: Survivor },
	TotalSurvivors: number,
	ObjectiveCount: number,
	ObjectiveGoal: number,
	ExitPowered: boolean,
	Terminals: { [string]: number },
	StartedAt: number,
	EndsAt: number,
	Ended: boolean,
	Result: string?,
	Winner: string?,
	EscapedCount: number,
	EliminatedCount: number,
}

local RoundState = {}

local function finite(value: any): boolean
	return type(value) == "number" and value == value and math.abs(value) < math.huge
end

local function active(state: State, now: number): boolean
	return not state.Ended and finite(now) and now >= state.StartedAt and now < state.EndsAt
end

-- Free survivors can move, interact and help teammates.
function RoundState.isFree(survivor: Survivor?): boolean
	return survivor ~= nil and (survivor.Status == "Healthy" or survivor.Status == "Injured")
end

-- Finished survivors no longer take part in the round.
function RoundState.isFinished(survivor: Survivor?): boolean
	return survivor ~= nil and (survivor.Status == "Escaped" or survivor.Status == "Eliminated")
end

local function freeSurvivor(state: State, id: number): Survivor?
	local survivor = state.Survivors[id]
	if RoundState.isFree(survivor) and not (survivor :: Survivor).Hidden then
		return survivor
	end
	return nil
end

local function addBP(survivor: Survivor, amount: number)
	survivor.BP = math.min(Config.MaxBP, survivor.BP + amount)
end

local function release(survivor: Survivor, now: number)
	survivor.Status = "Injured"
	survivor.RecoverAt = nil
	survivor.CarriedAt = nil
	survivor.CagedUntil = nil
	survivor.Wiggles = 0
	survivor.ImmuneUntil = now + Config.CaptureGraceSeconds
end

function RoundState.new(participantIds: { number }, killerIndex: number, now: number): (State?, string?)
	if type(participantIds) ~= "table" or #participantIds < Config.MinPlayers then
		return nil, "At least two players are required."
	end
	if not finite(killerIndex) or killerIndex % 1 ~= 0 or killerIndex < 1 or killerIndex > #participantIds then
		return nil, "Killer index must identify a participant."
	end
	if not finite(now) then
		return nil, "Round start time must be finite."
	end
	local seen: { [number]: boolean } = {}
	local count = 0
	for index, id in participantIds do
		if type(index) ~= "number" or index % 1 ~= 0 or index < 1 or index > #participantIds then
			return nil, "Participants must be a dense array."
		end
		if not finite(id) or id % 1 ~= 0 or seen[id] then
			return nil, "Participant IDs must be unique, finite integers."
		end
		seen[id] = true
		count += 1
	end
	if count ~= #participantIds then
		return nil, "Participants must be a dense array."
	end

	local killerId = participantIds[killerIndex]
	local survivors: { [number]: Survivor } = {}
	for _, id in participantIds do
		if id ~= killerId then
			survivors[id] = {
				BP = 0,
				Status = "Healthy",
				ImmuneUntil = now + Config.CaptureGraceSeconds,
				Wiggles = 0,
				WiggleWindowAt = now,
				WiggleWindowCount = 0,
				CageCount = 0,
				EscapeAttempts = 0,
				Stats = { Calibrations = 0, Revives = 0, Heals = 0, Rescues = 0 },
			}
		end
	end
	return {
		KillerId = killerId,
		KillerPresent = true,
		KillerStats = { Hits = 0, Downs = 0, Cages = 0, Eliminations = 0 },
		Survivors = survivors,
		TotalSurvivors = count - 1,
		ObjectiveCount = 0,
		ObjectiveGoal = Rules.objectiveGoal(count - 1),
		ExitPowered = false,
		Terminals = {},
		StartedAt = now,
		EndsAt = now + Config.RoundSeconds,
		Ended = false,
		EscapedCount = 0,
		EliminatedCount = 0,
	}, nil
end

-- Terminals -------------------------------------------------------------------

function RoundState.terminalReady(state: State, terminalId: string, now: number): boolean
	local overheat = state.Terminals[terminalId]
	return overheat == nil or now >= overheat
end

function RoundState.objective(state: State, id: number, now: number, terminalId: string?): boolean
	local survivor = freeSurvivor(state, id)
	local terminal = terminalId or "Main"
	if not active(state, now) or not survivor then
		return false
	end
	if survivor.LastObjectiveAt and now - survivor.LastObjectiveAt < Config.ObjectiveCooldownSeconds then
		return false
	end
	if not RoundState.terminalReady(state, terminal, now) then
		return false
	end
	survivor.LastObjectiveAt = now
	survivor.Stats.Calibrations += 1
	addBP(survivor, Config.BPPerObjective)
	state.Terminals[terminal] = now + Config.TerminalOverheatSeconds
	state.ObjectiveCount = math.min(state.ObjectiveGoal, state.ObjectiveCount + 1)
	if not state.ExitPowered and state.ObjectiveCount >= state.ObjectiveGoal then
		state.ExitPowered = true
		state.EndsAt = math.min(state.EndsAt, now + Config.EndgameSeconds)
	end
	return true
end

-- Killer actions --------------------------------------------------------------

-- Returns the new status ("Injured" or "Downed") when the hit lands.
function RoundState.hit(state: State, id: number, now: number): Status?
	local survivor = freeSurvivor(state, id)
	if not active(state, now) or not survivor or now < survivor.ImmuneUntil then
		return nil
	end
	state.KillerStats.Hits += 1
	if survivor.Status == "Healthy" then
		survivor.Status = "Injured"
	else
		survivor.Status = "Downed"
		survivor.RecoverAt = now + Config.DownedRecoverSeconds
		state.KillerStats.Downs += 1
	end
	return survivor.Status
end

function RoundState.pickup(state: State, id: number, now: number): boolean
	local survivor = state.Survivors[id]
	if not active(state, now) or state.CarryingId or not survivor or survivor.Status ~= "Downed" then
		return false
	end
	survivor.Status = "Carried"
	survivor.RecoverAt = nil
	survivor.CarriedAt = now
	survivor.Wiggles = 0
	state.CarryingId = id
	return true
end

-- Opening an occupied locker grabs the hider straight onto the killer's shoulder.
function RoundState.grabFromLocker(state: State, id: number, now: number): boolean
	local survivor = state.Survivors[id]
	if not active(state, now) or state.CarryingId or not RoundState.isFree(survivor) then
		return false
	end
	local target = survivor :: Survivor
	if not target.Hidden then
		return false
	end
	target.Hidden = nil
	state.KillerStats.Hits += 1
	state.KillerStats.Downs += 1
	target.Status = "Carried"
	target.CarriedAt = now
	target.Wiggles = 0
	state.CarryingId = id
	return true
end

-- Releases whoever the killer carries (wiggle, flash, timeout). Returns their id.
function RoundState.dropCarried(state: State, now: number): number?
	local id = state.CarryingId
	if not id then
		return nil
	end
	state.CarryingId = nil
	local survivor = state.Survivors[id]
	if survivor and survivor.Status == "Carried" then
		release(survivor, now)
	end
	return id
end

-- Returns "Freed" when enough wiggles accumulate, "Progress" otherwise.
function RoundState.wiggle(state: State, id: number, now: number): string?
	local survivor = state.Survivors[id]
	if not active(state, now) or not survivor or survivor.Status ~= "Carried" or state.CarryingId ~= id then
		return nil
	end
	if now - survivor.WiggleWindowAt >= 1 then
		survivor.WiggleWindowAt = now
		survivor.WiggleWindowCount = 0
	end
	if survivor.WiggleWindowCount >= Config.WiggleMaxPerSecond then
		return nil -- Auto-clickers do not wiggle faster than a human.
	end
	survivor.WiggleWindowCount += 1
	survivor.Wiggles += 1
	if survivor.Wiggles >= Config.WiggleGoal then
		RoundState.dropCarried(state, now)
		return "Freed"
	end
	return "Progress"
end

-- Returns "Caged" or "Eliminated".
function RoundState.cage(state: State, id: number, now: number): Status?
	local survivor = state.Survivors[id]
	if not active(state, now) or not survivor or survivor.Status ~= "Carried" or state.CarryingId ~= id then
		return nil
	end
	state.CarryingId = nil
	survivor.CarriedAt = nil
	survivor.CageCount += 1
	state.KillerStats.Cages += 1
	local seconds = Rules.cageSeconds(survivor.CageCount)
	if seconds then
		survivor.Status = "Caged"
		survivor.CagedUntil = now + seconds
		survivor.EscapeAttempts = 0
	else
		survivor.Status = "Eliminated"
		state.EliminatedCount += 1
		state.KillerStats.Eliminations += 1
	end
	return survivor.Status
end

-- Survivor actions ------------------------------------------------------------

function RoundState.rescue(state: State, rescuerId: number, targetId: number, now: number): boolean
	local rescuer = freeSurvivor(state, rescuerId)
	local target = state.Survivors[targetId]
	if not active(state, now) or not rescuer or rescuerId == targetId or not target or target.Status ~= "Caged" then
		return false
	end
	release(target, now)
	rescuer.Stats.Rescues += 1
	addBP(rescuer, Config.BPPerRescue)
	return true
end

-- `roll` is a number in [0, 1) supplied by the caller's random source.
function RoundState.attemptCageEscape(state: State, id: number, now: number, roll: number): boolean?
	local survivor = state.Survivors[id]
	if not active(state, now) or not survivor or survivor.Status ~= "Caged" then
		return nil
	end
	if survivor.EscapeAttempts >= Config.CageEscapeAttempts or not finite(roll) then
		return nil
	end
	survivor.EscapeAttempts += 1
	if roll < Config.CageEscapeChance then
		release(survivor, now)
		return true
	end
	return false
end

function RoundState.revive(state: State, helperId: number, targetId: number, now: number): boolean
	local helper = freeSurvivor(state, helperId)
	local target = state.Survivors[targetId]
	if not active(state, now) or not helper or helperId == targetId or not target or target.Status ~= "Downed" then
		return false
	end
	release(target, now)
	target.ImmuneUntil = now -- Revives do not grant capture immunity.
	helper.Stats.Revives += 1
	addBP(helper, Config.BPPerRevive)
	return true
end

function RoundState.heal(state: State, helperId: number, targetId: number, now: number): boolean
	local helper = freeSurvivor(state, helperId)
	local target = freeSurvivor(state, targetId)
	if not active(state, now) or not helper or not target or helperId == targetId or target.Status ~= "Injured" then
		return false
	end
	target.Status = "Healthy"
	helper.Stats.Heals += 1
	addBP(helper, Config.BPPerHeal)
	return true
end

function RoundState.selfHeal(state: State, id: number, now: number): boolean
	local survivor = freeSurvivor(state, id)
	if not active(state, now) or not survivor or survivor.Status ~= "Injured" then
		return false
	end
	survivor.Status = "Healthy"
	return true
end

function RoundState.escape(state: State, id: number, now: number): boolean
	local survivor = freeSurvivor(state, id)
	if not active(state, now) or not survivor then
		return false
	end
	if survivor.BP < Config.MaxBP or not state.ExitPowered then
		return false
	end
	survivor.Status = "Escaped"
	state.EscapedCount += 1
	return true
end

function RoundState.hide(state: State, id: number, lockerId: string, now: number): boolean
	local survivor = freeSurvivor(state, id)
	if not active(state, now) or not survivor or type(lockerId) ~= "string" then
		return false
	end
	for _, other in state.Survivors do
		if other.Hidden == lockerId then
			return false
		end
	end
	survivor.Hidden = lockerId
	return true
end

function RoundState.unhide(state: State, id: number): boolean
	local survivor = state.Survivors[id]
	if not survivor or not survivor.Hidden then
		return false
	end
	survivor.Hidden = nil
	return true
end

function RoundState.lockerOccupant(state: State, lockerId: string): number?
	for id, survivor in state.Survivors do
		if survivor.Hidden == lockerId and RoundState.isFree(survivor) then
			return id
		end
	end
	return nil
end

-- Time-based transitions. Returns events for the presentation layer.
function RoundState.tick(state: State, now: number): { Event }
	local events: { Event } = {}
	if not active(state, now) then
		return events
	end
	for id, survivor in state.Survivors do
		if survivor.Status == "Downed" and survivor.RecoverAt and now >= survivor.RecoverAt then
			release(survivor, now)
			survivor.ImmuneUntil = now
			table.insert(events, { Kind = "Recovered", Id = id })
		elseif survivor.Status == "Caged" and survivor.CagedUntil and now >= survivor.CagedUntil then
			survivor.Status = "Eliminated"
			survivor.CagedUntil = nil
			state.EliminatedCount += 1
			state.KillerStats.Eliminations += 1
			table.insert(events, { Kind = "Eliminated", Id = id })
		elseif survivor.Status == "Carried" and survivor.CarriedAt and now - survivor.CarriedAt >= Config.CarryMaxSeconds then
			RoundState.dropCarried(state, now)
			table.insert(events, { Kind = "CarryTimeout", Id = id })
		end
	end
	return events
end

function RoundState.removePlayer(state: State, id: number)
	if state.Ended then
		return
	end
	if id == state.KillerId then
		state.KillerPresent = false
		state.Ended = true
		state.Winner = "Survivors"
		state.Result = "Survivors win! The OG Chad left the round."
		return
	end
	local survivor = state.Survivors[id]
	if survivor then
		if state.CarryingId == id then
			state.CarryingId = nil
		end
		if survivor.Status == "Escaped" then
			state.EscapedCount -= 1
		elseif survivor.Status == "Eliminated" then
			state.EliminatedCount -= 1
		end
		state.Survivors[id] = nil
		state.TotalSurvivors -= 1
	end
end

function RoundState.updateResult(state: State, now: number): string?
	if state.Ended then
		return state.Result
	end
	if not finite(now) or now < state.StartedAt then
		return nil
	end
	local remaining = 0
	local total = 0
	for _, survivor in state.Survivors do
		total += 1
		if not RoundState.isFinished(survivor) then
			remaining += 1
		end
	end
	local escaped = state.EscapedCount
	if not state.KillerPresent then
		state.Winner = "Survivors"
		state.Result = "Survivors win! The OG Chad left the round."
	elseif total == 0 then
		state.Winner = "None"
		state.Result = "Round ended: all survivors left."
	elseif remaining == 0 or now >= state.EndsAt then
		local timeUp = remaining > 0
		if Rules.survivorsWin(escaped, total) then
			state.Winner = "Survivors"
			state.Result = string.format("Survivors win! %d of %d escaped the Chad.", escaped, total)
		else
			state.Winner = "Killer"
			if escaped == 0 then
				state.Result = if timeUp
					then "OG Chad wins! Time ran out and nobody escaped."
					else "OG Chad wins! Every survivor was mogged."
			else
				state.Result = string.format("OG Chad wins! Only %d of %d escaped.", escaped, total)
			end
		end
	end
	if state.Result then
		state.Ended = true
	end
	return state.Result
end

-- XP earned this round by a participant (used by persistence).
function RoundState.xpFor(state: State, id: number): number
	local XP = Rules.XP
	local xp = XP.Participation
	if id == state.KillerId then
		local stats = state.KillerStats
		xp += stats.Hits * XP.Hit + stats.Downs * XP.Down + stats.Cages * XP.Cage + stats.Eliminations * XP.Elimination
		if state.Winner == "Killer" then
			xp += XP.KillerWin
		end
		return xp
	end
	local survivor = state.Survivors[id]
	if not survivor then
		return 0
	end
	local stats = survivor.Stats
	xp += stats.Calibrations * XP.Calibration + stats.Revives * XP.Revive + stats.Heals * XP.Heal + stats.Rescues * XP.Rescue
	if survivor.Status == "Escaped" then
		xp += XP.Escape
	end
	if state.Winner == "Survivors" then
		xp += XP.SurvivorWin
	end
	return xp
end

return table.freeze(RoundState)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Rules</string>
          <string name="Source"><![CDATA[--!strict
-- Pure calculations shared by server, client and tests.
-- The string require supports Lune tests; Studio uses the ModuleScript branch.
local Config = if script then require(script.Parent.Config) else require("./Config")

local Rules = {}

function Rules.rankForBP(points: number): string
	local name = Config.Ranks[1].Name
	for _, rank in Config.Ranks do
		if points >= rank.BP then
			name = rank.Name
		end
	end
	return name
end

function Rules.nextRank(points: number): { Name: string, BP: number }?
	for _, rank in Config.Ranks do
		if points < rank.BP then
			return rank
		end
	end
	return nil
end

function Rules.chaseIntensity(distance: number): number
	if distance ~= distance then
		return 0
	end
	return math.clamp(
		(Config.ChaseRadius - distance) / (Config.ChaseRadius - Config.ChaseFullVolumeRadius),
		0,
		1
	)
end

function Rules.objectiveGoal(survivorCount: number): number
	return math.max(4, survivorCount * 3)
end

-- Seconds a survivor stays caged for their Nth cage (1-based). nil means the
-- cage eliminates them immediately.
function Rules.cageSeconds(cageCount: number): number?
	return Config.CageSeconds[cageCount]
end

-- Killer attack geometry: a hit needs range and a forward-facing cone.
-- `forward` must be a unit vector; positions are { X, Z } style numbers.
function Rules.inAttackCone(dx: number, dz: number, forwardX: number, forwardZ: number): boolean
	local distance = math.sqrt(dx * dx + dz * dz)
	if distance ~= distance or distance > Config.AttackRange then
		return false
	end
	if distance < 1.5 then
		return true -- Overlapping bodies always connect.
	end
	return (dx * forwardX + dz * forwardZ) / distance >= Config.AttackConeDot
end

-- Survivors win when at least half of the starting survivors escape.
function Rules.survivorsWin(escaped: number, total: number): boolean
	if total <= 0 then
		return false
	end
	return escaped > 0 and escaped >= math.ceil(total * Config.SurvivorWinFraction)
end

-- Progression ----------------------------------------------------------------

Rules.XP = table.freeze({
	Participation = 20,
	Calibration = 10,
	Revive = 15,
	Heal = 10,
	Rescue = 25,
	Escape = 60,
	SurvivorWin = 40,
	Hit = 8,
	Down = 15,
	Cage = 25,
	Elimination = 35,
	KillerWin = 80,
})

-- XP needed to go from `level` to `level + 1`.
function Rules.xpToNext(level: number): number
	return 100 + (math.max(1, level) - 1) * 50
end

-- Returns level (starting at 1), XP into that level, and XP needed for the next.
function Rules.levelForXP(xp: number): (number, number, number)
	if xp ~= xp or xp < 0 then
		xp = 0
	end
	xp = math.floor(xp)
	local level = 1
	while level < 999 do
		local need = Rules.xpToNext(level)
		if xp < need then
			return level, xp, need
		end
		xp -= need
		level += 1
	end
	return level, 0, Rules.xpToNext(level)
end

Rules.Titles = table.freeze({
	table.freeze({ Level = 1, Name = "Mewing Rookie" }),
	table.freeze({ Level = 5, Name = "Jawline Apprentice" }),
	table.freeze({ Level = 10, Name = "Gym Regular" }),
	table.freeze({ Level = 20, Name = "Certified Mogger" }),
	table.freeze({ Level = 35, Name = "Giga Legend" }),
})

function Rules.titleForLevel(level: number): string
	local title = Rules.Titles[1].Name
	for _, entry in Rules.Titles do
		if level >= entry.Level then
			title = entry.Name
		end
	end
	return title
end

-- Majority vote with deterministic tie breaking via the provided roll (1..n).
function Rules.pickVote(options: { string }, votes: { [any]: string }, roll: (number) -> number): string
	local counts: { [string]: number } = {}
	for _, option in options do
		counts[option] = 0
	end
	for _, choice in votes do
		if counts[choice] then
			counts[choice] += 1
		end
	end
	local best = -1
	local leaders: { string } = {}
	for _, option in options do
		local count = counts[option]
		if count > best then
			best = count
			leaders = { option }
		elseif count == best then
			table.insert(leaders, option)
		end
	end
	return leaders[roll(#leaders)]
end

return table.freeze(Rules)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="11">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="12">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--!strict
-- Persistent player profiles and the global wins leaderboard.
-- Every DataStore call is wrapped in pcall. In Studio without "Enable Studio
-- Access to API Services", the service logs one warning and keeps profiles in
-- memory for the session, so the game remains fully playable.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Rules = require(Shared.Rules)
local Abilities = require(Shared.Abilities)

export type Profile = {
	Version: number,
	XP: number,
	RoundsPlayed: number,
	SurvivorWins: number,
	KillerWins: number,
	Escapes: number,
	Calibrations: number,
	Rescues: number,
	Revives: number,
	Downs: number,
	Cages: number,
	SelectedAbility: string,
}

local DataService = {}

local profiles: { [number]: Profile } = {}
local dirty: { [number]: boolean } = {}
local loaded: { [number]: boolean } = {}
local storeAvailable = true
local warned = false
local nameCache: { [number]: string } = {}

local store: DataStore? = nil
local ordered: OrderedDataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	end
	local okOrdered, orderedResult = pcall(function()
		return DataStoreService:GetOrderedDataStore(Config.LeaderboardStoreName)
	end)
	if okOrdered then
		ordered = orderedResult
	end
	if not store then
		storeAvailable = false
	end
end

local function disable(reason: any)
	storeAvailable = false
	if not warned then
		warned = true
		warn("[EscapeTheChad] DataStore unavailable; progress is kept for this session only. " .. tostring(reason))
	end
end

local function defaultProfile(): Profile
	return {
		Version = 1,
		XP = 0,
		RoundsPlayed = 0,
		SurvivorWins = 0,
		KillerWins = 0,
		Escapes = 0,
		Calibrations = 0,
		Rescues = 0,
		Revives = 0,
		Downs = 0,
		Cages = 0,
		SelectedAbility = Abilities.DefaultSurvivor,
	}
end

-- Copies only known, well-typed fields so corrupt data cannot break a session.
local function sanitize(raw: any): Profile
	local profile = defaultProfile()
	if type(raw) ~= "table" then
		return profile
	end
	for key, value in profile :: any do
		local incoming = raw[key]
		if type(incoming) == type(value) then
			if type(incoming) == "number" then
				if incoming == incoming and incoming >= 0 and incoming < 1e12 then
					(profile :: any)[key] = math.floor(incoming)
				end
			else
				(profile :: any)[key] = incoming
			end
		end
	end
	if not Abilities.isSurvivorAbility(profile.SelectedAbility) then
		profile.SelectedAbility = Abilities.DefaultSurvivor
	end
	return profile
end

local function key(userId: number): string
	return "player_" .. tostring(userId)
end

function DataService.publish(player: Player)
	local profile = profiles[player.UserId]
	if not profile then
		return
	end
	local level, into, need = Rules.levelForXP(profile.XP)
	player:SetAttribute("Level", level)
	player:SetAttribute("XP", profile.XP)
	player:SetAttribute("XPInto", into)
	player:SetAttribute("XPNeed", need)
	player:SetAttribute("Title", Rules.titleForLevel(level))
	player:SetAttribute("Wins", profile.SurvivorWins + profile.KillerWins)
	player:SetAttribute("Escapes", profile.Escapes)
	player:SetAttribute("RoundsPlayed", profile.RoundsPlayed)
	player:SetAttribute("Ability", profile.SelectedAbility)
	player:SetAttribute("ProfileLoaded", true)
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		local levelValue = stats:FindFirstChild("Level")
		if levelValue and levelValue:IsA("IntValue") then
			levelValue.Value = level
		end
		local winsValue = stats:FindFirstChild("Wins")
		if winsValue and winsValue:IsA("IntValue") then
			winsValue.Value = profile.SurvivorWins + profile.KillerWins
		end
	end
end

function DataService.load(player: Player)
	local userId = player.UserId
	local raw: any = nil
	-- Studio test players have negative ids; never persist those.
	if storeAvailable and store and userId > 0 then
		for attempt = 1, 3 do
			local ok, result = pcall(function()
				return (store :: DataStore):GetAsync(key(userId))
			end)
			if ok then
				raw = result
				break
			elseif attempt == 3 then
				disable(result)
			else
				task.wait(attempt)
			end
		end
	end
	if not player.Parent then
		return
	end
	profiles[userId] = sanitize(raw)
	loaded[userId] = true
	DataService.publish(player)
end

function DataService.get(player: Player): Profile?
	return profiles[player.UserId]
end

function DataService.save(userId: number)
	local profile = profiles[userId]
	if not profile or not dirty[userId] or not storeAvailable or not store or userId <= 0 or not loaded[userId] then
		return
	end
	local snapshot = table.clone(profile)
	local ok, result = pcall(function()
		(store :: DataStore):UpdateAsync(key(userId), function()
			return snapshot
		end)
	end)
	if ok then
		dirty[userId] = nil
		if ordered then
			pcall(function()
				(ordered :: OrderedDataStore):SetAsync(key(userId), snapshot.SurvivorWins + snapshot.KillerWins)
			end)
		end
	else
		warn("[EscapeTheChad] Profile save failed: " .. tostring(result))
	end
end

function DataService.setAbility(player: Player, abilityId: string): boolean
	local profile = profiles[player.UserId]
	if not profile or not Abilities.isSurvivorAbility(abilityId) then
		return false
	end
	profile.SelectedAbility = abilityId
	dirty[player.UserId] = true
	player:SetAttribute("Ability", abilityId)
	return true
end

export type RoundReport = {
	XP: number,
	Won: boolean,
	Role: string,
	Escaped: boolean,
	Calibrations: number,
	Rescues: number,
	Revives: number,
	Downs: number,
	Cages: number,
}

-- Applies a finished round. Returns (oldLevel, newLevel).
function DataService.record(player: Player, report: RoundReport): (number, number)
	local profile = profiles[player.UserId]
	if not profile then
		return 1, 1
	end
	local before = Rules.levelForXP(profile.XP)
	profile.XP += math.max(0, math.floor(report.XP))
	profile.RoundsPlayed += 1
	if report.Won then
		if report.Role == "Killer" then
			profile.KillerWins += 1
		else
			profile.SurvivorWins += 1
		end
	end
	if report.Escaped then
		profile.Escapes += 1
	end
	profile.Calibrations += report.Calibrations
	profile.Rescues += report.Rescues
	profile.Revives += report.Revives
	profile.Downs += report.Downs
	profile.Cages += report.Cages
	dirty[player.UserId] = true
	DataService.publish(player)
	local after = Rules.levelForXP(profile.XP)
	task.spawn(DataService.save, player.UserId)
	return before, after
end

function DataService.release(player: Player)
	local userId = player.UserId
	DataService.save(userId)
	profiles[userId] = nil
	dirty[userId] = nil
	loaded[userId] = nil
end

local function displayName(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local player = Players:GetPlayerByUserId(userId)
	if player then
		nameCache[userId] = player.DisplayName
		return player.DisplayName
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local result = if ok and type(name) == "string" then name else ("Player " .. tostring(userId))
	nameCache[userId] = result
	return result
end

-- Returns up to `count` { Name, Wins } rows: global when possible, otherwise
-- the players in this server.
function DataService.topWins(count: number): ({ { Name: string, Wins: number } }, boolean)
	local rows = {}
	if storeAvailable and ordered then
		local ok, pages = pcall(function()
			return (ordered :: OrderedDataStore):GetSortedAsync(false, count)
		end)
		if ok and pages then
			local okPage, entries = pcall(function()
				return (pages :: DataStorePages):GetCurrentPage()
			end)
			if okPage and type(entries) == "table" then
				for _, entry in entries do
					local userId = tonumber(string.match(tostring(entry.key), "^player_(%-?%d+)$"))
					if userId then
						table.insert(rows, { Name = displayName(userId), Wins = tonumber(entry.value) or 0 })
					end
				end
				return rows, true
			end
		end
	end
	for _, player in Players:GetPlayers() do
		local profile = profiles[player.UserId]
		if profile then
			table.insert(rows, { Name = player.DisplayName, Wins = profile.SurvivorWins + profile.KillerWins })
		end
	end
	table.sort(rows, function(a, b)
		return a.Wins > b.Wins
	end)
	while #rows > count do
		table.remove(rows)
	end
	return rows, false
end

function DataService.start()
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveSeconds)
			for userId in profiles do
				DataService.save(userId)
			end
		end
	end)
	game:BindToClose(function()
		if RunService:IsStudio() and not storeAvailable then
			return
		end
		local pending = 0
		for userId in profiles do
			pending += 1
			task.spawn(function()
				DataService.save(userId)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 20
		while pending > 0 and os.clock() < deadline do
			task.wait(0.2)
		end
	end)
end

return DataService
]]></string>
        </Properties>
